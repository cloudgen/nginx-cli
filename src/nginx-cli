# Last reviewed: 2026-08-03
# =============================================================================
util_resolve_running_path() {
    : "${0:=}"
    _src="$0"
    _resolved=""

    case "$_src" in
        ""|sh|bash|dash|ash|zsh|ksh|*/sh|*/bash|*/dash|*/ash|*/zsh|*/ksh)
            if [ ! -f "$_src" ]; then
                printf '%s' ""
                return 0
            fi
            ;;
    esac

    if [ ! -f "$_src" ] && [ ! -L "$_src" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v readlink >/dev/null 2>&1; then
        _resolved=$(readlink -f "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi
    if command -v realpath >/dev/null 2>&1; then
        _resolved=$(realpath "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi

    # Fallback: dirname/basename join
    _dir=$(CDPATH= cd -- "$(dirname -- "$_src")" 2>/dev/null && pwd)
    _base=$(basename -- "$_src")
    if [ -n "$_dir" ] && [ -f "${_dir}/${_base}" ]; then
        printf '%s' "${_dir}/${_base}"
        return 0
    fi
    printf '%s' ""
}

# =============================================================================
# inst_local_install() - Local copy install (no network)
# =============================================================================
#
# GENERAL PURPOSE:
# Copy the running ship unit to the privilege-correct bin path.
# Root → GLOBAL_BIN; non-root → USER_BIN. Idempotent unless FORCE/FORCE_REINSTALL.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-idempotency.md
# - requirement-shell-path-and-shell-support.md (user-bin PATH/profile companion)
#
# Mode SSOT for managed binary (shell ship unit needs world-read for non-owners).
# Do NOT use chmod +x alone after mktemp (0600|0111 → 0711 breaks multi-user exec).
INST_MANAGED_MODE="0755"

# Last reviewed: 2026-08-09 — mode 0755 multi-user (requirement-shell-local-self-management §2.3.1)
# =============================================================================
inst_local_install() {
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${INST_MANAGED_MODE:=0755}"

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        IS_ROOT=1
    else
        IS_ROOT=0
    fi
    : "${IS_ROOT:=0}"

    # Root or --global / FORCE_GLOBAL → system-wide path (production elevation story).
    if [ "${FORCE_GLOBAL}" -eq 1 ] || [ "${IS_ROOT}" -eq 1 ]; then
        _target_dir="${GLOBAL_BIN}"
    else
        _target_dir="${USER_BIN}"
    fi
    _target="${_target_dir}/${APP_NAME}"
    INSTALL_PATH="${_target}"

    # PATH / profile companion runs even when the CLI binary is already installed
    # so a second user-bin `install` still heals missing rc. Not for GLOBAL_BIN.
    # ALIGNMENT: requirement-shell-path-and-shell-support.md
    if [ "${_target_dir}" = "${USER_BIN}" ]; then
        path_add_shell
    fi

    if [ -x "${_target}" ] || [ -f "${_target}" ]; then
        if [ "${FORCE}" -eq 0 ] && [ "${FORCE_REINSTALL}" -eq 0 ]; then
            # Mode heal: prior chmod +x after mktemp left 0711/0700; keep multi-user runnable.
            chmod "${INST_MANAGED_MODE}" "${_target}" 2>/dev/null || true
            out_success "${APP_NAME} already installed at ${_target}"
            if [ "${_target_dir}" = "${USER_BIN}" ] && [ "${JSON}" -eq 0 ]; then
                out_info "Local install is user-rewritable. Global install: sudo ${APP_NAME} install  (${GLOBAL_BIN})"
            fi
            if [ "${JSON}" -eq 1 ]; then
                out_json "install" "already installed" \
                    "app" "${APP_NAME}" \
                    "path" "${_target}" \
                    "status" "already_installed" \
                    "mode" "${INST_MANAGED_MODE}"
            fi
            return 0
        fi
    fi

    _src=$(util_resolve_running_path)
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        out_die "Cannot resolve running ship unit path for local install (not a file path)."
    fi

    if [ ! -d "${_target_dir}" ]; then
        if ! mkdir -p "${_target_dir}" 2>/dev/null; then
            if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
                out_die "Cannot create ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install"
            fi
            out_die "Cannot create install directory ${_target_dir}"
        fi
    fi

    if [ ! -w "${_target_dir}" ] 2>/dev/null; then
        if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
            out_die "Cannot write ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install --global"
        fi
        out_die "Install directory not writable: ${_target_dir}"
    fi

    _stage=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.install.XXXXXX" 2>/dev/null || mktemp)
    if ! cp "${_src}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to stage ship unit for install"
    fi
    # Absolute 0755 required: shell scripts need group/other *read* for non-owner exec.
    # chmod +x on a mktemp file (often 0600) yields 0711 — look executable, fail for others.
    if ! chmod "${INST_MANAGED_MODE}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to chmod ${INST_MANAGED_MODE} staged ship unit"
    fi
    if ! mv -f "${_stage}" "${_target}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to install to ${_target}"
    fi
    # Re-assert mode after mv (some filesystems / policies may alter bits).
    if ! chmod "${INST_MANAGED_MODE}" "${_target}"; then
        out_die "Installed ${_target} but failed to set mode ${INST_MANAGED_MODE}"
    fi
    if [ ! -r "${_target}" ] || [ ! -x "${_target}" ]; then
        out_die "Installed ${_target} is not readable+executable (mode heal failed)"
    fi

    out_success "Installed ${APP_NAME} to ${_target}"
    if [ "${_target_dir}" = "${USER_BIN}" ] && [ "${JSON}" -eq 0 ]; then
        out_info "Local install is user-rewritable. Multi-user hosts may prefer: sudo ${APP_NAME} install"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "install" "installed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "installed" \
            "mode" "${INST_MANAGED_MODE}"
    fi
    return 0
}

# =============================================================================
# inst_self_install() - Place this CLI only (local copy, no network, no setup)
# =============================================================================
#
# GENERAL PURPOSE:
# Non-interactive zero-cli-verb and menu row 87 call this. It copies the
# running ship unit to the privilege-correct bin, or says it is already there.
# It does not download, does not run setup, and does not print help.
#
# ALIGNMENT:
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-local-self-management.md
#
# Last updated: 2026-10-04
# =============================================================================
inst_self_install() {
    : "${APP_NAME:=nginx-cli}"
    : "${VERSION:=}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    if [ "${JSON}" -eq 0 ]; then
        out_info "Starting self-install of ${APP_NAME} ${VERSION}..."
    fi

    if inst_is_installed && [ "${FORCE}" -eq 0 ] && [ "${FORCE_REINSTALL}" -eq 0 ]; then
        _self_path=$(util_get_install_bin_path)
        if [ "${_self_path}" = "${USER_BIN}/${APP_NAME}" ]; then
            path_add_shell
        fi
        chmod "${INST_MANAGED_MODE:-0755}" "${_self_path}" 2>/dev/null || true
        if [ "${JSON}" -eq 1 ]; then
            out_json "self-install" "${APP_NAME} is already installed." \
                "app" "${APP_NAME}" \
                "path" "${_self_path}" \
                "status" "already_installed"
        else
            out_success "${APP_NAME} is already installed."
            out_info "Use --force only to replace deliberately (or run: ${APP_NAME} install --force)."
        fi
        unset _self_path
        return 0
    fi

    inst_local_install
    return $?
}

# =============================================================================
# inst_local_uninstall() - Local remove managed binary only
# =============================================================================
#
# GENERAL PURPOSE:
# Remove the managed binary at the privilege-correct path. Confirm when
# interactive unless --force. Non-interactive without force fails closed.
# Does NOT delete user data or unrelated binaries.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-path-and-shell-support.md (scoped rc sticker cleanup)
#
# Last reviewed: 2026-08-03
# =============================================================================
inst_local_uninstall() {
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _target=$(util_get_install_bin_path)

    if [ ! -e "${_target}" ]; then
        out_success "${APP_NAME} is not installed (nothing to uninstall)"
        if [ "${JSON}" -eq 1 ]; then
            out_json "uninstall" "already absent" \
                "app" "${APP_NAME}" \
                "path" "${_target}" \
                "status" "already_uninstalled"
        fi
        return 0
    fi

    if [ "${FORCE}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            out_die "Uninstall requires confirmation. Re-run with --force in non-interactive mode."
        fi
        if ! prompt_yes_no "Remove managed binary ${_target}?"; then
            out_info "Uninstall cancelled"
            return 0
        fi
    fi

    if ! rm -f "${_target}"; then
        out_die "Failed to remove ${_target}"
    fi
    if [ "${_target}" = "${USER_BIN}/${APP_NAME}" ]; then
        inst_local_uninstall_cleanup_path
    fi
    out_success "Removed ${APP_NAME} from ${_target}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "uninstall" "removed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "uninstalled"
    fi
    return 0
}

# =============================================================================
# inst_local_uninstall_cleanup_path() - Scoped this-login rc sticker cleanup
# =============================================================================
#
# GENERAL PURPOSE:
# After user-bin uninstall, remove only this product's installer comments.
# Strip the shared PATH line only when USER_BIN is empty or missing.
# Never delete .profile. Never match other apps' "# Added by .* installer".
#
# ALIGNMENT: requirement-shell-path-and-shell-support.md
#
# Last reviewed: 2026-09-09
# =============================================================================
inst_local_uninstall_cleanup_path() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        return 0
    fi

    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${BASHRC:=${HOME}/.bashrc}"
    : "${ZSHRC:=${HOME}/.zshrc}"
    : "${FISH_CONFIG:=${HOME}/.config/fish/config.fish}"
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    local bin_dir="${USER_BIN}"
    local should_clean_path=1
    local path_line
    local fish_line
    local escaped_line
    local escaped_fish
    local cleaned=0
    local config

    if [ -d "$bin_dir" ]; then
        if [ -n "$(ls -A "$bin_dir" 2>/dev/null)" ]; then
            should_clean_path=0
            if [ "${JSON}" -eq 0 ]; then
                out_warn "Keeping ${bin_dir} in PATH because it still contains files."
            fi
        fi
    fi

    path_line=$(printf 'export PATH="%s:$PATH"' "${bin_dir}")
    fish_line=$(printf 'set -gx PATH %s $PATH' "${bin_dir}")
    escaped_line=$(printf '%s' "${path_line}" | sed 's/[\\/&|]/\\&/g')
    escaped_fish=$(printf '%s' "${fish_line}" | sed 's/[\\/&|]/\\&/g')

    for config in "${BASHRC}" "${ZSHRC}" "${FISH_CONFIG}"; do
        if [ -f "$config" ]; then
            if [ "$should_clean_path" -eq 0 ]; then
                if sed -i.bak \
                    -e "/# Added by ${APP_NAME} installer/d" \
                    "$config" 2>/dev/null; then
                    cleaned=1
                fi
            else
                if sed -i.bak \
                    -e "/# Added by ${APP_NAME} installer/d" \
                    -e "/# Interactive rc created by ${APP_NAME} installer/d" \
                    -e "\|^${escaped_line}\$|d" \
                    -e "\|^${escaped_fish}\$|d" \
                    "$config" 2>/dev/null; then
                    cleaned=1
                fi
            fi
            rm -f "${config}.bak" 2>/dev/null || true
        fi
    done

    if [ "$cleaned" -eq 1 ] && [ "${JSON}" -eq 0 ]; then
        out_plain "→ Cleaned ${APP_NAME} PATH stickers from shell config files"
    fi
    return 0
}

# =============================================================================
# app_where_is_me() - Report running + install paths
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
app_where_is_me() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    _running=$(util_resolve_running_path)
    _install=$(util_get_install_bin_path)
    _installed="false"
    if [ -x "${_install}" ]; then
        _installed="true"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "where-is-me" "" \
            "app" "${APP_NAME}" \
            "running_path" "${_running:-}" \
            "install_path" "${_install}" \
            "installed" "${_installed}"
        return 0
    fi

    if [ -n "${_running}" ]; then
        out_info "Running path:  ${_running}"
    else
        out_warn "Running path:  (unresolvable — not a file path / pipe?)"
    fi
    out_info "Install path:  ${_install}"
    if [ "${_installed}" = "true" ]; then
        out_success "Installed:     yes"
    else
        out_info "Installed:     no"
    fi
}



# =============================================================================

# =============================================================================
# ngx_* domain surface — nginx-adm LPU + request/approve workflow
# =============================================================================
#
# GENERAL PURPOSE:
# Type 1 setup/remove of nginx-adm and the request/approve/reject/publish
# cycle (public /var/nginx-cli queues + home map). Prefix ngx_ is the path-safe domain prefix.
#
# ALIGNMENT:
# - requirement-domain-nginx-cli.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-output-requirements.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS SECTION WITHOUT UPDATING DOMAIN LAW !!!
#
# Last reviewed: 2026-08-15
# =============================================================================

ngx_defaults() {
    : "${NGINX_ADM_USER:=nginx-adm}"
    : "${NGINX_ADM_UID:=1999}"
    : "${NGINX_ADM_GID:=1999}"
    : "${NGINX_ADM_SHELL:=/bin/bash}"
    : "${NGINX_ADM_GECOS:=Admin user for nginx configuration}"
    : "${NGINX_CONF_ROOT:=/etc/nginx}"
    : "${NGINX_ADM_SUDOERS:=/etc/nginx-adm/sudoers}"
    : "${NGINX_CLI_SUBMIT_SUDOERS:=/etc/sudoers.d/nginx-cli-submit}"
    : "${NGINX_CLI_SUBMIT_PER_USER_DIR:=/etc/sudoers.d}"
    : "${NGINX_CLI_SUBMIT_GROUP:=nginx-cli-submit}"
    : "${NGINX_CLI_FIXTURE:=0}"
    : "${NGINX_WEB_UNIT:=nginx}"
    : "${NGINX_BIN:=/usr/sbin/nginx}"
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${TMPDIR:=/tmp}"
}

ngx_resolve_adm_home() {
    ngx_defaults
    if [ -n "${NGINX_ADM_HOME:-}" ]; then
        printf '%s' "${NGINX_ADM_HOME}"
        return 0
    fi
    _h=""
    if command -v getent >/dev/null 2>&1; then
        _h=$(getent passwd "${NGINX_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_h}" ] && [ -r /etc/passwd ]; then
        _h=$(awk -F: -v u="${NGINX_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi
    if [ -n "${_h}" ]; then
        printf '%s' "${_h}"
        return 0
    fi
    printf '%s' "/etc/${NGINX_ADM_USER}"
}

ngx_path_under_tmp() {
    case "${1:-}" in
        /tmp/*|"${TMPDIR}"/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# =============================================================================
# ngx_find_host_bin() - Resolve useradd/groupadd/userdel/groupdel
# =============================================================================
#
# GENERAL PURPOSE:
# Root PATH is often short. Prefer command -v, then /usr/sbin/<name>.
#
# ALIGNMENT:
# - requirement-least-privilege-user.md
#
# Last updated: 2026-08-25
# =============================================================================
ngx_find_host_bin() {
    _nhb="${1-}"
    [ -n "${_nhb}" ] || return 1
    _p=$(command -v "${_nhb}" 2>/dev/null || true)
    if [ -n "${_p}" ]; then
        printf '%s' "${_p}"
        return 0
    fi
    if [ -x "/usr/sbin/${_nhb}" ]; then
        printf '%s' "/usr/sbin/${_nhb}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_expected_adm_home() - Collision expected home (override or preferred-/etc)
# =============================================================================
#
# Last updated: 2026-08-25
# =============================================================================
ngx_expected_adm_home() {
    ngx_defaults
    if [ -n "${NGINX_ADM_HOME:-}" ]; then
        printf '%s' "${NGINX_ADM_HOME}"
        return 0
    fi
    printf '%s' "/etc/${NGINX_ADM_USER}"
}

# Live home matches this identity: override/preferred, or documented fallback /home/<user>.
ngx_adm_home_is_this_identity() {
    _live="${1-}"
    _exp=$(ngx_expected_adm_home)
    if [ "${_live}" = "${_exp}" ]; then
        return 0
    fi
    if [ -z "${NGINX_ADM_HOME:-}" ] && [ "${_live}" = "/home/${NGINX_ADM_USER}" ]; then
        return 0
    fi
    return 1
}

ngx_passwd_ent() {
    _key="${1-}"
    _line=""
    if command -v getent >/dev/null 2>&1; then
        _line=$(getent passwd "${_key}" 2>/dev/null || true)
    fi
    if [ -z "${_line}" ] && [ -r /etc/passwd ]; then
        case "${_key}" in
            *[!0-9]*)
                _line=$(awk -F: -v u="${_key}" '$1==u {print; exit}' /etc/passwd 2>/dev/null || true)
                ;;
            *)
                _line=$(awk -F: -v u="${_key}" '$3==u {print; exit}' /etc/passwd 2>/dev/null || true)
                ;;
        esac
    fi
    printf '%s' "${_line}"
}

ngx_group_ent() {
    _key="${1-}"
    _line=""
    if command -v getent >/dev/null 2>&1; then
        _line=$(getent group "${_key}" 2>/dev/null || true)
    fi
    if [ -z "${_line}" ] && [ -r /etc/group ]; then
        case "${_key}" in
            *[!0-9]*)
                _line=$(awk -F: -v u="${_key}" '$1==u {print; exit}' /etc/group 2>/dev/null || true)
                ;;
            *)
                _line=$(awk -F: -v u="${_key}" '$3==u {print; exit}' /etc/group 2>/dev/null || true)
                ;;
        esac
    fi
    printf '%s' "${_line}"
}

# =============================================================================
# ngx_adm_collision_check() - Fail closed on foreign UID/GID/name/home
# =============================================================================
#
# GENERAL PURPOSE:
# If nginx-adm or UID/GID 1999 exists and is not this identity, setup MUST
# exit non-zero. Do not rewrite a live foreign account.
#
# ALIGNMENT:
# - requirement-least-privilege-user.md (Collision)
#
# Last updated: 2026-08-25
# =============================================================================
ngx_adm_collision_check() {
    ngx_defaults
    _exp_home=$(ngx_expected_adm_home)

    _pw=$(ngx_passwd_ent "${NGINX_ADM_UID}")
    if [ -n "${_pw}" ]; then
        _n=$(printf '%s' "${_pw}" | cut -d: -f1)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_n}" != "${NGINX_ADM_USER}" ]; then
            out_die "UID ${NGINX_ADM_UID} is already account ${_n}. Will not steal that UID. Next: getent passwd ${NGINX_ADM_UID}"
        fi
        if ! ngx_adm_home_is_this_identity "${_h}"; then
            out_die "${NGINX_ADM_USER} UID ${NGINX_ADM_UID} home is ${_h}, expected ${_exp_home}. Will not move a live home. Next: getent passwd ${NGINX_ADM_UID}"
        fi
    fi

    _pw=$(ngx_passwd_ent "${NGINX_ADM_USER}")
    if [ -n "${_pw}" ]; then
        _u=$(printf '%s' "${_pw}" | cut -d: -f3)
        _g=$(printf '%s' "${_pw}" | cut -d: -f4)
        _h=$(printf '%s' "${_pw}" | cut -d: -f6)
        if [ "${_u}" != "${NGINX_ADM_UID}" ] || [ "${_g}" != "${NGINX_ADM_GID}" ]; then
            out_die "${NGINX_ADM_USER} already exists as ${_u}:${_g}, expected ${NGINX_ADM_UID}:${NGINX_ADM_GID}. Will not rewrite a live identity. Next: id ${NGINX_ADM_USER}"
        fi
        if ! ngx_adm_home_is_this_identity "${_h}"; then
            out_die "${NGINX_ADM_USER} home is ${_h}, expected ${_exp_home}. Will not move a live home. Next: getent passwd ${NGINX_ADM_USER}"
        fi
    fi

    _gr=$(ngx_group_ent "${NGINX_ADM_GID}")
    if [ -n "${_gr}" ]; then
        _n=$(printf '%s' "${_gr}" | cut -d: -f1)
        if [ "${_n}" != "${NGINX_ADM_USER}" ]; then
            out_die "GID ${NGINX_ADM_GID} is already group ${_n}. Will not steal that GID. Next: getent group ${NGINX_ADM_GID}"
        fi
    fi

    _gr=$(ngx_group_ent "${NGINX_ADM_USER}")
    if [ -n "${_gr}" ]; then
        _g=$(printf '%s' "${_gr}" | cut -d: -f3)
        if [ "${_g}" != "${NGINX_ADM_GID}" ]; then
            out_die "group ${NGINX_ADM_USER} exists as gid ${_g}, expected ${NGINX_ADM_GID}. Will not rewrite it. Next: getent group ${NGINX_ADM_USER}"
        fi
    fi
}

ngx_fixture_mode() {
    ngx_defaults
    if [ "${NGINX_CLI_FIXTURE}" != "1" ]; then
        return 1
    fi
    if [ -z "${NGINX_ADM_HOME:-}" ]; then
        return 1
    fi
    ngx_path_under_tmp "${NGINX_ADM_HOME}"
}

ngx_resolve_queue_root() {
    ngx_defaults
    if [ -n "${NGINX_QUEUE_ROOT:-}" ]; then
        printf '%s' "${NGINX_QUEUE_ROOT}"
        return 0
    fi
    if ngx_fixture_mode; then
        printf '%s' "$(dirname -- "$(ngx_resolve_adm_home)")/${APP_NAME}-queue"
        return 0
    fi
    printf '%s' "/var/${APP_NAME}"
}

ngx_require_fixture_queue_safe() {
    if ! ngx_fixture_mode; then
        return 0
    fi
    _q=$(ngx_resolve_queue_root)
    if ngx_path_under_tmp "${_q}"; then
        return 0
    fi
    out_die "Fixture mode must not use queue root ${_q} (must be under /tmp or \$TMPDIR)"
}

ngx_queue_dir() {
    ngx_defaults
    case "${1:-}" in
        pending)  printf '%s' "$(ngx_resolve_queue_root)/config-request" ;;
        approved) printf '%s' "$(ngx_resolve_queue_root)/config-approved" ;;
        rejected) printf '%s' "$(ngx_resolve_queue_root)/config-rejected" ;;
        map)      printf '%s' "$(ngx_resolve_adm_home)/user-domain-map" ;;
        *)        printf '%s' "" ;;
    esac
}

ngx_inbound_last_is_symlink() {
    _dir="${1:-}"
    [ -n "${_dir}" ] || return 1
    [ -L "${_dir}" ]
}

ngx_is_root() {
    [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]
}

ngx_is_adm() {
    ngx_defaults
    [ "$(id -un 2>/dev/null || echo "")" = "${NGINX_ADM_USER}" ]
}

ngx_is_listed_submitter() {
    ngx_defaults
    _u=$(id -un 2>/dev/null || echo "")
    [ -n "${_u}" ] || return 1
    _f="${NGINX_CLI_SUBMIT_SUDOERS}"
    if [ -r "${_f}" ]; then
        if grep -v '^[[:space:]]*#' "${_f}" 2>/dev/null | grep -qw "${_u}"; then
            return 0
        fi
    fi
    # Sibling dest after sudoer-adm approve: ${NGINX_CLI_SUBMIT_PER_USER_DIR}/nginx-cli-<login>
    _per="${NGINX_CLI_SUBMIT_PER_USER_DIR}/${APP_NAME}-${_u}"
    if [ -f "${_per}" ] && [ ! -L "${_per}" ]; then
        return 0
    fi
    return 1
}

ngx_can_submit() {
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        return 0
    fi
    if ngx_is_adm; then
        return 0
    fi
    if ngx_is_listed_submitter; then
        return 0
    fi
    return 1
}

ngx_can_approve() {
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        return 0
    fi
    if ngx_is_adm; then
        return 0
    fi
    return 1
}

ngx_require_submit() {
    if ngx_can_submit; then
        return 0
    fi
    out_die "Submit denied. Allowed: root, ${NGINX_ADM_USER}, or a login listed in ${NGINX_CLI_SUBMIT_SUDOERS}."
}

ngx_require_approve() {
    if ngx_can_approve; then
        return 0
    fi
    out_die "Approve/reject denied. Allowed: root or ${NGINX_ADM_USER}."
}

ngx_require_root() {
    ngx_defaults
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    if ngx_is_root; then
        return 0
    fi
    if ngx_fixture_mode; then
        out_die "setup/remove-lpu require real root. Fixture mode cannot create or delete host accounts."
    fi
    # Non-interactive: fail closed (never password-sudo hang; never silent host mutate via sudo -n).
    # Consume TTY measured in the main process (no-retest-tty).
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "This command requires root. Run: sudo ${APP_NAME} ${COMMAND}"
    fi
    if command -v sudo >/dev/null 2>&1; then
        out_info "Re-executing with sudo for Type 1 host change..."
        exec sudo "$0" "${COMMAND}" "$@"
    fi
    out_die "This command requires root. Run: sudo ${APP_NAME} ${COMMAND}"
}

ngx_chown_adm() {
    _path="${1:-}"
    ngx_defaults
    [ -n "${_path}" ] || return 0
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        if ! chown "${NGINX_ADM_USER}:${NGINX_ADM_USER}" "${_path}" 2>/dev/null; then
            chown "${NGINX_ADM_UID}:${NGINX_ADM_GID}" "${_path}" 2>/dev/null || true
        fi
    fi
}

ngx_ensure_home_layout() {
    ngx_defaults
    _home=$(ngx_resolve_adm_home)
    if [ ! -d "${_home}" ]; then
        if ! mkdir -p "${_home}"; then
            out_die "Cannot create LPU home ${_home}"
        fi
    fi
    if [ ! -d "${_home}/user-domain-map" ]; then
        if ! mkdir -p "${_home}/user-domain-map"; then
            out_die "Cannot create ${_home}/user-domain-map"
        fi
    fi
    chmod 0750 "${_home}/user-domain-map" 2>/dev/null || true
    ngx_chown_adm "${_home}/user-domain-map"
    ngx_chown_adm "${_home}"
    chmod 0755 "${_home}" 2>/dev/null || true
}

ngx_ensure_submit_group() {
    ngx_defaults
    if ngx_fixture_mode; then
        return 0
    fi
    if getent group "${NGINX_CLI_SUBMIT_GROUP}" >/dev/null 2>&1; then
        return 0
    fi
    _ga=$(ngx_find_host_bin groupadd) || _ga=""
    if [ -z "${_ga}" ]; then
        out_die "groupadd not found (need ${NGINX_CLI_SUBMIT_GROUP}). Next: install passwd tools or put groupadd on PATH (/usr/sbin)."
    fi
    if ! "${_ga}" "${NGINX_CLI_SUBMIT_GROUP}"; then
        out_die "groupadd failed for ${NGINX_CLI_SUBMIT_GROUP}"
    fi
}

ngx_migrate_home_queue_dir() {
    _home_sub="${1:-}"
    _pub="${2:-}"
    [ -n "${_home_sub}" ] && [ -n "${_pub}" ] || return 0
    if [ ! -d "${_home_sub}" ] || [ -L "${_home_sub}" ]; then
        return 0
    fi
    if [ ! -d "${_pub}" ]; then
        if ! mkdir -p "${_pub}"; then
            out_die "Cannot create ${_pub} for queue migrate"
        fi
    fi
    for _f in "${_home_sub}"/*; do
        [ -e "${_f}" ] || continue
        if ! mv "${_f}" "${_pub}/"; then
            out_die "Failed to migrate ${_f} → ${_pub}/"
        fi
    done
    rm -rf "${_home_sub}"
}

ngx_setup_public_queues() {
    ngx_defaults
    ngx_require_fixture_queue_safe
    ngx_ensure_submit_group
    _q=$(ngx_resolve_queue_root)
    _home=$(ngx_resolve_adm_home)
    if [ ! -d "${_q}" ]; then
        if ! mkdir -p "${_q}"; then
            out_die "Cannot create queue root ${_q}"
        fi
    fi
    ngx_chown_adm "${_q}"
    chmod 0755 "${_q}" 2>/dev/null || true

    ngx_migrate_home_queue_dir "${_home}/config-request" "${_q}/config-request"
    ngx_migrate_home_queue_dir "${_home}/config-approved" "${_q}/config-approved"
    ngx_migrate_home_queue_dir "${_home}/config-rejected" "${_q}/config-rejected"

    if [ ! -d "${_q}/config-request" ]; then
        if ! mkdir -p "${_q}/config-request"; then
            out_die "Cannot create ${_q}/config-request"
        fi
    fi
    if [ ! -d "${_q}/config-approved" ]; then
        if ! mkdir -p "${_q}/config-approved"; then
            out_die "Cannot create ${_q}/config-approved"
        fi
    fi
    if [ ! -d "${_q}/config-rejected" ]; then
        if ! mkdir -p "${_q}/config-rejected"; then
            out_die "Cannot create ${_q}/config-rejected"
        fi
    fi
    if ngx_inbound_last_is_symlink "${_q}/config-request"; then
        out_die "Inbound last component must not be a symlink: ${_q}/config-request"
    fi
    if ! ngx_fixture_mode; then
        chown "${NGINX_ADM_USER}:${NGINX_CLI_SUBMIT_GROUP}" "${_q}/config-request" 2>/dev/null || \
            chown "${NGINX_ADM_UID}:${NGINX_ADM_GID}" "${_q}/config-request" 2>/dev/null || true
        ngx_chown_adm "${_q}/config-approved"
        ngx_chown_adm "${_q}/config-rejected"
    fi
    chmod 2770 "${_q}/config-request" 2>/dev/null || true
    chmod 0700 "${_q}/config-approved" 2>/dev/null || true
    chmod 0700 "${_q}/config-rejected" 2>/dev/null || true
    ln -sfn "${_q}/config-request" "${_home}/config-request"
    ln -sfn "${_q}/config-approved" "${_home}/config-approved"
    ln -sfn "${_q}/config-rejected" "${_home}/config-rejected"
}

ngx_backup_remove_queue_root() {
    ngx_defaults
    _q=$(ngx_resolve_queue_root)
    if [ ! -d "${_q}" ]; then
        return 0
    fi
    _base=$(basename -- "${_q}")
    if [ "${_base}" != "${APP_NAME}" ]; then
        out_die "Refuse to remove queue root ${_q} (basename must be ${APP_NAME})"
    fi
    case "${_q}" in
        /|/var|/etc|/usr|/home|"${HOME}"|/)
            out_die "Refuse to remove protected path ${_q}"
            ;;
    esac
    _bakdir="/var/${APP_NAME}.bak"
    mkdir -p "${_bakdir}"
    _ts=$(date +%Y%m%d)
    _n=1
    _dest="${_bakdir}/${_base}.${_ts}-${_n}"
    while [ -e "${_dest}" ]; do
        _n=$((_n + 1))
        _dest="${_bakdir}/${_base}.${_ts}-${_n}"
    done
    if ! cp -a "${_q}" "${_dest}"; then
        out_die "Cannot backup queue root ${_q}"
    fi
    rm -rf "${_q}"
    out_info "Backed up ${_q} → ${_dest} and removed queue root"
}

ngx_path_safe_user() {
    printf '%s' "${1:-}" | tr '-' '_' | tr -cd 'A-Za-z0-9._'
}

ngx_path_safe_domain() {
    _d="${1:-}"
    case "${_d}" in
        ""|*/*|*..*)
            return 1
            ;;
    esac
    _out=$(printf '%s' "${_d}" | tr -cd 'A-Za-z0-9.-')
    if [ -z "${_out}" ] || [ "${_out}" != "${_d}" ]; then
        return 1
    fi
    printf '%s' "${_out}"
    return 0
}

ngx_next_request_num() {
    _date="$1"
    _user="$2"
    _dom="$3"
    _max=0
    for _q in pending approved rejected; do
        _dir=$(ngx_queue_dir "${_q}")
        [ -d "${_dir}" ] || continue
        for _f in "${_dir}/${_date}-${_user}-${_dom}-"*; do
            [ -e "${_f}" ] || continue
            _base=$(basename -- "${_f}")
            _base=${_base%.json}
            _n=${_base##*-}
            case "${_n}" in
                ''|*[!0-9]*)
                    continue
                    ;;
            esac
            if [ "${_n}" -gt "${_max}" ]; then
                _max=${_n}
            fi
        done
    done
    printf '%s' $((_max + 1))
}

ngx_parse_basename() {
    # Sets NGX_PARSE_DATE NGX_PARSE_USER NGX_PARSE_DOMAIN NGX_PARSE_N
    _name="${1:-}"
    NGX_PARSE_DATE=""
    NGX_PARSE_USER=""
    NGX_PARSE_DOMAIN=""
    NGX_PARSE_N=""
    case "${_name}" in
        */*)
            _name=$(basename -- "${_name}")
            ;;
    esac
    _name=${_name%.json}
    NGX_PARSE_DATE=${_name%%-*}
    case "${NGX_PARSE_DATE}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
            ;;
        *)
            return 1
            ;;
    esac
    _rest=${_name#*-}
    NGX_PARSE_N=${_rest##*-}
    case "${NGX_PARSE_N}" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    _mid=${_rest%-*}
    NGX_PARSE_USER=${_mid%%-*}
    NGX_PARSE_DOMAIN=${_mid#*-}
    if [ -z "${NGX_PARSE_USER}" ] || [ -z "${NGX_PARSE_DOMAIN}" ]; then
        return 1
    fi
    if [ "${NGX_PARSE_USER}" = "${_mid}" ]; then
        return 1
    fi
    return 0
}

ngx_validate_request_header() {
    _file="${1:-}"
    [ -f "${_file}" ] || return 1
    _seen=0
    _body=0
    while IFS= read -r _line || [ -n "${_line}" ]; do
        case "${_line}" in
            "")
                continue
                ;;
            \#*)
                _seen=1
                ;;
            *)
                if [ "${_seen}" -eq 0 ]; then
                    return 1
                fi
                _body=1
                break
                ;;
        esac
    done < "${_file}"
    if [ "${_seen}" -eq 1 ] && [ "${_body}" -eq 1 ]; then
        return 0
    fi
    return 1
}

ngx_map_file() {
    printf '%s/%s' "$(ngx_queue_dir map)" "$(ngx_path_safe_user "${1:-}")"
}

ngx_map_allows() {
    _login="${1:-}"
    _dom="${2:-}"
    if ngx_is_root || ngx_is_adm || ngx_fixture_mode; then
        return 0
    fi
    _f=$(ngx_map_file "${_login}")
    [ -f "${_f}" ] || return 1
    grep -v '^[[:space:]]*#' "${_f}" 2>/dev/null | grep -qx "${_dom}"
}

ngx_map_set() {
    ngx_defaults
    ngx_require_approve
    _login="${1:-}"
    _dom="${2:-}"
    if [ -z "${_login}" ] || [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} map-set <user> <domain>"
    fi
    _safeu=$(ngx_path_safe_user "${_login}")
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    ngx_ensure_home_layout
    _f=$(ngx_map_file "${_safeu}")
    if [ ! -f "${_f}" ]; then
        : > "${_f}"
    fi
    if grep -qx "${_safed}" "${_f}" 2>/dev/null; then
        out_success "Map already has ${_safeu} → ${_safed}"
        ngx_chown_adm "${_f}"
        chmod 0640 "${_f}" 2>/dev/null || true
        return 0
    fi
    printf '%s\n' "${_safed}" >> "${_f}"
    ngx_chown_adm "${_f}"
    chmod 0640 "${_f}" 2>/dev/null || true
    out_success "Mapped ${_safeu} → ${_safed}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-set" "added" "user" "${_safeu}" "domain" "${_safed}"
    fi
}

ngx_map_unset() {
    ngx_defaults
    ngx_require_approve
    _login="${1:-}"
    _dom="${2:-}"
    if [ -z "${_login}" ] || [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} map-unset <user> <domain>"
    fi
    _safeu=$(ngx_path_safe_user "${_login}")
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    _f=$(ngx_map_file "${_safeu}")
    if [ ! -f "${_f}" ]; then
        out_success "No map file for ${_safeu}"
        return 0
    fi
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-map.XXXXXX")
    grep -vx "${_safed}" "${_f}" > "${_tmp}" || true
    mv -f "${_tmp}" "${_f}"
    ngx_chown_adm "${_f}"
    chmod 0640 "${_f}" 2>/dev/null || true
    out_success "Unmapped ${_safeu} → ${_safed}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-unset" "removed" "user" "${_safeu}" "domain" "${_safed}"
    fi
}

ngx_map_list() {
    ngx_defaults
    ngx_require_submit
    _login="${1:-}"
    _dir=$(ngx_queue_dir map)
    if [ ! -d "${_dir}" ]; then
        out_info "No user-domain-map (run setup)"
        return 0
    fi
    if [ -n "${_login}" ]; then
        _f=$(ngx_map_file "$(ngx_path_safe_user "${_login}")")
        if [ ! -f "${_f}" ]; then
            out_info "No map for ${_login}"
            return 0
        fi
        if [ "${JSON}" -eq 1 ]; then
            _items=""
            while IFS= read -r _ln || [ -n "${_ln}" ]; do
                case "${_ln}" in
                    ""|\#*) continue ;;
                esac
                if [ -n "${_items}" ]; then
                    _items="${_items},"
                fi
                _items="${_items}\"$(util_json_escape "${_ln}")\""
            done < "${_f}"
            out_json "map-list" "" "user" "$(ngx_path_safe_user "${_login}")" "@domains" "[${_items}]"
            return 0
        fi
        out_info "Domains for $(ngx_path_safe_user "${_login}"):"
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            case "${_ln}" in
                ""|\#*) continue ;;
            esac
            out_plain "  ${_ln}"
        done < "${_f}"
        return 0
    fi
    _count=0
    for _f in "${_dir}"/*; do
        [ -f "${_f}" ] || continue
        _count=$((_count + 1))
        out_info "$(basename -- "${_f}")"
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            case "${_ln}" in
                ""|\#*) continue ;;
            esac
            out_plain "  ${_ln}"
        done < "${_f}"
    done
    if [ "${_count}" -eq 0 ]; then
        out_info "user-domain-map is empty"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-list" "" "count" "${_count}" "dir" "${_dir}"
    fi
}

ngx_request_submit() {
    ngx_defaults
    : "${JSON:=0}"
    ngx_require_submit
    _dom="${1:-}"
    _src="${2:-}"
    if [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} request <domain> [file|-]"
    fi
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    _login=$(id -un 2>/dev/null || echo "unknown")
    _safeu=$(ngx_path_safe_user "${_login}")
    if ! ngx_map_allows "${_login}" "${_safed}"; then
        out_die "Domain ${_safed} is not in user-domain-map for ${_login}. Approver: ${APP_NAME} map-set ${_login} ${_safed}"
    fi
    ngx_ensure_home_layout
    ngx_require_fixture_queue_safe
    _inbox=$(ngx_queue_dir pending)
    if [ ! -d "${_inbox}" ]; then
        out_die "Inbound missing (${_inbox}). Run: sudo ${APP_NAME} setup"
    fi
    if ngx_inbound_last_is_symlink "${_inbox}"; then
        out_die "Inbound last component must not be a symlink: ${_inbox}"
    fi
    if [ ! -w "${_inbox}" ] && ! ngx_is_root && ! ngx_fixture_mode; then
        out_die "Cannot write inbound ${_inbox}. Join group ${NGINX_CLI_SUBMIT_GROUP} (and be listed in ${NGINX_CLI_SUBMIT_SUDOERS})."
    fi
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-req.XXXXXX")
    if [ -z "${_src}" ] || [ "${_src}" = "-" ]; then
        if [ -t 0 ] && [ -z "${_src}" ]; then
            rm -f "${_tmp}"
            out_die "No request file given and stdin is a TTY. Usage: ${APP_NAME} request <domain> <file>"
        fi
        cat > "${_tmp}"
    else
        if [ ! -f "${_src}" ]; then
            rm -f "${_tmp}"
            out_die "Request file not found: ${_src}"
        fi
        cp "${_src}" "${_tmp}"
    fi
    _jsfile=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-req-json.XXXXXX")
    if ngx_looks_like_json "${_tmp}"; then
        cp "${_tmp}" "${_jsfile}" || { rm -f "${_tmp}" "${_jsfile}"; out_die "Cannot stage request JSON"; }
    else
        _saved_out="${CONVERT_OUT-}"
        _saved_quiet="${QUIET:-0}"
        _saved_json="${JSON:-0}"
        CONVERT_OUT="${_jsfile}"
        export CONVERT_OUT
        QUIET=1
        JSON=0
        if ! ngx_conf_to_json "${_tmp}"; then
            CONVERT_OUT="${_saved_out}"
            QUIET="${_saved_quiet}"
            JSON="${_saved_json}"
            rm -f "${_tmp}" "${_jsfile}"
            out_die "Request text dual failed convert (need # Purpose/# Intention and a server block)."
        fi
        CONVERT_OUT="${_saved_out}"
        QUIET="${_saved_quiet}"
        JSON="${_saved_json}"
    fi
    rm -f "${_tmp}"
    ngx_stamp_submit_identity "${_jsfile}"
    if ! ngx_validate_request_json "${_jsfile}" "${_safed}" "${_safeu}"; then
        rm -f "${_jsfile}"
        out_die "${NGX_FENCE_MSG:-Request JSON invalid (schema, domain, or username). Dest inbound is JSON.}"
    fi
    _date=$(date +%Y%m%d)
    _n=$(ngx_next_request_num "${_date}" "${_safeu}" "${_safed}")
    _base="${_date}-${_safeu}-${_safed}-${_n}.json"
    _dest="${_inbox}/${_base}"
    if [ -e "${_dest}" ]; then
        rm -f "${_jsfile}"
        out_die "Request name already exists: ${_base}"
    fi
    # Exclusive create (noclobber): do not replace a raced inbound name.
    if ! ( umask 027 && set -C && cat "${_jsfile}" > "${_dest}" ); then
        rm -f "${_jsfile}"
        out_die "Failed exclusive-create request ${_base}"
    fi
    rm -f "${_jsfile}"
    chmod 0640 "${_dest}" 2>/dev/null || true
    out_success "Submitted request ${_base}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "request" "submitted" "basename" "${_base}" "domain" "${_safed}" "user" "${_safeu}" "path" "${_dest}"
    fi
}

ngx_list_own_only() {
    if ngx_is_root || ngx_is_adm || ngx_fixture_mode; then
        return 1
    fi
    return 0
}

ngx_list_queue() {
    ngx_defaults
    : "${JSON:=0}"
    ngx_require_submit
    ngx_require_fixture_queue_safe
    _kind="${1:-pending}"
    _dir=$(ngx_queue_dir "${_kind}")
    if [ -z "${_dir}" ]; then
        out_die "Unknown list kind: ${_kind}"
    fi
    if [ ! -d "${_dir}" ]; then
        out_info "No ${_kind} queue (run setup)"
        if [ "${JSON}" -eq 1 ]; then
            out_json "list" "absent" "queue" "${_kind}" "@items" "[]"
        fi
        return 0
    fi
    _own_only=0
    if ngx_list_own_only; then
        _own_only=1
        _me=$(ngx_path_safe_user "$(id -un 2>/dev/null || echo "")")
    fi
    _items=""
    _count=0
    # Class B: ls for deterministic names
    for _f in "${_dir}"/*; do
        [ -f "${_f}" ] || continue
        _base=$(basename -- "${_f}")
        if [ "${_own_only}" -eq 1 ]; then
            if ! ngx_parse_basename "${_base}"; then
                continue
            fi
            if [ "${NGX_PARSE_USER}" != "${_me}" ]; then
                continue
            fi
        fi
        _count=$((_count + 1))
        if [ "${JSON}" -eq 1 ]; then
            if [ -n "${_items}" ]; then
                _items="${_items},"
            fi
            _items="${_items}\"$(util_json_escape "${_base}")\""
        else
            out_plain "${_base}"
        fi
    done
    if [ "${_count}" -eq 0 ] && [ "${JSON}" -eq 0 ]; then
        out_info "No ${_kind} requests"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "list" "" "queue" "${_kind}" "count" "${_count}" "@items" "[${_items}]"
    else
        out_info "${_kind}: ${_count}"
    fi
}

# Human-facing YAML of one inbound JSON object (login-hook / interactive review).
# Inbound file stays JSON. No PyYAML: python3 stdlib only. Nested maps/lists
# indent so the site body is readable (not a JSON object dump).
# ALIGNMENT: requirement-domain-nginx-cli.md
ngx_json_to_yaml() {
    _jf="$1"
    if [ -z "${_jf}" ] || [ ! -f "${_jf}" ] || [ -L "${_jf}" ]; then
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        return 1
    fi
    python3 -c '
import json, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
if not isinstance(data, dict):
    raise SystemExit(2)

def ystr(s):
    s = str(s)
    if not s or s.strip() != s:
        return json.dumps(s, ensure_ascii=False)
    if s.lower() in ("true", "false", "null", "yes", "no", "on", "off"):
        return json.dumps(s, ensure_ascii=False)
    if any(c in s for c in "\n\t:#{}[]&*!|>%@`"):
        return json.dumps(s, ensure_ascii=False)
    if chr(34) in s or chr(39) in s or chr(92) in s:
        return json.dumps(s, ensure_ascii=False)
    return s

def scalar(v):
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return str(v)
    return ystr(v)

def dump_value(v, indent):
    sp = "  " * indent
    if isinstance(v, dict):
        for k, val in v.items():
            dump_kv(k, val, indent)
        return
    if isinstance(v, list):
        for item in v:
            if isinstance(item, dict):
                if not item:
                    print("%s- {}" % sp)
                    continue
                keys = list(item.keys())
                dump_kv_prefixed("%s- " % sp, keys[0], item[keys[0]], indent + 1)
                for k in keys[1:]:
                    dump_kv(k, item[k], indent + 1)
            elif isinstance(item, list):
                print("%s-" % sp)
                dump_value(item, indent + 1)
            else:
                print("%s- %s" % (sp, scalar(item)))

def dump_kv(k, v, indent):
    dump_kv_prefixed("  " * indent, k, v, indent + 1)

def dump_kv_prefixed(prefix, k, v, child_indent):
    if isinstance(v, dict):
        if not v:
            print("%s%s: {}" % (prefix, k))
        else:
            print("%s%s:" % (prefix, k))
            dump_value(v, child_indent)
    elif isinstance(v, list):
        if not v:
            print("%s%s: []" % (prefix, k))
        else:
            print("%s%s:" % (prefix, k))
            dump_value(v, child_indent)
    else:
        print("%s%s: %s" % (prefix, k, scalar(v)))

dump_value(data, 0)
' "${_jf}"
}

ngx_show_request_header() {
    _file="${1:-}"
    [ -f "${_file}" ] || return 1
    if ngx_looks_like_json "${_file}"; then
        _raw=$(cat "${_file}")
        _sapp=$(ngx_json_get_str "${_raw}" "submit_app")
        _sver=$(ngx_json_get_str "${_raw}" "submit_version")
        if [ -n "${_sapp}" ] && [ -n "${_sver}" ]; then
            out_plain "queued by ${_sapp} ${_sver}"
        fi
        if ! _yml=$(ngx_json_to_yaml "${_file}"); then
            out_die "Cannot render request as YAML: ${_file}"
        fi
        if [ -z "${_yml}" ]; then
            out_die "Cannot render request as YAML: ${_file}"
        fi
        out_plain "${_yml}"
        return 0
    fi
    while IFS= read -r _line || [ -n "${_line}" ]; do
        case "${_line}" in
            "")
                continue
                ;;
            \#*)
                out_plain "${_line}"
                ;;
            *)
                break
                ;;
        esac
    done < "${_file}"
}

ngx_publish_conf() {
    ngx_defaults
    _pubsrc="${1:-}"
    _domain="${2:-}"
    _avail="${NGINX_CONF_ROOT}/sites-available"
    _enab="${NGINX_CONF_ROOT}/sites-enabled"
    if [ ! -d "${_avail}" ]; then
        if ! mkdir -p "${_avail}" "${_enab}"; then
            out_die "Cannot create ${_avail} (need root / setup)"
        fi
    fi
    _dest="${_avail}/${_domain}.conf"
    _link="${_enab}/${_domain}.conf"
    if [ -f "${_dest}" ]; then
        util_backup "${_dest}" "pre-approve-publish"
    fi
    if ! cp "${_pubsrc}" "${_dest}"; then
        out_die "Failed to copy to ${_dest}"
    fi
    if ngx_is_root; then
        chown "${NGINX_ADM_USER}:root" "${_dest}" 2>/dev/null || true
    fi
    if ! ln -sfn "${_dest}" "${_link}"; then
        out_die "Failed to symlink ${_link}"
    fi
    if ngx_fixture_mode; then
        out_debug "fixture mode: skipped nginx -t"
    elif [ -x "${NGINX_BIN}" ]; then
        if ! "${NGINX_BIN}" -t 2>/dev/null; then
            rm -f "${_link}"
            rm -f "${_dest}"
            out_die "nginx -t failed; publish rolled back for ${_domain}"
        fi
    else
        out_warn "nginx binary not found at ${NGINX_BIN}; skipped config test"
    fi
}

ngx_find_pending() {
    _base="${1:-}"
    _inbox=$(ngx_queue_dir pending)
    for _try in "${_base}" "${_base}.json" "${_base%.json}"; do
        [ -n "${_try}" ] || continue
        if [ -f "${_inbox}/${_try}" ] && [ ! -L "${_inbox}/${_try}" ]; then
            printf '%s' "${_inbox}/${_try}"
            return 0
        fi
    done
    return 1
}

ngx_looks_like_json() {
    _f="${1:-}"
    [ -f "${_f}" ] || return 1
    _trim=$(sed 's/^[[:space:]]*//' "${_f}" | head -n1)
    case "${_trim}" in
        "{"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Dest JSON Fence (incorrect JSON format). ALIGNMENT: requirement-incorrect-json-format.md
# Return 0 = dest-legal (no Fence). Return 1 = Fence matched (NGX_FENCE_MSG set).
ngx_dest_json_unknown_keys() {
    _dj="${1:-}"
    _flat=$(printf '%s' "${_dj}" | tr '\n' ' ')
    _keys=$(printf '%s' "${_flat}" | tr ',' '\n' | sed -n 's/.*"\([a-z_][a-z0-9_]*\)"[[:space:]]*:.*/\1/p')
    _unk=""
    for _k in ${_keys}; do
        case "${_k}" in
            schema_version|purpose|username|service|action|kind|domain|site|submit_app|submit_version) ;;
            listen|server_name|ssl_certificate|ssl_certificate_key|root|return|code|url|locations|role|match|proxy_pass) ;;
            *)
                _unk="${_k}"
                break
                ;;
        esac
    done
    printf '%s' "${_unk}"
}

ngx_dest_json_fence() {
    _file="${1:-}"
    _exp_dom="${2:-}"
    _exp_user="${3:-}"
    _skip_bn="${4:-}"
    NGX_FENCE_MSG=""
    : "${APP_NAME:=nginx-cli}"
    if [ -z "${_file}" ] || [ ! -f "${_file}" ] || [ -L "${_file}" ]; then
        NGX_FENCE_MSG="Waiting file is not a regular JSON file. Dest did not ask yes or no. Next: fix the file and ${APP_NAME} request it again."
        return 1
    fi
    if ! ngx_looks_like_json "${_file}"; then
        NGX_FENCE_MSG="Waiting file is not dest-legal JSON. Dest did not ask yes or no. Next: fix the JSON and ${APP_NAME} request it again."
        return 1
    fi
    _raw=$(cat "${_file}")
    _unk=$(ngx_dest_json_unknown_keys "${_raw}")
    if [ -n "${_unk}" ]; then
        NGX_FENCE_MSG="Dest JSON has a key dest does not list (${_unk}). Dest did not ask yes or no. Next: remove that key and ${APP_NAME} request it again."
        return 1
    fi
    _purpose=$(ngx_json_get_str "${_raw}" "purpose")
    if [ -z "${_purpose}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing purpose. Dest did not ask yes or no. Next: add purpose and ${APP_NAME} request it again."
        return 1
    fi
    _act=$(ngx_json_get_str "${_raw}" "action")
    _has_site=0
    case "${_raw}" in
        *"\"site\""*) _has_site=1 ;;
    esac
    _sapp=$(ngx_json_get_str "${_raw}" "submit_app")
    _sver=$(ngx_json_get_str "${_raw}" "submit_version")
    if [ "${_act}" = "remove" ] || { [ -z "${_act}" ] && [ "${_has_site}" -eq 0 ]; }; then
        if [ "${_has_site}" -eq 1 ]; then
            NGX_FENCE_MSG="Remove JSON must not include site. Dest did not ask yes or no. Next: drop site and ${APP_NAME} request it again."
            return 1
        fi
        return 0
    fi
    _ver=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"schema_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)
    if [ "${_ver}" != "1" ]; then
        NGX_FENCE_MSG="schema_version must be 1. Dest did not ask yes or no. Next: set schema_version to 1 and ${APP_NAME} request it again."
        return 1
    fi
    if [ -z "${_sapp}" ] || [ -z "${_sver}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing submit_app or submit_version. Dest did not ask yes or no. Next: stamp those strings and ${APP_NAME} request it again."
        return 1
    fi
    _svc=$(ngx_json_get_str "${_raw}" "service")
    if [ -n "${_svc}" ] && [ "${_svc}" != "nginx-cli" ]; then
        NGX_FENCE_MSG="service must be nginx-cli. Dest did not ask yes or no. Next: fix service and ${APP_NAME} request it again."
        return 1
    fi
    _kind=$(ngx_json_get_str "${_raw}" "kind")
    case "${_kind}" in
        per-domain-https|redirect|shared-cloudflare) ;;
        *)
            NGX_FENCE_MSG="kind is not dest-legal. Dest did not ask yes or no. Next: use per-domain-https, redirect, or shared-cloudflare."
            return 1
            ;;
    esac
    _dom=$(ngx_json_get_str "${_raw}" "domain")
    if [ -z "${_dom}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing domain. Dest did not ask yes or no. Next: add domain and ${APP_NAME} request it again."
        return 1
    fi
    if [ -n "${_exp_dom}" ] && [ "${_dom}" != "${_exp_dom}" ]; then
        NGX_FENCE_MSG="JSON domain does not match the request domain. Dest did not ask yes or no. Next: fix domain and ${APP_NAME} request it again."
        return 1
    fi
    _user=$(ngx_json_get_str "${_raw}" "username")
    if [ -z "${_user}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing username. Dest did not ask yes or no. Next: add username and ${APP_NAME} request it again."
        return 1
    fi
    # JSON username is the invoker (id -un). Basename user is path-safe (hyphen → underscore).
    _user_safe=$(ngx_path_safe_user "${_user}")
    _exp_safe=$(ngx_path_safe_user "${_exp_user}")
    if [ -n "${_exp_user}" ] && [ "${_user_safe}" != "${_exp_safe}" ]; then
        NGX_FENCE_MSG="JSON username does not match the submitter. Dest did not ask yes or no. Next: fix username and ${APP_NAME} request it again."
        return 1
    fi
    if [ "${_has_site}" -ne 1 ]; then
        NGX_FENCE_MSG="Add/update JSON must include site. Dest did not ask yes or no. Next: add site and ${APP_NAME} request it again."
        return 1
    fi
    _listen=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"listen"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    _sname=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"server_name"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    if ! ngx_nginx_field_ok "listen" "${_listen}"; then
        NGX_FENCE_MSG="site.listen is not dest-legal. Dest did not ask yes or no. Next: fix listen and ${APP_NAME} request it again."
        return 1
    fi
    if ! ngx_nginx_field_ok "server_name" "${_sname}"; then
        NGX_FENCE_MSG="site.server_name is not dest-legal. Dest did not ask yes or no. Next: fix server_name and ${APP_NAME} request it again."
        return 1
    fi
    ngx_nginx_field_ok "ssl_certificate" "$(ngx_json_get_str "${_raw}" "ssl_certificate")" || {
        NGX_FENCE_MSG="site field refused. Dest did not ask yes or no. Next: remove include/lua paths and ${APP_NAME} request it again."
        return 1
    }
    ngx_nginx_field_ok "ssl_certificate_key" "$(ngx_json_get_str "${_raw}" "ssl_certificate_key")" || return 1
    ngx_nginx_field_ok "root" "$(ngx_json_get_str "${_raw}" "root")" || return 1
    ngx_nginx_field_ok "url" "$(ngx_json_get_str "${_raw}" "url")" || return 1
    ngx_nginx_field_ok "match" "$(ngx_json_get_str "${_raw}" "match")" || return 1
    ngx_nginx_field_ok "proxy_pass" "$(ngx_json_get_str "${_raw}" "proxy_pass")" || return 1
    if [ "${_skip_bn}" != "skip-basename" ]; then
        _bn=$(basename -- "${_file}")
        case "${_bn}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                if ngx_parse_basename "${_bn}"; then
                    if [ -n "${NGX_PARSE_DOMAIN}" ] && [ "${_dom}" != "${NGX_PARSE_DOMAIN}" ]; then
                        NGX_FENCE_MSG="Basename domain does not match JSON domain. Dest did not ask yes or no. Next: rename or fix domain."
                        return 1
                    fi
                    if [ -n "${NGX_PARSE_USER}" ] && [ "${_user_safe}" != "${NGX_PARSE_USER}" ]; then
                        NGX_FENCE_MSG="Basename user does not match JSON username. Dest did not ask yes or no. Next: rename or fix username."
                        return 1
                    fi
                fi
                ;;
        esac
    fi
    return 0
}

ngx_validate_request_json() {
    ngx_dest_json_fence "$@"
}

ngx_stamp_submit_identity() {
    _sf="${1:-}"
    : "${APP_NAME:=nginx-cli}"
    : "${VERSION:=1.0.0}"
    [ -f "${_sf}" ] || return 1
    _raw=$(cat "${_sf}")
    _raw=$(printf '%s' "${_raw}" | tr '\n' '\n')
    _raw=$(printf '%s' "${_raw}" | sed 's/"submit_app"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,\{0,1\}//g')
    _raw=$(printf '%s' "${_raw}" | sed 's/"submit_version"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,\{0,1\}//g')
    _raw=$(printf '%s' "${_raw}" | sed "s/{/{ \"submit_app\": \"${APP_NAME}\", \"submit_version\": \"${VERSION}\", /")
    printf '%s\n' "${_raw}" > "${_sf}"
}

ngx_test_purpose_cmd() {
    _run=$(util_resolve_running_path)
    if [ -n "${_run}" ] && [ -f "${_run}" ]; then
        printf '%s' "${_run}"
        return 0
    fi
    printf '%s' "${APP_NAME}"
}

ngx_tester_read_path() {
    _pos="${1:-}"
    _path="${CONVERT_FILE:-${_pos}}"
    _tmp=""
    if [ -z "${_path}" ]; then
        if [ -t 0 ]; then
            return 2
        fi
        _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.XXXXXX") || return 2
        cat > "${_tmp}" || { rm -f "${_tmp}"; return 2; }
        _path="${_tmp}"
    fi
    NGX_TESTER_PATH="${_path}"
    NGX_TESTER_TMP="${_tmp}"
    return 0
}

ngx_test_json_format() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    _cmd=$(ngx_test_purpose_cmd)
    if [ -n "${FENCE_TEST_DIR:-}" ]; then
        out_die "test-json-format takes stdin xor --file PATH (not --dir). Next: ${_cmd} test-json-format --file PATH"
    fi
    if ! ngx_tester_read_path "${1:-}"; then
        out_die "test-json-format needs --file PATH or stdin. Next: ${_cmd} test-json-format --file PATH"
    fi
    _path="${NGX_TESTER_PATH}"
    _tmp="${NGX_TESTER_TMP}"
    _skip=""
    _bn=$(basename -- "${_path}")
    case "${_bn}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
        *) _skip="skip-basename" ;;
    esac
    if ngx_dest_json_fence "${_path}" "" "" "${_skip}"; then
        [ -n "${_tmp}" ] && rm -f "${_tmp}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "test-json-format" "ok" "path" "${_path}"
        else
            out_success "JSON format is dest-legal."
        fi
        return 0
    fi
    [ -n "${_tmp}" ] && rm -f "${_tmp}"
    out_die "${NGX_FENCE_MSG}"
}

ngx_fence_test() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    : "${FENCE_EXPECT_MATCH:=0}"
    _cmd=$(ngx_test_purpose_cmd)
    _dir="${FENCE_TEST_DIR:-}"
    _file="${CONVERT_FILE:-${1:-}}"
    if [ -n "${_dir}" ] && [ -n "${_file}" ]; then
        out_die "fence-test takes --file PATH or --dir DIR or stdin, not both --file and --dir. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ -n "${_dir}" ]; then
        ngx_fence_test_dir
        return $?
    fi
    if [ "${FENCE_EXPECT_MATCH}" = "1" ]; then
        out_die "--expect-match is only valid with --dir DIR. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/match --expect-match"
    fi
    if ! ngx_tester_read_path "${1:-}"; then
        out_die "fence-test needs --file PATH, --dir DIR, or stdin. Next: ${_cmd} fence-test --file PATH"
    fi
    _path="${NGX_TESTER_PATH}"
    _tmp="${NGX_TESTER_TMP}"
    _skip=""
    _bn=$(basename -- "${_path}")
    case "${_bn}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
        *) _skip="skip-basename" ;;
    esac
    if ngx_dest_json_fence "${_path}" "" "" "${_skip}"; then
        [ -n "${_tmp}" ] && rm -f "${_tmp}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "No dest fence matched." "command" "fence-test" "path" "${_path}"
        else
            out_success "No dest fence matched."
        fi
        return 0
    fi
    [ -n "${_tmp}" ] && rm -f "${_tmp}"
    out_die "${NGX_FENCE_MSG}"
}

ngx_fence_test_dir() {
    _dir="${FENCE_TEST_DIR}"
    _cmd=$(ngx_test_purpose_cmd)
    if [ -z "${_dir}" ]; then
        out_die "fence-test --dir requires DIR. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    if [ ! -d "${_dir}" ]; then
        out_die "fence-test --dir is not a directory: ${_dir}. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    if [ -L "${_dir}" ]; then
        out_die "fence-test refuses a symlink --dir: ${_dir}. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    _expect="${FENCE_EXPECT_MATCH:-0}"
    _n=0
    _matched=0
    _passed=0
    for _fp in "${_dir}"/*.json; do
        [ -f "${_fp}" ] || continue
        [ -L "${_fp}" ] && continue
        _bn=$(basename -- "${_fp}")
        _n=$((_n + 1))
        _skip=""
        case "${_bn}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
            *) _skip="skip-basename" ;;
        esac
        if ngx_dest_json_fence "${_fp}" "" "" "${_skip}"; then
            _passed=$((_passed + 1))
            out_info "pass ${_bn}"
        else
            _matched=$((_matched + 1))
            out_info "fence-matched ${_bn}"
        fi
    done
    if [ "${_n}" -eq 0 ]; then
        out_die "fence-test --dir has no regular .json files: ${_dir}. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ "${_expect}" = "1" ]; then
        if [ "${_passed}" -ne 0 ] || [ "${_matched}" -ne "${_n}" ]; then
            out_die "fence-test --expect-match: ${_passed} of ${_n} files had no dest fence (want every file to match). Next: ${_cmd} fence-test --dir ${_dir} --expect-match"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "fence-test: ${_n} files, all matched a dest fence." \
                "command" "fence-test" "files" "${_n}" "matched" "${_matched}" "passed" "${_passed}" "expect_match" "1"
        else
            out_success "fence-test: ${_n} files, all matched a dest fence."
        fi
        return 0
    fi
    if [ "${_matched}" -ne 0 ]; then
        out_die "fence-test: ${_matched} of ${_n} files matched a dest fence. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "fence-test: ${_n} files, no dest fence matched." \
            "command" "fence-test" "files" "${_n}" "matched" "0" "passed" "${_passed}"
    else
        out_success "fence-test: ${_n} files, no dest fence matched."
    fi
}

ngx_unpublish_conf() {
    ngx_defaults
    _domain="${1:-}"
    _avail="${NGINX_CONF_ROOT}/sites-available/${_domain}.conf"
    _enab="${NGINX_CONF_ROOT}/sites-enabled/${_domain}.conf"
    rm -f "${_enab}"
    if [ -f "${_avail}" ]; then
        util_backup "${_avail}" "pre-approve-remove"
        rm -f "${_avail}"
    fi
}

ngx_snapshot_inbound() {
    _src="${1:-}"
    _snap="${2:-}"
    if [ -z "${_src}" ] || [ -z "${_snap}" ]; then
        return 1
    fi
    if [ -L "${_src}" ]; then
        return 1
    fi
    if [ ! -f "${_src}" ]; then
        return 1
    fi
    if ! cp "${_src}" "${_snap}"; then
        return 1
    fi
    return 0
}

ngx_archive_snapshot_unlink() {
    _snap="${1:-}"
    _src="${2:-}"
    _arch="${3:-}"
    _base="${4:-}"
    if [ ! -d "${_arch}" ]; then
        out_die "Archive missing (${_arch}). Run: sudo ${APP_NAME} setup"
    fi
    if ! cp "${_snap}" "${_arch}/${_base}"; then
        out_die "Failed to archive ${_base} to ${_arch}"
    fi
    ngx_chown_adm "${_arch}/${_base}"
    chmod 0640 "${_arch}/${_base}" 2>/dev/null || true
    rm -f "${_src}"
}

ngx_approve_one() {
    ngx_defaults
    ngx_require_approve
    ngx_require_fixture_queue_safe
    _base="${1:-}"
    if [ -z "${_base}" ]; then
        out_die "Usage: ${APP_NAME} approve <basename>"
    fi
    _inbound=$(ngx_find_pending "${_base}")
    if [ -z "${_inbound}" ]; then
        out_die "Pending request not found: ${_base}"
    fi
    _base=$(basename -- "${_inbound}")
    if ! ngx_parse_basename "${_base}"; then
        out_die "Invalid request basename: ${_base}"
    fi
    _snap=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-snap.XXXXXX")
    if ! ngx_snapshot_inbound "${_inbound}" "${_snap}"; then
        rm -f "${_snap}"
        out_die "Cannot snapshot inbound ${_base} (need regular file, not a symlink)"
    fi
    if ! ngx_validate_request_json "${_snap}" "${NGX_PARSE_DOMAIN}" "${NGX_PARSE_USER}"; then
        _msg="${NGX_FENCE_MSG:-Request JSON invalid. Dest inbound is JSON.}"
        rm -f "${_snap}"
        out_die "${_msg}"
    fi
    _arch=$(ngx_queue_dir approved)
    if [ ! -d "${_arch}" ]; then
        rm -f "${_snap}"
        out_die "Archive missing (${_arch}). Run: sudo ${APP_NAME} setup"
    fi
    _act=$(ngx_json_get_str "$(cat "${_snap}")" "action")
    if [ "${_act}" = "remove" ]; then
        ngx_unpublish_conf "${NGX_PARSE_DOMAIN}"
    else
        _rend=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-rend.XXXXXX")
        _saved_out="${CONVERT_OUT-}"
        _saved_file="${CONVERT_FILE-}"
        _saved_quiet="${QUIET:-0}"
        _saved_json="${JSON:-0}"
        CONVERT_FILE="${_snap}"
        CONVERT_OUT="${_rend}"
        export CONVERT_FILE CONVERT_OUT
        QUIET=1
        JSON=0
        if ! ngx_json_to_conf; then
            CONVERT_OUT="${_saved_out}"
            CONVERT_FILE="${_saved_file}"
            QUIET="${_saved_quiet}"
            JSON="${_saved_json}"
            rm -f "${_snap}" "${_rend}"
            out_die "Cannot render text dual for ${_base}"
        fi
        CONVERT_OUT="${_saved_out}"
        CONVERT_FILE="${_saved_file}"
        QUIET="${_saved_quiet}"
        JSON="${_saved_json}"
        ngx_publish_conf "${_rend}" "${NGX_PARSE_DOMAIN}"
        rm -f "${_rend}"
    fi
    ngx_archive_snapshot_unlink "${_snap}" "${_inbound}" "${_arch}" "${_base}"
    rm -f "${_snap}"
    out_success "Approved ${_base} → sites-available/${NGX_PARSE_DOMAIN}.conf"
    if [ "${JSON}" -eq 1 ]; then
        out_json "approve" "approved" "basename" "${_base}" "domain" "${NGX_PARSE_DOMAIN}"
    fi
}

ngx_reject_one() {
    ngx_defaults
    ngx_require_approve
    ngx_require_fixture_queue_safe
    _base="${1:-}"
    if [ -z "${_base}" ]; then
        out_die "Usage: ${APP_NAME} reject <basename>"
    fi
    _inbound=$(ngx_find_pending "${_base}")
    if [ -z "${_inbound}" ]; then
        out_die "Pending request not found: ${_base}"
    fi
    _base=$(basename -- "${_inbound}")
    _snap=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-snap.XXXXXX")
    if ! ngx_snapshot_inbound "${_inbound}" "${_snap}"; then
        rm -f "${_snap}"
        out_die "Cannot snapshot inbound ${_base} (need regular file, not a symlink)"
    fi
    ngx_archive_snapshot_unlink "${_snap}" "${_inbound}" "$(ngx_queue_dir rejected)" "${_base}"
    rm -f "${_snap}"
    out_success "Rejected ${_base}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "reject" "rejected" "basename" "${_base}"
    fi
}

prompt_approve_choice() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        printf '%s' "quit"
        return 1
    fi
    if [ "${TTY}" -ne 1 ]; then
        printf '%s' "quit"
        return 1
    fi
    out_msg_n "Approve / reject / skip / quit [a/r/s/q]? "
    _ans=""
    read -r _ans || true
    case "${_ans}" in
        [Aa]|[Yy]|[Aa][Pp][Pp][Rr][Oo][Vv][Ee])
            printf '%s' "approve"
            ;;
        [Rr]|[Nn]|[Rr][Ee][Jj][Ee][Cc][Tt])
            printf '%s' "reject"
            ;;
        [Ss]|[Ss][Kk][Ii][Pp])
            printf '%s' "skip"
            ;;
        *)
            printf '%s' "quit"
            ;;
    esac
}

ngx_approve_interactive() {
    ngx_defaults
    ngx_require_approve
    _target="${1:-}"
    if [ -n "${_target}" ]; then
        ngx_approve_one "${_target}"
        return 0
    fi
    : "${TTY:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "Interactive approve needs a TTY. Pass a basename or run without --json/--quiet."
    fi
    _inbox=$(ngx_queue_dir pending)
    if [ ! -d "${_inbox}" ]; then
        out_info "No pending queue (run setup)"
        return 0
    fi
    _any=0
    for _f in "${_inbox}"/*; do
        [ -f "${_f}" ] || continue
        _any=1
        _base=$(basename -- "${_f}")
        out_empty_line
        out_info "Pending: ${_base}"
        _skip=""
        case "${_base}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
            *) _skip="skip-basename" ;;
        esac
        if ! ngx_dest_json_fence "${_f}" "" "" "${_skip}"; then
            out_info "${NGX_FENCE_MSG}"
            ngx_reject_one "${_base}"
            continue
        fi
        # Fence-clear: YAML body (inbound stays JSON). Not a JSON object dump.
        ngx_show_request_header "${_f}"
        _choice=$(prompt_approve_choice)
        case "${_choice}" in
            approve)
                ngx_approve_one "${_base}"
                ;;
            reject)
                ngx_reject_one "${_base}"
                ;;
            skip)
                out_info "Skipped ${_base}"
                ;;
            *)
                out_info "Stopped"
                return 0
                ;;
        esac
    done
    if [ "${_any}" -eq 0 ]; then
        out_info "No pending requests"
    fi
}

# ngx_login_hook_block() - Managed nginx-adm .bashrc snippet to stdout
#
# As-login approve (OPEN-ADM-NOSUDO). MUST NOT wrap sudo or sudo -n.
# Binary is /usr/local/bin/nginx-cli-hook (not $GLOBAL_BIN).
# ALIGNMENT: requirement-login-interactive-review-hook.md
ngx_login_hook_block() {
    ngx_defaults
    : "${NGINX_ADM_USER:=nginx-adm}"
    printf '%s\n' "# >>> ${APP_NAME} interactive approval (managed) >>>"
    printf '%s\n' 'if [ -z "${NGINX_CLI_HOOK_RAN:-}" ] \'
    printf '%s\n' '    && [ -n "${PS1:-}" ] \'
    printf '%s\n' '    && [ -t 0 ] && [ -t 1 ] \'
    printf '%s\n' '    && case "$-" in *i*) true ;; *) false ;; esac \'
    printf '    && [ "$(id -un)" = "%s" ] \\\n' "${NGINX_ADM_USER}"
    printf '%s\n' '    && [ -z "${SSH_ORIGINAL_COMMAND:-}" ]; then'
    printf '%s\n' '    NGINX_CLI_HOOK_RAN=1'
    printf '%s\n' '    export NGINX_CLI_HOOK_RAN'
    printf '%s\n' '    if ! /usr/local/bin/nginx-cli-hook approve; then'
    printf '%s\n' '        printf '"'"'%s\n'"'"' "nginx-cli: login review hook skipped (approve failed)" >&2'
    printf '%s\n' '    fi'
    printf '%s\n' 'fi'
    printf '%s\n' "# <<< ${APP_NAME} interactive approval (managed) <<<"
}

# ngx_profile_block() - Create-if-absent .profile that sources .bashrc
ngx_profile_block() {
    : "${APP_NAME:=nginx-cli}"
    printf '%s\n' "# BEGIN ${APP_NAME} profile source-bashrc"
    printf '%s\n' "# Created so a bash login shell sources interactive rc (hook lives in .bashrc)."
    printf '%s\n' 'if [ -n "${BASH_VERSION:-}" ]; then'
    printf '%s\n' '    if [ -f "${HOME}/.bashrc" ]; then'
    printf '%s\n' '        . "${HOME}/.bashrc"'
    printf '%s\n' '    fi'
    printf '%s\n' 'fi'
    printf '%s\n' "# END ${APP_NAME} profile source-bashrc"
}

# ngx_ensure_login_hook_symlink() - Create nginx-cli-hook when missing
#
# New hook: /usr/local/bin/nginx-cli-hook -> /usr/local/bin/nginx-cli
# MUST NOT overwrite an existing hook name. Fixture MUST NOT write live /usr/local/bin.
# ALIGNMENT: requirement-login-interactive-review-hook.md
ngx_ensure_login_hook_symlink() {
    ngx_defaults
    : "${APP_NAME:=nginx-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if ngx_fixture_mode; then
        return 0
    fi
    case "${GLOBAL_BIN}" in
        /tmp|/tmp/*|/dev/shm|/dev/shm/*)
            return 0
            ;;
    esac
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    _hook="${GLOBAL_BIN}/${APP_NAME}-hook"
    if [ ! -e "${_bin}" ] && [ ! -L "${_bin}" ]; then
        return 0
    fi
    if [ -e "${_hook}" ] || [ -L "${_hook}" ]; then
        return 0
    fi
    if ! ln -s "${APP_NAME}" "${_hook}"; then
        out_die "Cannot create login-hook symlink ${_hook} -> ${APP_NAME}"
    fi
}

ngx_enable_login_approval() {
    ngx_defaults
    ngx_require_approve
    : "${JSON:=0}"
    _home=$(ngx_resolve_adm_home)
    _rc="${_home}/.bashrc"
    _begin="# >>> ${APP_NAME} interactive approval (managed) >>>"
    _end="# <<< ${APP_NAME} interactive approval (managed) <<<"
    if [ ! -d "${_home}" ]; then
        out_die "LPU home missing: ${_home} (run setup)"
    fi
    if [ ! -f "${_rc}" ]; then
        : > "${_rc}"
        ngx_chown_adm "${_rc}"
    fi
    _want=$(ngx_login_hook_block)
    if grep -qF "${_begin}" "${_rc}" 2>/dev/null; then
        _cur=$(awk -v b="${_begin}" -v e="${_end}" '
            $0 == b { p=1 }
            p { print }
            $0 == e { p=0 }
        ' "${_rc}")
        if [ "${_cur}" = "${_want}" ]; then
            out_success "Login approval hook already present in ${_rc}"
            if [ "${JSON}" -eq 1 ]; then
                out_json "enable-login-approval" "already present" "path" "${_rc}"
            fi
            ngx_ensure_login_profile "${_home}"
            return 0
        fi
        _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-bashrc.XXXXXX")
        if [ -z "${_tmp}" ] || [ ! -f "${_tmp}" ]; then
            out_die "cannot create temp for ${_rc}"
        fi
        if ! awk -v b="${_begin}" -v e="${_end}" '
            $0 == b { p=1; next }
            p && $0 == e { p=0; next }
            p { next }
            { print }
        ' "${_rc}" > "${_tmp}"; then
            rm -f "${_tmp}"
            out_die "cannot rewrite ${_rc}"
        fi
        if ! printf '\n%s\n' "${_want}" >> "${_tmp}"; then
            rm -f "${_tmp}"
            out_die "cannot rewrite ${_rc}"
        fi
        if ! mv -f "${_tmp}" "${_rc}"; then
            rm -f "${_tmp}"
            out_die "cannot replace ${_rc}"
        fi
        ngx_chown_adm "${_rc}"
        out_success "Replaced login approval hook in ${_rc}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "enable-login-approval" "replaced" "path" "${_rc}"
        fi
        ngx_ensure_login_profile "${_home}"
        return 0
    fi
    printf '\n%s\n' "${_want}" >> "${_rc}"
    ngx_chown_adm "${_rc}"
    out_success "Added login approval hook to ${_rc}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "enable-login-approval" "added" "path" "${_rc}"
    fi
    ngx_ensure_login_profile "${_home}"
}

# ngx_ensure_login_profile() - Create .profile only when absent
ngx_ensure_login_profile() {
    _home="${1:-}"
    [ -n "${_home}" ] || return 0
    _pf="${_home}/.profile"
    if [ -e "${_pf}" ]; then
        return 0
    fi
    if ! ngx_profile_block > "${_pf}"; then
        out_die "cannot create ${_pf}"
    fi
    ngx_chown_adm "${_pf}"
}

# ngx_f6_cli_argv() - Family 1 sudoers argv + leading --json (password, never NOPASSWD)
#
# sudoers matches argv exactly. nginx-cli --json list-requests is not list-requests.
# MUST NOT emit a lone glob after --json (that would include setup / remove-lpu).
#
# ALIGNMENT: requirement-three-layer-privilege-model.md Table A
# Last updated: 2026-08-23
ngx_f6_cli_argv() {
    _f6_user="${1-}"
    _f6_cli="${2-}"
    _f6_argv="${3-}"
    printf '%s ALL=(root) %s %s\n' "${_f6_user}" "${_f6_cli}" "${_f6_argv}"
    printf '%s ALL=(root) %s --json %s\n' "${_f6_user}" "${_f6_cli}" "${_f6_argv}"
}

ngx_write_adm_sudoers() {
    ngx_defaults
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _dest="${NGINX_ADM_SUDOERS}"
    case "${_dest}" in
        */sudoers.d/*)
            out_die "Family 2 dest must not be under /etc/sudoers.d (${_dest}). Family 1 is a sibling JSON grant."
            ;;
    esac
    _ddir=$(dirname -- "${_dest}")
    if [ ! -d "${_ddir}" ]; then
        if ! mkdir -p "${_ddir}"; then
            out_die "Cannot create ${_ddir} for Family 2 unit-tools sudoers"
        fi
    fi
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-sudoers.XXXXXX")
    {
        printf '%s\n' "# ${NGINX_ADM_USER} Family 2 — NOPASSWD nginx unit tools only (not under /etc/sudoers.d)"
        printf '%s\n' "# Generated by ${APP_NAME} setup"
        printf '%s\n' "# Family 1 nginx-cli verbs are a sibling dest JSON grant, not this file."
        printf '%s\n' "# There is no nginx-ctl command."
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl start %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl stop %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl reload %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl restart %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/journalctl -u %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl start %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: %s\n' "${NGINX_ADM_USER}" "${NGINX_BIN}"
        printf '\n'
    } > "${_tmp}"
    if command -v visudo >/dev/null 2>&1; then
        if ! visudo -c -f "${_tmp}" >/dev/null 2>&1; then
            rm -f "${_tmp}"
            out_die "visudo rejected generated ${_dest}"
        fi
    fi
    if [ -f "${_dest}" ]; then
        util_backup "${_dest}" "pre-setup-sudoers"
    fi
    if ! cp "${_tmp}" "${_dest}"; then
        rm -f "${_tmp}"
        out_die "Cannot install ${_dest}"
    fi
    rm -f "${_tmp}"
    chmod 0440 "${_dest}"
    chown root:root "${_dest}" 2>/dev/null || true
}

ngx_create_adm_user() {
    ngx_defaults
    ngx_adm_collision_check
    if command -v getent >/dev/null 2>&1 && getent passwd "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_info "Account ${NGINX_ADM_USER} already exists"
        return 0
    fi
    if id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_info "Account ${NGINX_ADM_USER} already exists"
        return 0
    fi
    _etc_home="/etc/${NGINX_ADM_USER}"
    _home_sel="preferred-/etc"
    if [ -n "${NGINX_ADM_HOME:-}" ]; then
        _home="${NGINX_ADM_HOME}"
        _home_sel="override"
    elif [ -e "${_etc_home}" ]; then
        _owner=$(stat -c '%U' "${_etc_home}" 2>/dev/null || echo "")
        if [ "${_owner}" != "" ] && [ "${_owner}" != "${NGINX_ADM_USER}" ] && [ "${_owner}" != "root" ]; then
            _home="/home/${NGINX_ADM_USER}"
            _home_sel="fallback-/home"
        else
            _home="${_etc_home}"
        fi
    else
        _home="${_etc_home}"
    fi
    if ! getent group "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        _ga=$(ngx_find_host_bin groupadd) || _ga=""
        if [ -z "${_ga}" ]; then
            out_die "groupadd not found (need ${NGINX_ADM_USER}). Next: install passwd tools or put groupadd on PATH (/usr/sbin)."
        fi
        if ! "${_ga}" -g "${NGINX_ADM_GID}" "${NGINX_ADM_USER}"; then
            out_die "groupadd failed for ${NGINX_ADM_USER}"
        fi
    fi
    _ua=$(ngx_find_host_bin useradd) || _ua=""
    if [ -z "${_ua}" ]; then
        out_die "useradd not found. Next: install passwd tools or put useradd on PATH (/usr/sbin)."
    fi
    if ! "${_ua}" -u "${NGINX_ADM_UID}" -g "${NGINX_ADM_GID}" -d "${_home}" -s "${NGINX_ADM_SHELL}" -c "${NGINX_ADM_GECOS}" -m "${NGINX_ADM_USER}"; then
        out_die "useradd failed for ${NGINX_ADM_USER}"
    fi
    out_success "Created ${NGINX_ADM_USER} uid=${NGINX_ADM_UID} home=${_home} (${_home_sel})"
}

# ngx_adm_passwd_status() - usable | locked | none | fixture | unknown (never the hash)
ngx_adm_passwd_status() {
    ngx_defaults
    if ngx_fixture_mode; then
        printf '%s' "fixture"
        return 0
    fi
    if ! command -v passwd >/dev/null 2>&1; then
        printf '%s' "unknown"
        return 0
    fi
    _st=$(passwd -S "${NGINX_ADM_USER}" 2>/dev/null) || {
        printf '%s' "unknown"
        return 0
    }
    _f2=$(printf '%s\n' "${_st}" | awk '{print $2}')
    case "${_f2}" in
        P|PS)
            printf '%s' "usable"
            ;;
        L|LK)
            printf '%s' "locked"
            ;;
        NP)
            printf '%s' "none"
            ;;
        *)
            printf '%s' "unknown"
            ;;
    esac
}

# ngx_print_adm_sudo_next_step() - Family 1 needs the LPU password; no sudo also works as that login
ngx_print_adm_sudo_next_step() {
    ngx_defaults
    out_info "sudo ${APP_NAME} as ${NGINX_ADM_USER} uses that account's password (Family 1 is not NOPASSWD)."
    out_info "Set or reset: passwd ${NGINX_ADM_USER}"
    out_info "Already logged in as ${NGINX_ADM_USER}: day-to-day verbs also work without sudo (${APP_NAME} approve)."
}

# ngx_ensure_adm_password() - OPEN-PASSWD-CLI: TTY passwd(1) or warn; never record the secret
ngx_ensure_adm_password() {
    ngx_defaults
    : "${TTY:=0}"
    : "${JSON:=0}"
    if ngx_fixture_mode; then
        return 0
    fi
    if ! id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_warn "Account ${NGINX_ADM_USER} missing; cannot set a password"
        return 0
    fi
    _st=$(ngx_adm_passwd_status)
    if [ "${_st}" = "usable" ]; then
        out_info "${NGINX_ADM_USER} already has a password; sudo ${APP_NAME} can authenticate"
        ngx_print_adm_sudo_next_step
        return 0
    fi
    out_info "Family 1 sudo ${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME} needs a ${NGINX_ADM_USER} password (not NOPASSWD)."
    if [ "${JSON}" -eq 0 ] && [ "${TTY}" = "1" ] && [ -t 0 ] && [ -t 1 ] && command -v passwd >/dev/null 2>&1; then
        out_info "Set a password for ${NGINX_ADM_USER} now (typed into passwd; this CLI does not record it)."
        if passwd "${NGINX_ADM_USER}"; then
            out_success "Password set for ${NGINX_ADM_USER}"
            ngx_print_adm_sudo_next_step
            return 0
        fi
        out_warn "passwd ${NGINX_ADM_USER} did not complete. sudo ${APP_NAME} will fail until: passwd ${NGINX_ADM_USER}"
        ngx_print_adm_sudo_next_step
        return 0
    fi
    out_warn "Set a password before sudo ${APP_NAME} as ${NGINX_ADM_USER}: passwd ${NGINX_ADM_USER}"
    ngx_print_adm_sudo_next_step
}

ngx_setup_ownership() {
    ngx_defaults
    if [ ! -d "${NGINX_CONF_ROOT}" ]; then
        if ! mkdir -p "${NGINX_CONF_ROOT}/sites-available" "${NGINX_CONF_ROOT}/sites-enabled"; then
            out_die "Cannot create ${NGINX_CONF_ROOT}"
        fi
    fi
    mkdir -p "${NGINX_CONF_ROOT}/sites-available" "${NGINX_CONF_ROOT}/sites-enabled"
    chown -R "${NGINX_ADM_USER}:root" "${NGINX_CONF_ROOT}"
    chmod 0775 "${NGINX_CONF_ROOT}"
}

ngx_setup_symlinks() {
    ngx_defaults
    _home=$(ngx_resolve_adm_home)
    ln -sfn "${NGINX_CONF_ROOT}/sites-available" "${_home}/sites-available"
    ln -sfn "${NGINX_CONF_ROOT}/sites-enabled" "${_home}/sites-enabled"
}

ngx_backup_remove_sudoers() {
    _f="${1:-}"
    [ -n "${_f}" ] || return 0
    if [ ! -f "${_f}" ]; then
        return 0
    fi
    _bakdir="/etc/sudoers.bak"
    mkdir -p "${_bakdir}"
    _ts=$(date +%Y%m%d)
    _n=1
    _base=$(basename -- "${_f}")
    _dest="${_bakdir}/${_base}.${_ts}-${_n}.bak"
    while [ -e "${_dest}" ]; do
        _n=$((_n + 1))
        _dest="${_bakdir}/${_base}.${_ts}-${_n}.bak"
    done
    cp "${_f}" "${_dest}"
    rm -f "${_f}"
    out_info "Backed up ${_f} → ${_dest}"
}

ngx_setup() {
    ngx_defaults
    ngx_require_root "$@"
    _setup_json="${JSON}"
    JSON=0
    FORCE_GLOBAL=1
    export FORCE_GLOBAL
    inst_local_install
    JSON="${_setup_json}"
    # New hook: labeled symlink /usr/local/bin/nginx-cli-hook -> /usr/local/bin/nginx-cli
    ngx_ensure_login_hook_symlink
    ngx_create_adm_user
    ngx_ensure_home_layout
    ngx_setup_public_queues
    ngx_setup_ownership
    ngx_setup_symlinks
    ngx_write_adm_sudoers
    # Review LPU login hook: replace old /usr/local/bin/nginx-cli approve
    # (or sudo … approve) with /usr/local/bin/nginx-cli-hook approve.
    # ALIGNMENT: requirement-login-interactive-review-hook.md
    ngx_enable_login_approval
    ngx_ensure_adm_password
    ngx_submit_login_hook_sudoer_request
    out_success "nginx-adm least-privilege setup complete"
    case "${LOGIN_HOOK_SUDOER_STATUS:-skipped}" in
        submitted)
            out_info "Queued Family 1 JSON grant for ${NGINX_ADM_USER} (password sudo ${APP_NAME} verbs). Approver: sudoer-adm"
            if [ -n "${LOGIN_HOOK_SUDOER_REQUEST_ID:-}" ]; then
                out_info "login_hook request_id=${LOGIN_HOOK_SUDOER_REQUEST_ID}"
            fi
            out_info "This CLI did not write /etc/sudoers.d. Dest approval reviews the JSON."
            ;;
        failed)
            if [ -n "${LOGIN_HOOK_SUDOER_ERROR:-}" ]; then
                out_warn "Could not queue Family 1 JSON: ${LOGIN_HOOK_SUDOER_ERROR}"
            else
                out_warn "Could not queue Family 1 JSON into sibling inbound"
            fi
            ;;
        *)
            out_info "Family 1 sudoer JSON skipped (sudoer-cli / sudoer-adm / inbound not present). Next: sudo sudoer-cli setup"
            ;;
    esac
    if [ "${JSON}" -eq 1 ]; then
        out_json "setup" "complete" \
            "user" "${NGINX_ADM_USER}" \
            "uid" "${NGINX_ADM_UID}" \
            "home" "$(ngx_resolve_adm_home)" \
            "queue_root" "$(ngx_resolve_queue_root)" \
            "submit_group" "${NGINX_CLI_SUBMIT_GROUP}" \
            "conf_root" "${NGINX_CONF_ROOT}" \
            "passwd_status" "$(ngx_adm_passwd_status)" \
            "login_hook_sudoer" "${LOGIN_HOOK_SUDOER_STATUS:-skipped}" \
            "login_hook_sudoer_request_id" "${LOGIN_HOOK_SUDOER_REQUEST_ID:-}"
    fi
}

ngx_remove_lpu() {
    ngx_defaults
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    ngx_require_root "$@"
    if [ "${FORCE}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            out_die "remove-lpu requires confirmation. Re-run with --force in non-interactive mode."
        fi
        if ! prompt_yes_no "Remove least-privilege account ${NGINX_ADM_USER} (sudoers + account; site files kept)?"; then
            out_info "remove-lpu cancelled"
            return 0
        fi
    fi
    ngx_backup_remove_sudoers "${NGINX_ADM_SUDOERS}"
    ngx_backup_remove_queue_root
    if [ -d "${NGINX_CONF_ROOT}" ]; then
        _own=$(stat -c '%U' "${NGINX_CONF_ROOT}" 2>/dev/null || echo "")
        if [ "${_own}" = "${NGINX_ADM_USER}" ]; then
            chown -R root:root "${NGINX_CONF_ROOT}"
            out_info "Restored ${NGINX_CONF_ROOT} owner to root:root (content kept)"
        fi
    fi
    if id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        _ud=$(ngx_find_host_bin userdel) || _ud=""
        if [ -z "${_ud}" ]; then
            out_die "userdel not found. Next: install passwd tools or put userdel on PATH (/usr/sbin)."
        fi
        if ! "${_ud}" -r "${NGINX_ADM_USER}"; then
            out_die "userdel -r ${NGINX_ADM_USER} failed"
        fi
        out_success "Removed account ${NGINX_ADM_USER} (home via userdel -r)"
    else
        out_info "Account ${NGINX_ADM_USER} already absent"
    fi
    _gd=$(ngx_find_host_bin groupdel) || _gd=""
    if getent group "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        if [ -n "${_gd}" ]; then
            "${_gd}" "${NGINX_ADM_USER}" 2>/dev/null || true
        else
            groupdel "${NGINX_ADM_USER}" 2>/dev/null || true
        fi
    fi
    if getent group "${NGINX_CLI_SUBMIT_GROUP}" >/dev/null 2>&1; then
        if [ -n "${_gd}" ]; then
            "${_gd}" "${NGINX_CLI_SUBMIT_GROUP}" 2>/dev/null || true
        else
            groupdel "${NGINX_CLI_SUBMIT_GROUP}" 2>/dev/null || true
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "remove-lpu" "removed" "user" "${NGINX_ADM_USER}"
    fi
}

# =============================================================================
# ngx_sudoers_trust_tier() - Classify managed-install trust for compose emit
# =============================================================================
#
# GENERAL PURPOSE:
# Prints one of: production | test_local | unmanaged
# production = readable+executable global managed binary
# test_local = only local user-bin managed binary
# unmanaged  = neither path usable
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.5.3
# =============================================================================
ngx_sudoers_trust_tier() {
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -r "${USER_BIN}/${APP_NAME}" ] && [ -x "${USER_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
    return 0
}

# =============================================================================
# ngx_detect_sudoer_cli() - Path of sibling sudoer-cli, or fail
# =============================================================================
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md
# - requirement-domain-nginx-cli.md
# =============================================================================
ngx_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"

    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_detect_sudoer_adm() - sudoer-adm login if present
# =============================================================================
ngx_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_detect_sudoer_inbound() - sibling public inbound if present
# =============================================================================
#
# GENERAL PURPOSE:
# Find the sibling public inbound (preferred /var/sudoer-cli/sudoer-request).
# Type 0 MUST NOT mkdir. Order: env override → public → F4 view → legacy.
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.5.3
# =============================================================================
ngx_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"

    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi

    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi

    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"} \
        "/etc/${SUDOER_ADM_USER}/sudoer-approving" \
        "/home/${SUDOER_ADM_USER}/sudoer-approving"
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# ngx_sudoer_queue_root_from_inbound() - parent of real public inbound
# =============================================================================
# MUST NOT treat a legacy …/sudoer-approving parent as the public queue root.
# =============================================================================
ngx_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND-}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_sudoers_json_text() - dest-honest JSON sudoer file to stdout
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md
# =============================================================================
ngx_sudoers_json_text() {
    : "${APP_NAME:=nginx-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"
    : "${NGINX_ADM_USER:=nginx-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${VERSION:=1.0.0}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    case "${_user}" in
        *\"*|*'\\'*) out_die "refusing username with JSON-unsafe characters" ;;
    esac
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to submit ${APP_NAME} config requests as ${NGINX_ADM_USER}."
    fi
    case "${_purpose}" in
        *\"*|*'\\'*) out_die "refusing purpose with JSON-unsafe characters" ;;
    esac

    cat <<EOF
{
  "schema_version": 1,
  "kind": "type-2-switch",
  "purpose": "${_purpose}",
  "username": "${_user}",
  "service": "${APP_NAME}",
  "action": "${_action}",
  "commands": [
    {
      "runas": "${NGINX_ADM_USER}",
      "tags": ["NOPASSWD"],
      "path": "${_global_path}",
      "args": ["request"]
    }
  ],
  "submit_app": "${APP_NAME}",
  "submit_version": "${VERSION}"
}
EOF
}

