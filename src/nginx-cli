# =============================================================================
# app_menu_collect_ops() - TTY one-field-at-a-time for listed verbs that need operands
# =============================================================================
#
# GENERAL PURPOSE:
# Fill _mm_op1 / _mm_op2 (and SUBMIT_PURPOSE when needed). Empty required
# field → print Next: and return 1 (do not hang).
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-08-23
# =============================================================================
app_menu_collect_ops() {
    : "${APP_NAME:=nginx-cli}"
    _mm_verb="${1-}"
    _mm_op1=""
    _mm_op2=""
    case "${_mm_verb}" in
        request)
            prompt_ask "Domain" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ]; then
                out_info "Next: ${APP_NAME} request <domain> <file>"
                return 1
            fi
            prompt_ask "JSON or nginx-conf file" ""
            _mm_op2="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op2}" ]; then
                out_info "Next: ${APP_NAME} request ${_mm_op1} <file>"
                return 1
            fi
            ;;
        reject)
            prompt_ask "Request basename" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ]; then
                out_info "Next: ${APP_NAME} reject <basename>"
                return 1
            fi
            ;;
        map-set)
            prompt_ask "Submitter login" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            prompt_ask "Domain" ""
            _mm_op2="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ] || [ -z "${_mm_op2}" ]; then
                out_info "Next: ${APP_NAME} map-set <user> <domain>"
                return 1
            fi
            ;;
        map-unset)
            prompt_ask "Submitter login" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            prompt_ask "Domain" ""
            _mm_op2="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ] || [ -z "${_mm_op2}" ]; then
                out_info "Next: ${APP_NAME} map-unset <user> <domain>"
                return 1
            fi
            ;;
        conf-to-json)
            prompt_ask "nginx-conf file" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ]; then
                out_info "Next: ${APP_NAME} conf-to-json --file PATH"
                return 1
            fi
            prompt_ask "Purpose (optional)" ""
            _mm_purp="${PROMPT_ASK_VALUE}"
            if [ -n "${_mm_purp}" ]; then
                SUBMIT_PURPOSE="${_mm_purp}"
                export SUBMIT_PURPOSE
            fi
            ;;
        json-to-conf)
            prompt_ask "JSON file" ""
            _mm_op1="${PROMPT_ASK_VALUE}"
            if [ -z "${_mm_op1}" ]; then
                out_info "Next: ${APP_NAME} json-to-conf --file PATH"
                return 1
            fi
            ;;
        *)
            ;;
    esac
    return 0
}

# =============================================================================
# app_run_command() - Dispatch one live command token
# =============================================================================
#
# GENERAL PURPOSE:
# Single command-to-handler table used by app_main and the numbered list.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-default-interaction.md
# - requirement-domain-nginx-cli.md
#
# Last updated: 2026-08-23
# =============================================================================
app_run_command() {
    _arc_cmd="${1-}"
    _arc_a="${2-}"
    _arc_b="${3-}"
    case "${_arc_cmd}" in
        version)                 app_version ;;
        about)                   app_about ;;
        install)                 inst_local_install ;;
        self-install)            inst_self_install ;;
        uninstall)               inst_local_uninstall ;;
        where-is-me)             app_where_is_me ;;
        setup)                   ngx_setup ;;
        remove-lpu|remove-nginx-adm) ngx_remove_lpu ;;
        request)                 ngx_request_submit "${_arc_a}" "${_arc_b}" ;;
        list-requests)           ngx_list_queue pending ;;
        list-approved)           ngx_list_queue approved ;;
        list-rejected)           ngx_list_queue rejected ;;
        approve)                 ngx_approve_interactive "${_arc_a}" ;;
        reject)                  ngx_reject_one "${_arc_a}" ;;
        enable-login-approval)   ngx_enable_login_approval ;;
        map-set)                 ngx_map_set "${_arc_a}" "${_arc_b}" ;;
        map-unset)               ngx_map_unset "${_arc_a}" "${_arc_b}" ;;
        map-list)                ngx_map_list "${_arc_a}" ;;
        submit-sudoer-request)   ngx_submit_sudoer_request "${_arc_a}" ;;
        conf-to-json)            ngx_conf_to_json "${_arc_a}" ;;
        json-to-conf)            ngx_json_to_conf "${_arc_a}" ;;
        test-json-format)        ngx_test_json_format "${_arc_a}" ;;
        fence-test)              ngx_fence_test "${_arc_a}" ;;
        menu|main)               app_cmd_menu ;;
        help|*)                  app_help ;;
    esac
}


# =============================================================================
# Host class — command line for normal user only
# =============================================================================
# ALIGNMENT: requirement-shell-cli-interface.md · requirement-shell-cli-default-interaction.md
ngx_is_termux() {
    : "${PREFIX:=}"
    if [ -n "${PREFIX}" ] && [ -d "${PREFIX}/bin" ]; then
        case "${PREFIX}" in
            */com.termux/*) return 0 ;;
        esac
    fi
    if [ -n "${TERMUX_VERSION-}" ] || [ -d /data/data/com.termux/files/usr ]; then
        return 0
    fi
    return 1
}

ngx_is_git_bash() {
    case "${MSYSTEM-}" in
        MINGW*|MSYS*|UCRT*|CLANG*) return 0 ;;
    esac
    _uname=$(uname -s 2>/dev/null || true)
    case "${_uname}" in
        MINGW*|MSYS*) unset _uname; return 0 ;;
    esac
    unset _uname
    return 1
}

ngx_is_windows_cmd() {
    if ngx_is_git_bash; then
        return 1
    fi
    if [ -n "${WSL_DISTRO_NAME-}" ]; then
        return 1
    fi
    _uname=$(uname -s 2>/dev/null || true)
    case "${_uname}" in
        CYGWIN*) unset _uname; return 1 ;;
    esac
    case "${OS-}" in
        Windows_NT) unset _uname; return 0 ;;
    esac
    case "${ComSpec-}${COMSPEC-}" in
        *[Cc][Mm][Dd].[Ee][Xx][Ee]*) unset _uname; return 0 ;;
    esac
    case "${_uname}" in
        Linux) unset _uname; return 1 ;;
    esac
    unset _uname
    return 1
}

ngx_is_normal_user_only_cli() {
    if ngx_is_termux; then
        return 0
    fi
    if ngx_is_git_bash; then
        return 0
    fi
    if ngx_is_windows_cmd; then
        return 0
    fi
    return 1
}

ngx_normal_user_only_label() {
    if ngx_is_termux; then
        printf '%s' "termux"
        return 0
    fi
    if ngx_is_git_bash; then
        printf '%s' "gitbash"
        return 0
    fi
    if ngx_is_windows_cmd; then
        printf '%s' "windows-cmd"
        return 0
    fi
    printf '%s' ""
}

# Typed leaf token -> dispatcher verb. Numbers stay on each board.
# version on a board runs about. help / menu / main are not leaves.
ngx_menu_name_verb() {
    case "${1-}" in
        request) printf '%s' "request" ;;
        list-requests) printf '%s' "list-requests" ;;
        list-approved) printf '%s' "list-approved" ;;
        list-rejected) printf '%s' "list-rejected" ;;
        approve) printf '%s' "approve" ;;
        reject) printf '%s' "reject" ;;
        map-set) printf '%s' "map-set" ;;
        map-unset) printf '%s' "map-unset" ;;
        map-list) printf '%s' "map-list" ;;
        conf-to-json) printf '%s' "conf-to-json" ;;
        json-to-conf) printf '%s' "json-to-conf" ;;
        setup) printf '%s' "setup" ;;
        remove-lpu|remove-nginx-adm) printf '%s' "remove-lpu" ;;
        enable-login-approval) printf '%s' "enable-login-approval" ;;
        submit-sudoer-request) printf '%s' "submit-sudoer-request" ;;
        install) printf '%s' "install" ;;
        version) printf '%s' "version" ;;
        about) printf '%s' "about" ;;
        self-install) printf '%s' "self-install" ;;
        *) printf '%s' "" ;;
    esac
}

ngx_menu_trim() {
    _mt_raw="${1-}"
    _mt_raw=$(printf '%s' "${_mt_raw}" | tr -d '\r')
    _mt_raw=$(printf '%s' "${_mt_raw}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    printf '%s' "${_mt_raw}"
    unset _mt_raw
}

# Run one leaf then return. Caller redisplays the front board.
# version on a board runs about (argv version stays a one-liner).
ngx_menu_run() {
    _mr_verb="${1-}"
    if ! app_menu_collect_ops "${_mr_verb}"; then
        unset _mr_verb
        return 0
    fi
    if [ "${_mr_verb}" = "version" ]; then
        app_about
        unset _mr_verb
        return 0
    fi
    app_run_command "${_mr_verb}" "${_mm_op1}" "${_mm_op2}"
    unset _mr_verb
    return 0
}

