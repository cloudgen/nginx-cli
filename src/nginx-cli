    out_plain "  ${APP_NAME} conf-to-json --file ./site.conf"
    out_plain "  ${APP_NAME} json-to-conf --file ./site.json"
    out_plain "  ${APP_NAME} fence-test --file tests/fixtures/fence-test/pass/20260821-alice-example.com-1.json"
    out_plain "  ${APP_NAME} list-requests"
    out_plain "  ${APP_NAME} approve"
    out_plain "  sudo ${APP_NAME} remove-lpu --force"
    out_empty_line
    out_info "Empty argv shows help (Type N — local-only; no curl|sh install-ensure)."
    out_info "Archive-deposit and online-channel verbs are intentionally absent."
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for nginx-cli (Type 0 + domain).
# Empty argv = Type N help (not install-ensure).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-domain-nginx-cli.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last reviewed: 2026-08-13
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    : "${CONVERT_FILE:=}"
    : "${CONVERT_OUT:=}"
    : "${FENCE_TEST_DIR:=}"
    : "${FENCE_EXPECT_MATCH:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=nginx-cli}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Type N: empty argv → help
    if [ $# -eq 0 ]; then
        app_help
        return 0
    fi

    _op1=""
    _op2=""
    _op3=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                export SUBMIT_ACTION
                ;;
            --file)
                if [ $# -lt 2 ]; then
                    out_die "--file requires PATH"
                fi
                CONVERT_FILE="$2"
                export CONVERT_FILE
                shift
                ;;
            --out)
                if [ $# -lt 2 ]; then
                    out_die "--out requires PATH"
                fi
                CONVERT_OUT="$2"
                export CONVERT_OUT
                shift
                ;;
            --action)
                if [ $# -lt 2 ]; then
                    out_die "--action requires add|update"
                fi
                SUBMIT_ACTION="$2"
                export SUBMIT_ACTION
                shift
                ;;
            --dir)
                if [ $# -lt 2 ]; then
                    out_die "--dir requires DIR"
                fi
                FENCE_TEST_DIR="$2"
                export FENCE_TEST_DIR
                shift
                ;;
            --expect-match)
                FENCE_EXPECT_MATCH=1
                export FENCE_EXPECT_MATCH
                ;;
            version|about|help|install|uninstall|where-is-me|setup|remove-lpu|remove-nginx-adm|request|list-requests|list-approved|list-rejected|approve|reject|enable-login-approval|map-set|map-unset|map-list|submit-sudoer-request|conf-to-json|json-to-conf|test-json-format|fence-test)
                COMMAND="$1"
                shift
                break
                ;;
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                export SUBMIT_ACTION
                ;;
            --file)
                if [ $# -lt 2 ]; then
                    out_die "--file requires PATH"
                fi
                CONVERT_FILE="$2"
                export CONVERT_FILE
                shift
                ;;
            --out)
                if [ $# -lt 2 ]; then
                    out_die "--out requires PATH"
                fi
                CONVERT_OUT="$2"
                export CONVERT_OUT
                shift
                ;;
            --action)
                if [ $# -lt 2 ]; then
                    out_die "--action requires add|update"
                fi
                SUBMIT_ACTION="$2"
                export SUBMIT_ACTION
                shift
                ;;
            --dir)
                if [ $# -lt 2 ]; then
                    out_die "--dir requires DIR"
                fi
                FENCE_TEST_DIR="$2"
                export FENCE_TEST_DIR
                shift
                ;;
            --expect-match)
                FENCE_EXPECT_MATCH=1
                export FENCE_EXPECT_MATCH
                ;;
            *)
                if [ -z "${_op1}" ]; then
                    _op1="$1"
                elif [ -z "${_op2}" ]; then
                    _op2="$1"
                elif [ -z "${_op3}" ]; then
                    _op3="$1"
                else
                    out_die "Too many arguments. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL}"

    case "${COMMAND}" in
        version)                 app_version ;;
        about)                   app_about ;;
