            "note" "Use --json with version, about, install, uninstall, where-is-me, list-*, request, submit-sudoer-request."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
