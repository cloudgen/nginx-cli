        _adm_exists="true"
    fi
    _adm_home=$(ngx_resolve_adm_home)
    _conf_root="${NGINX_CONF_ROOT}"
    _qroot=$(ngx_resolve_queue_root)
    _sgroup="${NGINX_CLI_SUBMIT_GROUP}"
    _pending="unknown"
    _inbox=$(ngx_queue_dir pending)
    if [ -d "${_inbox}" ]; then
        _pending=0
        for _pf in "${_inbox}"/*; do
            [ -f "${_pf}" ] || continue
            _pending=$((_pending + 1))
        done
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "nginx_adm_user" "${_adm_user}" \
            "nginx_adm_exists" "${_adm_exists}" \
            "nginx_adm_home" "${_adm_home}" \
            "nginx_conf_root" "${_conf_root}" \
            "nginx_queue_root" "${_qroot}" \
            "nginx_submit_group" "${_sgroup}" \
            "pending_count" "${_pending}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 lifecycle + gated domain)"
    fi
    out_empty_line
    out_info "nginx-adm user:    ${_adm_user} (exists=${_adm_exists})"
    out_info "nginx-adm home:    ${_adm_home}"
    out_info "nginx conf root:   ${_conf_root}"
    out_info "Queue root:        ${_qroot}"
    out_info "Submit group:      ${_sgroup}"
    out_info "Pending requests:  ${_pending}"
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} setup           → Create nginx-adm (root)"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

# =============================================================================
# app_help() - Usage (Type 0 + domain)
# =============================================================================
app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Nginx least-privilege admin CLI}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: Type 0 install plus nginx-adm setup and config request workflow.}"
    : "${GLOBAL_BIN:=/usr/local/bin}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, install, uninstall, where-is-me, list-*, request."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "Lifecycle (Type 0 — local self-managed):"
    out_plain "  install              Install ${APP_NAME} (root→global, user→~/.local/bin)"
    out_plain "  install --global     Force global path (${GLOBAL_BIN}; needs write/root)"
    out_plain "  uninstall            Remove managed binary (confirm or --force)"
    out_plain "  where-is-me          Show running and install paths"
    out_plain "  version              Show local version"
    out_plain "  about                Show diagnostics (includes nginx-adm fields)"
    out_plain "  help                 Show this help"
    out_empty_line
    out_info "Host setup (Type 1 — root; internal sudo re-exec):"
    out_plain "  setup                Create nginx-adm (UID 1999), /var/nginx-cli queues, sudoers, views"
    out_plain "  remove-lpu           Remove nginx-adm (confirm or --force); alias: remove-nginx-adm"
    out_empty_line
    out_info "Config request workflow:"
    out_plain "  request <domain> [file]  Submit nginx conf (header comments required)"
    out_plain "  list-requests            Approving / pending list"
    out_plain "  list-approved            Approved archive"
    out_plain "  list-rejected            Rejected archive"
    out_plain "  approve [basename]       Interactive one-by-one, or approve one file"
    out_plain "  reject <basename>        Reject one pending request"
    out_plain "  enable-login-approval    Add interactive approve to nginx-adm ~/.bashrc"
    out_plain "  map-set <user> <domain>  Add user-domain-map entry (chown nginx-adm)"
    out_plain "  map-unset <user> <domain>  Remove map entry"
    out_plain "  map-list [user]          Show user-domain-map"
    out_empty_line
    out_info "Inbound: /var/nginx-cli/config-request (mode 2770, group nginx-cli-submit)."
    out_info "Submit privilege: root, nginx-adm, or a login listed in /etc/sudoers.d/nginx-cli-submit"
    out_info "and in group nginx-cli-submit. Other users cannot submit."
    out_info "Approvers: root, or nginx-adm via password sudo /usr/local/bin/nginx-cli."
    out_info "nginx-adm may also NOPASSWD sudo /usr/sbin/nginx and systemctl/journalctl -u nginx."
    out_empty_line
    out_info "Global Options:"
    out_plain "  --quiet, -q          Suppress info/success (errors still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall or remove-lpu confirm"
    out_plain "  --global             Install to GLOBAL_BIN"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line
    out_info "Environment:"
    out_plain "  USER_BIN / GLOBAL_BIN     install destinations"
    out_plain "  NGINX_ADM_HOME            override LPU home"
    out_plain "  NGINX_QUEUE_ROOT          public queue root (default /var/nginx-cli)"
    out_plain "  NGINX_CONF_ROOT           default /etc/nginx"
    out_plain "  NGINX_CLI_FIXTURE=1       test fixture (home + queue root must be under /tmp)"
    out_empty_line
    out_info "Examples:"
    out_plain "  sudo ${APP_NAME} setup"
    out_plain "  ${APP_NAME} request example.com ./site.conf"
    out_plain "  ${APP_NAME} list-requests"
    out_plain "  ${APP_NAME} approve"
    out_plain "  sudo ${APP_NAME} remove-lpu --force"
    out_empty_line
    out_info "Empty argv shows help (Type N — local-only; no curl|sh install-ensure)."
    out_info "Archive-deposit and online-channel verbs are intentionally absent."
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for nginx-cli (Type 0 + domain).
# Empty argv = Type N help (not install-ensure).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-domain-nginx-cli.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last reviewed: 2026-08-13
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=nginx-cli}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Type N: empty argv → help
    if [ $# -eq 0 ]; then
        app_help
        return 0
    fi

    _op1=""
    _op2=""
    _op3=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            version|about|help|install|uninstall|where-is-me|setup|remove-lpu|remove-nginx-adm|request|list-requests|list-approved|list-rejected|approve|reject|enable-login-approval|map-set|map-unset|map-list)
                COMMAND="$1"
                shift
                break
                ;;
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            *)
                if [ -z "${_op1}" ]; then
                    _op1="$1"
                elif [ -z "${_op2}" ]; then
                    _op2="$1"
                elif [ -z "${_op3}" ]; then
                    _op3="$1"
                else
                    out_die "Too many arguments. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL}"

    case "${COMMAND}" in
        version)                 app_version ;;
        about)                   app_about ;;
        install)                 inst_local_install ;;
        uninstall)               inst_local_uninstall ;;
        where-is-me)             app_where_is_me ;;
        setup)                   ngx_setup ;;
        remove-lpu|remove-nginx-adm) ngx_remove_lpu ;;
        request)                 ngx_request_submit "${_op1}" "${_op2}" ;;
        list-requests)           ngx_list_queue pending ;;
        list-approved)           ngx_list_queue approved ;;
        list-rejected)           ngx_list_queue rejected ;;
        approve)                 ngx_approve_interactive "${_op1}" ;;
        reject)                  ngx_reject_one "${_op1}" ;;
        enable-login-approval)   ngx_enable_login_approval ;;
        map-set)                 ngx_map_set "${_op1}" "${_op2}" ;;
        map-unset)               ngx_map_unset "${_op1}" "${_op2}" ;;
        map-list)                ngx_map_list "${_op1}" ;;
        help|*)                  app_help ;;
    esac
}

