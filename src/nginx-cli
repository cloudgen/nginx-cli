#
# GENERAL PURPOSE:
# Interactive zero-cli-verb and menu/main draw this tree.
# Front: 1 request-side, 2 host-side, 5 language, 7 sudoers, 8 self-management, 9 Exit.
# Off a terminal this fails closed. It does not hang and it does not print help.
# Choice is a current-shell read. Do not capture read.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-language.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-10-04
# =============================================================================
app_cmd_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=nginx-cli}"
    if [ "${TTY}" -ne 1 ]; then
        out_die "menu needs a terminal. Run a named command instead, for example: ${APP_NAME} help"
    fi
    _mm_saved_json="${JSON}"
    _mm_saved_quiet="${QUIET}"
    JSON=0
    QUIET=0
    INTERACTIVE=1
    export INTERACTIVE
    _show_sudoers=1
    if ngx_is_normal_user_only_cli; then
        _show_sudoers=0
    fi
    while true; do
        out_info "$(util_app_ident)"
        if [ "${_show_sudoers}" -eq 0 ]; then
            out_info "$(app_menu_text hide_sudoers "$(ngx_normal_user_only_label)")"
        fi
        out_menu_choice "1" "$(app_menu_text cat_request)" "$(app_menu_text front_request_long)"
        out_menu_choice "2" "$(app_menu_text cat_host)" "$(app_menu_text front_host_long)"
        out_menu_choice "5" "$(app_menu_text cat_language)" "$(app_menu_text front_language_long)"
        if [ "${_show_sudoers}" -eq 1 ]; then
            out_menu_choice "7" "sudoers" "$(app_menu_text front_sudoers_long)"
        fi
        out_menu_choice "8" "$(app_menu_text cat_self)" "$(app_menu_text front_self_long)"
        out_plain "$(app_menu_text line_exit)"
        out_msg_n "$(app_menu_text line_prompt)"
        _choice=""
        if ! read -r _choice; then
            break
        fi
        _choice=$(ngx_menu_trim "${_choice}")
        case "${_choice}" in
            1|request-side|請求端|请求端|solicitudes|demandes|Anfragen|リクエスト|요청|طلبات|pedidos|запросы|aanvragen|αιτήματα)
                app_cmd_menu_request
                ;;
            2|host-side|主機端|主机端|anfitrión|hôte|Host|ホスト|호스트|مضيف|anfitrião|узел|host|υπολογιστής)
                app_cmd_menu_host
                ;;
            5|language|語言|语言|idioma|langue|Sprache|sprache|言語|언어|لغة|язык|taal|γλώσσα)
                app_cmd_menu_language
                ;;
            7|sudoers)
                if [ "${_show_sudoers}" -eq 1 ]; then
                    app_cmd_menu_sudoers
                else
                    ngx_menu_warn "${_choice}"
                fi
                ;;
            8|self-management|自我管理|autogestión|autogestão|autogestion|Selbstverwaltung|selbstverwaltung|自己管理|자기관리|إدارة-ذاتية|самоуправление|zelfbeheer|αυτοδιαχείριση)
                app_cmd_menu_self
                ;;
            9|99|999|exit|"")
                break
                ;;
            *)
                _nv=$(ngx_menu_name_verb "${_choice}")
                if [ -n "${_nv}" ]; then
                    ngx_menu_run "${_nv}"
                    unset _nv
                else
                    ngx_menu_warn "${_choice}"
                    unset _nv
                fi
                ;;
        esac
    done
    JSON="${_mm_saved_json}"
    QUIET="${_mm_saved_quiet}"
    unset INTERACTIVE _choice _show_sudoers _mm_saved_json _mm_saved_quiet
    return 0
}

# Interactive zero-cli-verb -> menu. Non-interactive -> self-install (local copy).
# --quiet / --json with no verb are non-interactive. --debug on a terminal is the menu.
ngx_zero_cli_verb() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
        app_cmd_menu
        return $?
    fi
    inst_self_install
    return $?
}


# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for nginx-cli.
# Interactive zero-cli-verb (switches such as --debug allowed) -> main menu.
# Non-interactive zero-cli-verb -> self-install (local copy, not help, not setup).
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
# - requirement-domain-nginx-cli.md
#
# Last updated: 2026-10-04
# =============================================================================
app_main() {
    COMMAND=""
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    : "${CONVERT_FILE:=}"
    : "${CONVERT_OUT:=}"
    : "${FENCE_TEST_DIR:=}"
    : "${FENCE_EXPECT_MATCH:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=nginx-cli}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"
    app_lang_load

    # No tokens: interactive -> main menu; otherwise self-install.
    if [ $# -eq 0 ]; then
        ngx_zero_cli_verb
        return $?
    fi

    _op1=""
    _op2=""
    _op3=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                export SUBMIT_ACTION
                ;;
            --file)
                if [ $# -lt 2 ]; then
                    out_die "--file requires PATH"
                fi
                CONVERT_FILE="$2"
                export CONVERT_FILE
                shift
                ;;
            --out)
                if [ $# -lt 2 ]; then
                    out_die "--out requires PATH"
                fi
                CONVERT_OUT="$2"
                export CONVERT_OUT
                shift
                ;;
            --action)
                if [ $# -lt 2 ]; then
                    out_die "--action requires add|update"
                fi
                SUBMIT_ACTION="$2"
                export SUBMIT_ACTION
                shift
                ;;
            --dir)
                if [ $# -lt 2 ]; then
                    out_die "--dir requires DIR"
                fi
                FENCE_TEST_DIR="$2"
                export FENCE_TEST_DIR
                shift
                ;;
            --expect-match)
                FENCE_EXPECT_MATCH=1
                export FENCE_EXPECT_MATCH
                ;;
            version|about|help|menu|main|install|self-install|uninstall|where-is-me|setup|remove-lpu|remove-nginx-adm|request|list-requests|list-approved|list-rejected|approve|reject|enable-login-approval|map-set|map-unset|map-list|submit-sudoer-request|conf-to-json|json-to-conf|test-json-format|fence-test)
                COMMAND="$1"
                shift
                break
                ;;
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                export SUBMIT_ACTION
                ;;
            --file)
                if [ $# -lt 2 ]; then
                    out_die "--file requires PATH"
                fi
                CONVERT_FILE="$2"
                export CONVERT_FILE
                shift
                ;;
            --out)
                if [ $# -lt 2 ]; then
                    out_die "--out requires PATH"
                fi
                CONVERT_OUT="$2"
                export CONVERT_OUT
                shift
                ;;
            --action)
                if [ $# -lt 2 ]; then
                    out_die "--action requires add|update"
                fi
                SUBMIT_ACTION="$2"
                export SUBMIT_ACTION
                shift
                ;;
            --dir)
                if [ $# -lt 2 ]; then
                    out_die "--dir requires DIR"
                fi
                FENCE_TEST_DIR="$2"
                export FENCE_TEST_DIR
                shift
                ;;
            --expect-match)
                FENCE_EXPECT_MATCH=1
                export FENCE_EXPECT_MATCH
                ;;
            *)
                if [ -z "${_op1}" ]; then
                    _op1="$1"
                elif [ -z "${_op2}" ]; then
                    _op2="$1"
                elif [ -z "${_op3}" ]; then
                    _op3="$1"
                else
                    out_die "Too many arguments. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    # Switches only (no verb): same split. --debug stays interactive. --quiet/--json do not.
    if [ -z "${COMMAND}" ]; then
        ngx_zero_cli_verb
        return $?
    fi

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL}"

    app_run_command "${COMMAND}" "${_op1}" "${_op2}"
}

# =============================================================================
# BOOTSTRAP
# =============================================================================
# Always invoke app_main. No basename gate (pipe-safe entry).
# Product law: requirement-shell-cli-zero-arguments.md (interactive zero-cli-verb = menu; non-interactive = self-install).
# =============================================================================
app_main "$@"
