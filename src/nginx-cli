# =============================================================================
# app_about() - Diagnostics (Type 0 + nginx-adm domain fields)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-storage.md
# - requirement-domain-nginx-cli.md
#
# Last reviewed: 2026-08-13
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=nginx-cli}"
    : "${VERSION:=1.0.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=nginx-cli}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ -t 1 ] && _interactive="true"

    ngx_defaults
    _adm_user="${NGINX_ADM_USER}"
    _adm_exists="false"
    if id "${_adm_user}" >/dev/null 2>&1; then
        _adm_exists="true"
    fi
    _adm_home=$(ngx_resolve_adm_home)
    _conf_root="${NGINX_CONF_ROOT}"
    _qroot=$(ngx_resolve_queue_root)
    _sgroup="${NGINX_CLI_SUBMIT_GROUP}"
    _pending="unknown"
    _inbox=$(ngx_queue_dir pending)
    if [ -d "${_inbox}" ]; then
        _pending=0
        for _pf in "${_inbox}"/*; do
            [ -f "${_pf}" ] || continue
            _pending=$((_pending + 1))
        done
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(ngx_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(ngx_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
    fi
    _sudoer_inbound="not_found"
    _sudoer_inbound_writable="false"
    if _sin_path=$(ngx_detect_sudoer_inbound); then
        _sudoer_inbound="${_sin_path}"
        if [ -w "${_sin_path}" ]; then
            _sudoer_inbound_writable="true"
        fi
    fi
    _trust_tier=$(ngx_sudoers_trust_tier)
    _adm_passwd=$(ngx_adm_passwd_status)

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "nginx_adm_user" "${_adm_user}" \
            "nginx_adm_exists" "${_adm_exists}" \
            "nginx_adm_passwd" "${_adm_passwd}" \
            "nginx_adm_home" "${_adm_home}" \
            "nginx_conf_root" "${_conf_root}" \
            "nginx_queue_root" "${_qroot}" \
            "nginx_submit_group" "${_sgroup}" \
            "pending_count" "${_pending}" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "sudoers_trust_tier" "${_trust_tier}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 lifecycle + gated domain)"
    fi
    out_empty_line
    out_info "nginx-adm user:    ${_adm_user} (exists=${_adm_exists})"
    out_info "nginx-adm passwd:  ${_adm_passwd}  (usable needed for sudo ${APP_NAME}; never printed)"
    out_info "nginx-adm home:    ${_adm_home}"
    out_info "nginx conf root:   ${_conf_root}"
    out_info "Queue root:        ${_qroot}"
    out_info "Submit group:      ${_sgroup}"
    out_info "Pending requests:  ${_pending}"
    out_info "Sudoers trust tier: ${_trust_tier}  (production requires global; local-only = test mode)"
    out_info "sudoer-cli:        ${_sudoer_cli}"
    out_info "sudoer-adm:        ${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "sudoer inbound:    not_found (preferred /var/sudoer-cli/sudoer-request)"
    else
        out_info "sudoer inbound:    ${_sudoer_inbound} (writable=${_sudoer_inbound_writable})"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback):  ${STORAGE_DIR}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} setup           → Create nginx-adm (root)"
    out_info "   ${APP_NAME} submit-sudoer-request → JSON request into /var/sudoer-cli/sudoer-request"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

