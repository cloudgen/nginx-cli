    : "${DESCRIPTION:=POSIX /bin/sh CLI: Type 0 install plus nginx-adm setup and config request workflow.}"
    : "${GLOBAL_BIN:=/usr/local/bin}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
