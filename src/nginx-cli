# =============================================================================

ngx_defaults() {
    : "${NGINX_ADM_USER:=nginx-adm}"
    : "${NGINX_ADM_UID:=1999}"
    : "${NGINX_ADM_GID:=1999}"
    : "${NGINX_ADM_SHELL:=/bin/bash}"
    : "${NGINX_ADM_GECOS:=Admin user for nginx configuration}"
    : "${NGINX_CONF_ROOT:=/etc/nginx}"
    : "${NGINX_ADM_SUDOERS:=/etc/sudoers.d/nginx-adm}"
    : "${NGINX_CLI_SUBMIT_SUDOERS:=/etc/sudoers.d/nginx-cli-submit}"
    : "${NGINX_CLI_SUBMIT_PER_USER_DIR:=/etc/sudoers.d}"
    : "${NGINX_CLI_SUBMIT_GROUP:=nginx-cli-submit}"
    : "${NGINX_CLI_FIXTURE:=0}"
    : "${NGINX_WEB_UNIT:=nginx}"
    : "${NGINX_BIN:=/usr/sbin/nginx}"
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${TMPDIR:=/tmp}"
}

ngx_resolve_adm_home() {
    ngx_defaults
    if [ -n "${NGINX_ADM_HOME:-}" ]; then
        printf '%s' "${NGINX_ADM_HOME}"
        return 0
    fi
    _h=""
    if command -v getent >/dev/null 2>&1; then
        _h=$(getent passwd "${NGINX_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_h}" ] && [ -r /etc/passwd ]; then
        _h=$(awk -F: -v u="${NGINX_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi
    if [ -n "${_h}" ]; then
        printf '%s' "${_h}"
        return 0
    fi
    printf '%s' "/etc/${NGINX_ADM_USER}"
}

ngx_path_under_tmp() {
    case "${1:-}" in
        /tmp/*|"${TMPDIR}"/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

ngx_fixture_mode() {
    ngx_defaults
    if [ "${NGINX_CLI_FIXTURE}" != "1" ]; then
        return 1
    fi
    if [ -z "${NGINX_ADM_HOME:-}" ]; then
        return 1
    fi
    ngx_path_under_tmp "${NGINX_ADM_HOME}"
}

ngx_resolve_queue_root() {
    ngx_defaults
    if [ -n "${NGINX_QUEUE_ROOT:-}" ]; then
        printf '%s' "${NGINX_QUEUE_ROOT}"
        return 0
    fi
    if ngx_fixture_mode; then
        printf '%s' "$(dirname -- "$(ngx_resolve_adm_home)")/${APP_NAME}-queue"
        return 0
    fi
    printf '%s' "/var/${APP_NAME}"
}

ngx_require_fixture_queue_safe() {
    if ! ngx_fixture_mode; then
        return 0
    fi
    _q=$(ngx_resolve_queue_root)
    if ngx_path_under_tmp "${_q}"; then
        return 0
    fi
    out_die "Fixture mode must not use queue root ${_q} (must be under /tmp or \$TMPDIR)"
}

ngx_queue_dir() {
    ngx_defaults
    case "${1:-}" in
        pending)  printf '%s' "$(ngx_resolve_queue_root)/config-request" ;;
        approved) printf '%s' "$(ngx_resolve_queue_root)/config-approved" ;;
        rejected) printf '%s' "$(ngx_resolve_queue_root)/config-rejected" ;;
        map)      printf '%s' "$(ngx_resolve_adm_home)/user-domain-map" ;;
        *)        printf '%s' "" ;;
    esac
}

ngx_inbound_last_is_symlink() {
    _dir="${1:-}"
    [ -n "${_dir}" ] || return 1
    [ -L "${_dir}" ]
}

ngx_is_root() {
    [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]
}

ngx_is_adm() {
    ngx_defaults
    [ "$(id -un 2>/dev/null || echo "")" = "${NGINX_ADM_USER}" ]
}

ngx_is_listed_submitter() {
    ngx_defaults
    _u=$(id -un 2>/dev/null || echo "")
    [ -n "${_u}" ] || return 1
    _f="${NGINX_CLI_SUBMIT_SUDOERS}"
    if [ -r "${_f}" ]; then
        if grep -v '^[[:space:]]*#' "${_f}" 2>/dev/null | grep -qw "${_u}"; then
            return 0
        fi
    fi
    # Sibling dest after sudoer-adm approve: ${NGINX_CLI_SUBMIT_PER_USER_DIR}/nginx-cli-<login>
    _per="${NGINX_CLI_SUBMIT_PER_USER_DIR}/${APP_NAME}-${_u}"
    if [ -f "${_per}" ] && [ ! -L "${_per}" ]; then
        return 0
    fi
    return 1
}

ngx_can_submit() {
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        return 0
    fi
    if ngx_is_adm; then
        return 0
    fi
    if ngx_is_listed_submitter; then
        return 0
    fi
    return 1
}

ngx_can_approve() {
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        return 0
    fi
    if ngx_is_adm; then
        return 0
    fi
    return 1
}

ngx_require_submit() {
    if ngx_can_submit; then
        return 0
    fi
    out_die "Submit denied. Allowed: root, ${NGINX_ADM_USER}, or a login listed in ${NGINX_CLI_SUBMIT_SUDOERS}."
}

ngx_require_approve() {
    if ngx_can_approve; then
        return 0
    fi
    out_die "Approve/reject denied. Allowed: root or ${NGINX_ADM_USER}."
}

ngx_require_root() {
    ngx_defaults
    : "${JSON:=0}"
    : "${QUIET:=0}"
    if ngx_is_root; then
        return 0
    fi
    if ngx_fixture_mode; then
        out_die "setup/remove-lpu require real root. Fixture mode cannot create or delete host accounts."
    fi
    # Non-interactive: fail closed (never password-sudo hang; never silent host mutate via sudo -n).
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ ! -t 0 ] || [ ! -t 1 ]; then
        out_die "This command requires root. Run: sudo ${APP_NAME} ${COMMAND}"
    fi
    if command -v sudo >/dev/null 2>&1; then
        out_info "Re-executing with sudo for Type 1 host change..."
        exec sudo "$0" "${COMMAND}" "$@"
    fi
    out_die "This command requires root. Run: sudo ${APP_NAME} ${COMMAND}"
}

ngx_chown_adm() {
    _path="${1:-}"
    ngx_defaults
    [ -n "${_path}" ] || return 0
    if ngx_fixture_mode; then
        return 0
    fi
    if ngx_is_root; then
        if ! chown "${NGINX_ADM_USER}:${NGINX_ADM_USER}" "${_path}" 2>/dev/null; then
            chown "${NGINX_ADM_UID}:${NGINX_ADM_GID}" "${_path}" 2>/dev/null || true
        fi
    fi
}

ngx_ensure_home_layout() {
    ngx_defaults
    _home=$(ngx_resolve_adm_home)
    if [ ! -d "${_home}" ]; then
        if ! mkdir -p "${_home}"; then
            out_die "Cannot create LPU home ${_home}"
        fi
    fi
    if [ ! -d "${_home}/user-domain-map" ]; then
        if ! mkdir -p "${_home}/user-domain-map"; then
            out_die "Cannot create ${_home}/user-domain-map"
        fi
    fi
    chmod 0750 "${_home}/user-domain-map" 2>/dev/null || true
    ngx_chown_adm "${_home}/user-domain-map"
    ngx_chown_adm "${_home}"
    chmod 0755 "${_home}" 2>/dev/null || true
}

ngx_ensure_submit_group() {
    ngx_defaults
    if ngx_fixture_mode; then
        return 0
    fi
    if getent group "${NGINX_CLI_SUBMIT_GROUP}" >/dev/null 2>&1; then
        return 0
    fi
    if ! command -v groupadd >/dev/null 2>&1; then
        out_die "groupadd not found (need ${NGINX_CLI_SUBMIT_GROUP})"
    fi
    if ! groupadd "${NGINX_CLI_SUBMIT_GROUP}"; then
        out_die "groupadd failed for ${NGINX_CLI_SUBMIT_GROUP}"
    fi
}

ngx_migrate_home_queue_dir() {
    _home_sub="${1:-}"
    _pub="${2:-}"
    [ -n "${_home_sub}" ] && [ -n "${_pub}" ] || return 0
    if [ ! -d "${_home_sub}" ] || [ -L "${_home_sub}" ]; then
        return 0
    fi
    if [ ! -d "${_pub}" ]; then
        if ! mkdir -p "${_pub}"; then
            out_die "Cannot create ${_pub} for queue migrate"
        fi
    fi
    for _f in "${_home_sub}"/*; do
        [ -e "${_f}" ] || continue
        if ! mv "${_f}" "${_pub}/"; then
            out_die "Failed to migrate ${_f} → ${_pub}/"
        fi
    done
    rm -rf "${_home_sub}"
}

ngx_setup_public_queues() {
    ngx_defaults
    ngx_require_fixture_queue_safe
    ngx_ensure_submit_group
    _q=$(ngx_resolve_queue_root)
    _home=$(ngx_resolve_adm_home)
    if [ ! -d "${_q}" ]; then
        if ! mkdir -p "${_q}"; then
            out_die "Cannot create queue root ${_q}"
        fi
    fi
    ngx_chown_adm "${_q}"
    chmod 0755 "${_q}" 2>/dev/null || true

    ngx_migrate_home_queue_dir "${_home}/config-request" "${_q}/config-request"
    ngx_migrate_home_queue_dir "${_home}/config-approved" "${_q}/config-approved"
    ngx_migrate_home_queue_dir "${_home}/config-rejected" "${_q}/config-rejected"

    if [ ! -d "${_q}/config-request" ]; then
        if ! mkdir -p "${_q}/config-request"; then
            out_die "Cannot create ${_q}/config-request"
        fi
    fi
    if [ ! -d "${_q}/config-approved" ]; then
        if ! mkdir -p "${_q}/config-approved"; then
            out_die "Cannot create ${_q}/config-approved"
        fi
    fi
    if [ ! -d "${_q}/config-rejected" ]; then
        if ! mkdir -p "${_q}/config-rejected"; then
            out_die "Cannot create ${_q}/config-rejected"
        fi
    fi
    if ngx_inbound_last_is_symlink "${_q}/config-request"; then
        out_die "Inbound last component must not be a symlink: ${_q}/config-request"
    fi
    if ! ngx_fixture_mode; then
        chown "${NGINX_ADM_USER}:${NGINX_CLI_SUBMIT_GROUP}" "${_q}/config-request" 2>/dev/null || \
            chown "${NGINX_ADM_UID}:${NGINX_ADM_GID}" "${_q}/config-request" 2>/dev/null || true
        ngx_chown_adm "${_q}/config-approved"
        ngx_chown_adm "${_q}/config-rejected"
    fi
    chmod 2770 "${_q}/config-request" 2>/dev/null || true
    chmod 0700 "${_q}/config-approved" 2>/dev/null || true
    chmod 0700 "${_q}/config-rejected" 2>/dev/null || true
    ln -sfn "${_q}/config-request" "${_home}/config-request"
    ln -sfn "${_q}/config-approved" "${_home}/config-approved"
    ln -sfn "${_q}/config-rejected" "${_home}/config-rejected"
}

ngx_backup_remove_queue_root() {
    ngx_defaults
    _q=$(ngx_resolve_queue_root)
    if [ ! -d "${_q}" ]; then
        return 0
    fi
    _base=$(basename -- "${_q}")
    if [ "${_base}" != "${APP_NAME}" ]; then
        out_die "Refuse to remove queue root ${_q} (basename must be ${APP_NAME})"
    fi
    case "${_q}" in
        /|/var|/etc|/usr|/home|"${HOME}"|/)
            out_die "Refuse to remove protected path ${_q}"
            ;;
    esac
    _bakdir="/var/${APP_NAME}.bak"
    mkdir -p "${_bakdir}"
    _ts=$(date +%Y%m%d)
    _n=1
    _dest="${_bakdir}/${_base}.${_ts}-${_n}"
    while [ -e "${_dest}" ]; do
        _n=$((_n + 1))
        _dest="${_bakdir}/${_base}.${_ts}-${_n}"
    done
    if ! cp -a "${_q}" "${_dest}"; then
        out_die "Cannot backup queue root ${_q}"
    fi
    rm -rf "${_q}"
    out_info "Backed up ${_q} → ${_dest} and removed queue root"
}

ngx_path_safe_user() {
    printf '%s' "${1:-}" | tr '-' '_' | tr -cd 'A-Za-z0-9._'
}

ngx_path_safe_domain() {
    _d="${1:-}"
    case "${_d}" in
        ""|*/*|*..*)
            return 1
            ;;
    esac
    _out=$(printf '%s' "${_d}" | tr -cd 'A-Za-z0-9.-')
    if [ -z "${_out}" ] || [ "${_out}" != "${_d}" ]; then
        return 1
    fi
    printf '%s' "${_out}"
    return 0
}

ngx_next_request_num() {
    _date="$1"
    _user="$2"
    _dom="$3"
    _max=0
    for _q in pending approved rejected; do
        _dir=$(ngx_queue_dir "${_q}")
        [ -d "${_dir}" ] || continue
        for _f in "${_dir}/${_date}-${_user}-${_dom}-"*; do
            [ -e "${_f}" ] || continue
            _base=$(basename -- "${_f}")
            _base=${_base%.json}
            _n=${_base##*-}
            case "${_n}" in
                ''|*[!0-9]*)
                    continue
                    ;;
            esac
            if [ "${_n}" -gt "${_max}" ]; then
                _max=${_n}
            fi
        done
    done
    printf '%s' $((_max + 1))
}

ngx_parse_basename() {
    # Sets NGX_PARSE_DATE NGX_PARSE_USER NGX_PARSE_DOMAIN NGX_PARSE_N
    _name="${1:-}"
    NGX_PARSE_DATE=""
    NGX_PARSE_USER=""
    NGX_PARSE_DOMAIN=""
    NGX_PARSE_N=""
    case "${_name}" in
        */*)
            _name=$(basename -- "${_name}")
            ;;
    esac
    _name=${_name%.json}
    NGX_PARSE_DATE=${_name%%-*}
    case "${NGX_PARSE_DATE}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
            ;;
        *)
            return 1
            ;;
    esac
    _rest=${_name#*-}
    NGX_PARSE_N=${_rest##*-}
    case "${NGX_PARSE_N}" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac
    _mid=${_rest%-*}
    NGX_PARSE_USER=${_mid%%-*}
    NGX_PARSE_DOMAIN=${_mid#*-}
    if [ -z "${NGX_PARSE_USER}" ] || [ -z "${NGX_PARSE_DOMAIN}" ]; then
        return 1
    fi
    if [ "${NGX_PARSE_USER}" = "${_mid}" ]; then
        return 1
    fi
    return 0
}

ngx_validate_request_header() {
    _file="${1:-}"
    [ -f "${_file}" ] || return 1
    _seen=0
    _body=0
    while IFS= read -r _line || [ -n "${_line}" ]; do
        case "${_line}" in
            "")
                continue
                ;;
            \#*)
                _seen=1
                ;;
            *)
                if [ "${_seen}" -eq 0 ]; then
                    return 1
                fi
                _body=1
                break
                ;;
        esac
    done < "${_file}"
    if [ "${_seen}" -eq 1 ] && [ "${_body}" -eq 1 ]; then
        return 0
    fi
    return 1
}

ngx_map_file() {
    printf '%s/%s' "$(ngx_queue_dir map)" "$(ngx_path_safe_user "${1:-}")"
}

ngx_map_allows() {
    _login="${1:-}"
    _dom="${2:-}"
    if ngx_is_root || ngx_is_adm || ngx_fixture_mode; then
        return 0
    fi
    _f=$(ngx_map_file "${_login}")
    [ -f "${_f}" ] || return 1
    grep -v '^[[:space:]]*#' "${_f}" 2>/dev/null | grep -qx "${_dom}"
}

ngx_map_set() {
    ngx_defaults
    ngx_require_approve
    _login="${1:-}"
    _dom="${2:-}"
    if [ -z "${_login}" ] || [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} map-set <user> <domain>"
    fi
    _safeu=$(ngx_path_safe_user "${_login}")
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    ngx_ensure_home_layout
    _f=$(ngx_map_file "${_safeu}")
    if [ ! -f "${_f}" ]; then
        : > "${_f}"
    fi
    if grep -qx "${_safed}" "${_f}" 2>/dev/null; then
        out_success "Map already has ${_safeu} → ${_safed}"
        ngx_chown_adm "${_f}"
        chmod 0640 "${_f}" 2>/dev/null || true
        return 0
    fi
    printf '%s\n' "${_safed}" >> "${_f}"
    ngx_chown_adm "${_f}"
    chmod 0640 "${_f}" 2>/dev/null || true
    out_success "Mapped ${_safeu} → ${_safed}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-set" "added" "user" "${_safeu}" "domain" "${_safed}"
    fi
}

ngx_map_unset() {
    ngx_defaults
    ngx_require_approve
    _login="${1:-}"
    _dom="${2:-}"
    if [ -z "${_login}" ] || [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} map-unset <user> <domain>"
    fi
    _safeu=$(ngx_path_safe_user "${_login}")
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    _f=$(ngx_map_file "${_safeu}")
    if [ ! -f "${_f}" ]; then
        out_success "No map file for ${_safeu}"
        return 0
    fi
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-map.XXXXXX")
    grep -vx "${_safed}" "${_f}" > "${_tmp}" || true
    mv -f "${_tmp}" "${_f}"
    ngx_chown_adm "${_f}"
    chmod 0640 "${_f}" 2>/dev/null || true
    out_success "Unmapped ${_safeu} → ${_safed}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-unset" "removed" "user" "${_safeu}" "domain" "${_safed}"
    fi
}

ngx_map_list() {
    ngx_defaults
    ngx_require_submit
    _login="${1:-}"
    _dir=$(ngx_queue_dir map)
    if [ ! -d "${_dir}" ]; then
        out_info "No user-domain-map (run setup)"
        return 0
    fi
    if [ -n "${_login}" ]; then
        _f=$(ngx_map_file "$(ngx_path_safe_user "${_login}")")
        if [ ! -f "${_f}" ]; then
            out_info "No map for ${_login}"
            return 0
        fi
        if [ "${JSON}" -eq 1 ]; then
            _items=""
            while IFS= read -r _ln || [ -n "${_ln}" ]; do
                case "${_ln}" in
                    ""|\#*) continue ;;
                esac
                if [ -n "${_items}" ]; then
                    _items="${_items},"
                fi
                _items="${_items}\"$(util_json_escape "${_ln}")\""
            done < "${_f}"
            out_json "map-list" "" "user" "$(ngx_path_safe_user "${_login}")" "@domains" "[${_items}]"
            return 0
        fi
        out_info "Domains for $(ngx_path_safe_user "${_login}"):"
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            case "${_ln}" in
                ""|\#*) continue ;;
            esac
            out_plain "  ${_ln}"
        done < "${_f}"
        return 0
    fi
    _count=0
    for _f in "${_dir}"/*; do
        [ -f "${_f}" ] || continue
        _count=$((_count + 1))
        out_info "$(basename -- "${_f}")"
        while IFS= read -r _ln || [ -n "${_ln}" ]; do
            case "${_ln}" in
                ""|\#*) continue ;;
            esac
            out_plain "  ${_ln}"
        done < "${_f}"
    done
    if [ "${_count}" -eq 0 ]; then
        out_info "user-domain-map is empty"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "map-list" "" "count" "${_count}" "dir" "${_dir}"
    fi
}

ngx_request_submit() {
    ngx_defaults
    : "${JSON:=0}"
    ngx_require_submit
    _dom="${1:-}"
    _src="${2:-}"
    if [ -z "${_dom}" ]; then
        out_die "Usage: ${APP_NAME} request <domain> [file|-]"
    fi
    _safed=$(ngx_path_safe_domain "${_dom}")
    if [ -z "${_safed}" ]; then
        out_die "Invalid domain: ${_dom}"
    fi
    _login=$(id -un 2>/dev/null || echo "unknown")
    _safeu=$(ngx_path_safe_user "${_login}")
    if ! ngx_map_allows "${_login}" "${_safed}"; then
        out_die "Domain ${_safed} is not in user-domain-map for ${_login}. Approver: ${APP_NAME} map-set ${_login} ${_safed}"
    fi
    ngx_ensure_home_layout
    ngx_require_fixture_queue_safe
    _inbox=$(ngx_queue_dir pending)
    if [ ! -d "${_inbox}" ]; then
        out_die "Inbound missing (${_inbox}). Run: sudo ${APP_NAME} setup"
    fi
    if ngx_inbound_last_is_symlink "${_inbox}"; then
        out_die "Inbound last component must not be a symlink: ${_inbox}"
    fi
    if [ ! -w "${_inbox}" ] && ! ngx_is_root && ! ngx_fixture_mode; then
        out_die "Cannot write inbound ${_inbox}. Join group ${NGINX_CLI_SUBMIT_GROUP} (and be listed in ${NGINX_CLI_SUBMIT_SUDOERS})."
    fi
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-req.XXXXXX")
    if [ -z "${_src}" ] || [ "${_src}" = "-" ]; then
        if [ -t 0 ] && [ -z "${_src}" ]; then
            rm -f "${_tmp}"
            out_die "No request file given and stdin is a TTY. Usage: ${APP_NAME} request <domain> <file>"
        fi
        cat > "${_tmp}"
    else
        if [ ! -f "${_src}" ]; then
            rm -f "${_tmp}"
            out_die "Request file not found: ${_src}"
        fi
        cp "${_src}" "${_tmp}"
    fi
    _jsfile=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-req-json.XXXXXX")
    if ngx_looks_like_json "${_tmp}"; then
        cp "${_tmp}" "${_jsfile}" || { rm -f "${_tmp}" "${_jsfile}"; out_die "Cannot stage request JSON"; }
    else
        _saved_out="${CONVERT_OUT-}"
        _saved_quiet="${QUIET:-0}"
        _saved_json="${JSON:-0}"
        CONVERT_OUT="${_jsfile}"
        export CONVERT_OUT
        QUIET=1
        JSON=0
        if ! ngx_conf_to_json "${_tmp}"; then
            CONVERT_OUT="${_saved_out}"
            QUIET="${_saved_quiet}"
            JSON="${_saved_json}"
            rm -f "${_tmp}" "${_jsfile}"
            out_die "Request text dual failed convert (need # Purpose/# Intention and a server block)."
        fi
        CONVERT_OUT="${_saved_out}"
        QUIET="${_saved_quiet}"
        JSON="${_saved_json}"
    fi
    rm -f "${_tmp}"
    ngx_stamp_submit_identity "${_jsfile}"
    if ! ngx_validate_request_json "${_jsfile}" "${_safed}" "${_safeu}"; then
        rm -f "${_jsfile}"
        out_die "${NGX_FENCE_MSG:-Request JSON invalid (schema, domain, or username). Dest inbound is JSON.}"
    fi
    _date=$(date +%Y%m%d)
    _n=$(ngx_next_request_num "${_date}" "${_safeu}" "${_safed}")
    _base="${_date}-${_safeu}-${_safed}-${_n}.json"
    _dest="${_inbox}/${_base}"
    if [ -e "${_dest}" ]; then
        rm -f "${_jsfile}"
        out_die "Request name already exists: ${_base}"
    fi
    # Exclusive create (noclobber): do not replace a raced inbound name.
    if ! ( umask 027 && set -C && cat "${_jsfile}" > "${_dest}" ); then
        rm -f "${_jsfile}"
        out_die "Failed exclusive-create request ${_base}"
    fi
    rm -f "${_jsfile}"
    chmod 0640 "${_dest}" 2>/dev/null || true
    out_success "Submitted request ${_base}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "request" "submitted" "basename" "${_base}" "domain" "${_safed}" "user" "${_safeu}" "path" "${_dest}"
    fi
}

ngx_list_own_only() {
    if ngx_is_root || ngx_is_adm || ngx_fixture_mode; then
        return 1
    fi
    return 0
}

ngx_list_queue() {
    ngx_defaults
    : "${JSON:=0}"
    ngx_require_submit
    ngx_require_fixture_queue_safe
    _kind="${1:-pending}"
    _dir=$(ngx_queue_dir "${_kind}")
    if [ -z "${_dir}" ]; then
        out_die "Unknown list kind: ${_kind}"
    fi
    if [ ! -d "${_dir}" ]; then
        out_info "No ${_kind} queue (run setup)"
        if [ "${JSON}" -eq 1 ]; then
            out_json "list" "absent" "queue" "${_kind}" "@items" "[]"
        fi
        return 0
    fi
    _own_only=0
    if ngx_list_own_only; then
        _own_only=1
        _me=$(ngx_path_safe_user "$(id -un 2>/dev/null || echo "")")
    fi
    _items=""
    _count=0
    # Class B: ls for deterministic names
    for _f in "${_dir}"/*; do
        [ -f "${_f}" ] || continue
        _base=$(basename -- "${_f}")
        if [ "${_own_only}" -eq 1 ]; then
            if ! ngx_parse_basename "${_base}"; then
                continue
            fi
            if [ "${NGX_PARSE_USER}" != "${_me}" ]; then
                continue
            fi
        fi
        _count=$((_count + 1))
        if [ "${JSON}" -eq 1 ]; then
            if [ -n "${_items}" ]; then
                _items="${_items},"
            fi
            _items="${_items}\"$(util_json_escape "${_base}")\""
        else
            out_plain "${_base}"
        fi
    done
    if [ "${_count}" -eq 0 ] && [ "${JSON}" -eq 0 ]; then
        out_info "No ${_kind} requests"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "list" "" "queue" "${_kind}" "count" "${_count}" "@items" "[${_items}]"
    else
        out_info "${_kind}: ${_count}"
    fi
}

ngx_show_request_header() {
    _file="${1:-}"
    [ -f "${_file}" ] || return 1
    if ngx_looks_like_json "${_file}"; then
        _raw=$(cat "${_file}")
        out_plain "purpose: $(ngx_json_get_str "${_raw}" "purpose")"
        out_plain "action: $(ngx_json_get_str "${_raw}" "action")"
        out_plain "domain: $(ngx_json_get_str "${_raw}" "domain")"
        _sapp=$(ngx_json_get_str "${_raw}" "submit_app")
        _sver=$(ngx_json_get_str "${_raw}" "submit_version")
        if [ -n "${_sapp}" ] && [ -n "${_sver}" ]; then
            out_plain "queued by ${_sapp} ${_sver}"
        fi
        return 0
    fi
    while IFS= read -r _line || [ -n "${_line}" ]; do
        case "${_line}" in
            "")
                continue
                ;;
            \#*)
                out_plain "${_line}"
                ;;
            *)
                break
                ;;
        esac
    done < "${_file}"
}

ngx_publish_conf() {
    ngx_defaults
    _pubsrc="${1:-}"
    _domain="${2:-}"
    _avail="${NGINX_CONF_ROOT}/sites-available"
    _enab="${NGINX_CONF_ROOT}/sites-enabled"
    if [ ! -d "${_avail}" ]; then
        if ! mkdir -p "${_avail}" "${_enab}"; then
            out_die "Cannot create ${_avail} (need root / setup)"
        fi
    fi
    _dest="${_avail}/${_domain}.conf"
    _link="${_enab}/${_domain}.conf"
    if [ -f "${_dest}" ]; then
        util_backup "${_dest}" "pre-approve-publish"
    fi
    if ! cp "${_pubsrc}" "${_dest}"; then
        out_die "Failed to copy to ${_dest}"
    fi
    if ngx_is_root; then
        chown "${NGINX_ADM_USER}:root" "${_dest}" 2>/dev/null || true
    fi
    if ! ln -sfn "${_dest}" "${_link}"; then
        out_die "Failed to symlink ${_link}"
    fi
    if ngx_fixture_mode; then
        out_debug "fixture mode: skipped nginx -t"
    elif [ -x "${NGINX_BIN}" ]; then
        if ! "${NGINX_BIN}" -t 2>/dev/null; then
            rm -f "${_link}"
            rm -f "${_dest}"
            out_die "nginx -t failed; publish rolled back for ${_domain}"
        fi
    else
        out_warn "nginx binary not found at ${NGINX_BIN}; skipped config test"
    fi
}

ngx_find_pending() {
    _base="${1:-}"
    _inbox=$(ngx_queue_dir pending)
    for _try in "${_base}" "${_base}.json" "${_base%.json}"; do
        [ -n "${_try}" ] || continue
        if [ -f "${_inbox}/${_try}" ] && [ ! -L "${_inbox}/${_try}" ]; then
            printf '%s' "${_inbox}/${_try}"
            return 0
        fi
    done
    return 1
}

ngx_looks_like_json() {
    _f="${1:-}"
    [ -f "${_f}" ] || return 1
    _trim=$(sed 's/^[[:space:]]*//' "${_f}" | head -n1)
    case "${_trim}" in
        "{"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Dest JSON Fence (incorrect JSON format). ALIGNMENT: requirement-incorrect-json-format.md
# Return 0 = dest-legal (no Fence). Return 1 = Fence matched (NGX_FENCE_MSG set).
ngx_dest_json_unknown_keys() {
    _dj="${1:-}"
    _flat=$(printf '%s' "${_dj}" | tr '\n' ' ')
    _keys=$(printf '%s' "${_flat}" | tr ',' '\n' | sed -n 's/.*"\([a-z_][a-z0-9_]*\)"[[:space:]]*:.*/\1/p')
    _unk=""
    for _k in ${_keys}; do
        case "${_k}" in
            schema_version|purpose|username|service|action|kind|domain|site|submit_app|submit_version) ;;
            listen|server_name|ssl_certificate|ssl_certificate_key|root|return|code|url|locations|role|match|proxy_pass) ;;
            *)
                _unk="${_k}"
                break
                ;;
        esac
    done
    printf '%s' "${_unk}"
}

ngx_dest_json_fence() {
    _file="${1:-}"
    _exp_dom="${2:-}"
    _exp_user="${3:-}"
    _skip_bn="${4:-}"
    NGX_FENCE_MSG=""
    : "${APP_NAME:=nginx-cli}"
    if [ -z "${_file}" ] || [ ! -f "${_file}" ] || [ -L "${_file}" ]; then
        NGX_FENCE_MSG="Waiting file is not a regular JSON file. Dest did not ask yes or no. Next: fix the file and ${APP_NAME} request it again."
        return 1
    fi
    if ! ngx_looks_like_json "${_file}"; then
        NGX_FENCE_MSG="Waiting file is not dest-legal JSON. Dest did not ask yes or no. Next: fix the JSON and ${APP_NAME} request it again."
        return 1
    fi
    _raw=$(cat "${_file}")
    _unk=$(ngx_dest_json_unknown_keys "${_raw}")
    if [ -n "${_unk}" ]; then
        NGX_FENCE_MSG="Dest JSON has a key dest does not list (${_unk}). Dest did not ask yes or no. Next: remove that key and ${APP_NAME} request it again."
        return 1
    fi
    _purpose=$(ngx_json_get_str "${_raw}" "purpose")
    if [ -z "${_purpose}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing purpose. Dest did not ask yes or no. Next: add purpose and ${APP_NAME} request it again."
        return 1
    fi
    _act=$(ngx_json_get_str "${_raw}" "action")
    _has_site=0
    case "${_raw}" in
        *"\"site\""*) _has_site=1 ;;
    esac
    _sapp=$(ngx_json_get_str "${_raw}" "submit_app")
    _sver=$(ngx_json_get_str "${_raw}" "submit_version")
    if [ "${_act}" = "remove" ] || { [ -z "${_act}" ] && [ "${_has_site}" -eq 0 ]; }; then
        if [ "${_has_site}" -eq 1 ]; then
            NGX_FENCE_MSG="Remove JSON must not include site. Dest did not ask yes or no. Next: drop site and ${APP_NAME} request it again."
            return 1
        fi
        return 0
    fi
    _ver=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"schema_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)
    if [ "${_ver}" != "1" ]; then
        NGX_FENCE_MSG="schema_version must be 1. Dest did not ask yes or no. Next: set schema_version to 1 and ${APP_NAME} request it again."
        return 1
    fi
    if [ -z "${_sapp}" ] || [ -z "${_sver}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing submit_app or submit_version. Dest did not ask yes or no. Next: stamp those strings and ${APP_NAME} request it again."
        return 1
    fi
    _svc=$(ngx_json_get_str "${_raw}" "service")
    if [ -n "${_svc}" ] && [ "${_svc}" != "nginx-cli" ]; then
        NGX_FENCE_MSG="service must be nginx-cli. Dest did not ask yes or no. Next: fix service and ${APP_NAME} request it again."
        return 1
    fi
    _kind=$(ngx_json_get_str "${_raw}" "kind")
    case "${_kind}" in
        per-domain-https|redirect|shared-cloudflare) ;;
        *)
            NGX_FENCE_MSG="kind is not dest-legal. Dest did not ask yes or no. Next: use per-domain-https, redirect, or shared-cloudflare."
            return 1
            ;;
    esac
    _dom=$(ngx_json_get_str "${_raw}" "domain")
    if [ -z "${_dom}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing domain. Dest did not ask yes or no. Next: add domain and ${APP_NAME} request it again."
        return 1
    fi
    if [ -n "${_exp_dom}" ] && [ "${_dom}" != "${_exp_dom}" ]; then
        NGX_FENCE_MSG="JSON domain does not match the request domain. Dest did not ask yes or no. Next: fix domain and ${APP_NAME} request it again."
        return 1
    fi
    _user=$(ngx_json_get_str "${_raw}" "username")
    if [ -z "${_user}" ]; then
        NGX_FENCE_MSG="Dest JSON is missing username. Dest did not ask yes or no. Next: add username and ${APP_NAME} request it again."
        return 1
    fi
    if [ -n "${_exp_user}" ] && [ "${_user}" != "${_exp_user}" ]; then
        NGX_FENCE_MSG="JSON username does not match the submitter. Dest did not ask yes or no. Next: fix username and ${APP_NAME} request it again."
        return 1
    fi
    if [ "${_has_site}" -ne 1 ]; then
        NGX_FENCE_MSG="Add/update JSON must include site. Dest did not ask yes or no. Next: add site and ${APP_NAME} request it again."
        return 1
    fi
    _listen=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"listen"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    _sname=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"server_name"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    if ! ngx_nginx_field_ok "listen" "${_listen}"; then
        NGX_FENCE_MSG="site.listen is not dest-legal. Dest did not ask yes or no. Next: fix listen and ${APP_NAME} request it again."
        return 1
    fi
    if ! ngx_nginx_field_ok "server_name" "${_sname}"; then
        NGX_FENCE_MSG="site.server_name is not dest-legal. Dest did not ask yes or no. Next: fix server_name and ${APP_NAME} request it again."
        return 1
    fi
    ngx_nginx_field_ok "ssl_certificate" "$(ngx_json_get_str "${_raw}" "ssl_certificate")" || {
        NGX_FENCE_MSG="site field refused. Dest did not ask yes or no. Next: remove include/lua paths and ${APP_NAME} request it again."
        return 1
    }
    ngx_nginx_field_ok "ssl_certificate_key" "$(ngx_json_get_str "${_raw}" "ssl_certificate_key")" || return 1
    ngx_nginx_field_ok "root" "$(ngx_json_get_str "${_raw}" "root")" || return 1
    ngx_nginx_field_ok "url" "$(ngx_json_get_str "${_raw}" "url")" || return 1
    ngx_nginx_field_ok "match" "$(ngx_json_get_str "${_raw}" "match")" || return 1
    ngx_nginx_field_ok "proxy_pass" "$(ngx_json_get_str "${_raw}" "proxy_pass")" || return 1
    if [ "${_skip_bn}" != "skip-basename" ]; then
        _bn=$(basename -- "${_file}")
        case "${_bn}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json)
                if ngx_parse_basename "${_bn}"; then
                    if [ -n "${NGX_PARSE_DOMAIN}" ] && [ "${_dom}" != "${NGX_PARSE_DOMAIN}" ]; then
                        NGX_FENCE_MSG="Basename domain does not match JSON domain. Dest did not ask yes or no. Next: rename or fix domain."
                        return 1
                    fi
                    if [ -n "${NGX_PARSE_USER}" ] && [ "${_user}" != "${NGX_PARSE_USER}" ]; then
                        NGX_FENCE_MSG="Basename user does not match JSON username. Dest did not ask yes or no. Next: rename or fix username."
                        return 1
                    fi
                fi
                ;;
        esac
    fi
    return 0
}

ngx_validate_request_json() {
    ngx_dest_json_fence "$@"
}

ngx_stamp_submit_identity() {
    _sf="${1:-}"
    : "${APP_NAME:=nginx-cli}"
    : "${VERSION:=1.0.0}"
    [ -f "${_sf}" ] || return 1
    _raw=$(cat "${_sf}")
    _raw=$(printf '%s' "${_raw}" | tr '\n' '\n')
    _raw=$(printf '%s' "${_raw}" | sed 's/"submit_app"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,\{0,1\}//g')
    _raw=$(printf '%s' "${_raw}" | sed 's/"submit_version"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,\{0,1\}//g')
    _raw=$(printf '%s' "${_raw}" | sed "s/{/{ \"submit_app\": \"${APP_NAME}\", \"submit_version\": \"${VERSION}\", /")
    printf '%s\n' "${_raw}" > "${_sf}"
}

ngx_test_purpose_cmd() {
    _run=$(util_resolve_running_path)
    if [ -n "${_run}" ] && [ -f "${_run}" ]; then
        printf '%s' "${_run}"
        return 0
    fi
    printf '%s' "${APP_NAME}"
}

ngx_tester_read_path() {
    _pos="${1:-}"
    _path="${CONVERT_FILE:-${_pos}}"
    _tmp=""
    if [ -z "${_path}" ]; then
        if [ -t 0 ]; then
            return 2
        fi
        _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.XXXXXX") || return 2
        cat > "${_tmp}" || { rm -f "${_tmp}"; return 2; }
        _path="${_tmp}"
    fi
    NGX_TESTER_PATH="${_path}"
    NGX_TESTER_TMP="${_tmp}"
    return 0
}

ngx_test_json_format() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    _cmd=$(ngx_test_purpose_cmd)
    if [ -n "${FENCE_TEST_DIR:-}" ]; then
        out_die "test-json-format takes stdin xor --file PATH (not --dir). Next: ${_cmd} test-json-format --file PATH"
    fi
    if ! ngx_tester_read_path "${1:-}"; then
        out_die "test-json-format needs --file PATH or stdin. Next: ${_cmd} test-json-format --file PATH"
    fi
    _path="${NGX_TESTER_PATH}"
    _tmp="${NGX_TESTER_TMP}"
    _skip=""
    _bn=$(basename -- "${_path}")
    case "${_bn}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
        *) _skip="skip-basename" ;;
    esac
    if ngx_dest_json_fence "${_path}" "" "" "${_skip}"; then
        [ -n "${_tmp}" ] && rm -f "${_tmp}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "test-json-format" "ok" "path" "${_path}"
        else
            out_success "JSON format is dest-legal."
        fi
        return 0
    fi
    [ -n "${_tmp}" ] && rm -f "${_tmp}"
    out_die "${NGX_FENCE_MSG}"
}

ngx_fence_test() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    : "${FENCE_EXPECT_MATCH:=0}"
    _cmd=$(ngx_test_purpose_cmd)
    _dir="${FENCE_TEST_DIR:-}"
    _file="${CONVERT_FILE:-${1:-}}"
    if [ -n "${_dir}" ] && [ -n "${_file}" ]; then
        out_die "fence-test takes --file PATH or --dir DIR or stdin, not both --file and --dir. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ -n "${_dir}" ]; then
        ngx_fence_test_dir
        return $?
    fi
    if [ "${FENCE_EXPECT_MATCH}" = "1" ]; then
        out_die "--expect-match is only valid with --dir DIR. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/match --expect-match"
    fi
    if ! ngx_tester_read_path "${1:-}"; then
        out_die "fence-test needs --file PATH, --dir DIR, or stdin. Next: ${_cmd} fence-test --file PATH"
    fi
    _path="${NGX_TESTER_PATH}"
    _tmp="${NGX_TESTER_TMP}"
    _skip=""
    _bn=$(basename -- "${_path}")
    case "${_bn}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
        *) _skip="skip-basename" ;;
    esac
    if ngx_dest_json_fence "${_path}" "" "" "${_skip}"; then
        [ -n "${_tmp}" ] && rm -f "${_tmp}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "No dest fence matched." "command" "fence-test" "path" "${_path}"
        else
            out_success "No dest fence matched."
        fi
        return 0
    fi
    [ -n "${_tmp}" ] && rm -f "${_tmp}"
    out_die "${NGX_FENCE_MSG}"
}

ngx_fence_test_dir() {
    _dir="${FENCE_TEST_DIR}"
    _cmd=$(ngx_test_purpose_cmd)
    if [ -z "${_dir}" ]; then
        out_die "fence-test --dir requires DIR. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    if [ ! -d "${_dir}" ]; then
        out_die "fence-test --dir is not a directory: ${_dir}. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    if [ -L "${_dir}" ]; then
        out_die "fence-test refuses a symlink --dir: ${_dir}. Next: ${_cmd} fence-test --dir tests/fixtures/fence-test/pass"
    fi
    _expect="${FENCE_EXPECT_MATCH:-0}"
    _n=0
    _matched=0
    _passed=0
    for _fp in "${_dir}"/*.json; do
        [ -f "${_fp}" ] || continue
        [ -L "${_fp}" ] && continue
        _bn=$(basename -- "${_fp}")
        _n=$((_n + 1))
        _skip=""
        case "${_bn}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
            *) _skip="skip-basename" ;;
        esac
        if ngx_dest_json_fence "${_fp}" "" "" "${_skip}"; then
            _passed=$((_passed + 1))
            out_info "pass ${_bn}"
        else
            _matched=$((_matched + 1))
            out_info "fence-matched ${_bn}"
        fi
    done
    if [ "${_n}" -eq 0 ]; then
        out_die "fence-test --dir has no regular .json files: ${_dir}. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ "${_expect}" = "1" ]; then
        if [ "${_passed}" -ne 0 ] || [ "${_matched}" -ne "${_n}" ]; then
            out_die "fence-test --expect-match: ${_passed} of ${_n} files had no dest fence (want every file to match). Next: ${_cmd} fence-test --dir ${_dir} --expect-match"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "success" "fence-test: ${_n} files, all matched a dest fence." \
                "command" "fence-test" "files" "${_n}" "matched" "${_matched}" "passed" "${_passed}" "expect_match" "1"
        else
            out_success "fence-test: ${_n} files, all matched a dest fence."
        fi
        return 0
    fi
    if [ "${_matched}" -ne 0 ]; then
        out_die "fence-test: ${_matched} of ${_n} files matched a dest fence. Next: ${_cmd} fence-test --file PATH"
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "fence-test: ${_n} files, no dest fence matched." \
            "command" "fence-test" "files" "${_n}" "matched" "0" "passed" "${_passed}"
    else
        out_success "fence-test: ${_n} files, no dest fence matched."
    fi
}

ngx_unpublish_conf() {
    ngx_defaults
    _domain="${1:-}"
    _avail="${NGINX_CONF_ROOT}/sites-available/${_domain}.conf"
    _enab="${NGINX_CONF_ROOT}/sites-enabled/${_domain}.conf"
    rm -f "${_enab}"
    if [ -f "${_avail}" ]; then
        util_backup "${_avail}" "pre-approve-remove"
        rm -f "${_avail}"
    fi
}

ngx_snapshot_inbound() {
    _src="${1:-}"
    _snap="${2:-}"
    if [ -z "${_src}" ] || [ -z "${_snap}" ]; then
        return 1
    fi
    if [ -L "${_src}" ]; then
        return 1
    fi
    if [ ! -f "${_src}" ]; then
        return 1
    fi
    if ! cp "${_src}" "${_snap}"; then
        return 1
    fi
    return 0
}

ngx_archive_snapshot_unlink() {
    _snap="${1:-}"
    _src="${2:-}"
    _arch="${3:-}"
    _base="${4:-}"
    if [ ! -d "${_arch}" ]; then
        out_die "Archive missing (${_arch}). Run: sudo ${APP_NAME} setup"
    fi
    if ! cp "${_snap}" "${_arch}/${_base}"; then
        out_die "Failed to archive ${_base} to ${_arch}"
    fi
    ngx_chown_adm "${_arch}/${_base}"
    chmod 0640 "${_arch}/${_base}" 2>/dev/null || true
    rm -f "${_src}"
}

ngx_approve_one() {
    ngx_defaults
    ngx_require_approve
    ngx_require_fixture_queue_safe
    _base="${1:-}"
    if [ -z "${_base}" ]; then
        out_die "Usage: ${APP_NAME} approve <basename>"
    fi
    _inbound=$(ngx_find_pending "${_base}")
    if [ -z "${_inbound}" ]; then
        out_die "Pending request not found: ${_base}"
    fi
    _base=$(basename -- "${_inbound}")
    if ! ngx_parse_basename "${_base}"; then
        out_die "Invalid request basename: ${_base}"
    fi
    _snap=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-snap.XXXXXX")
    if ! ngx_snapshot_inbound "${_inbound}" "${_snap}"; then
        rm -f "${_snap}"
        out_die "Cannot snapshot inbound ${_base} (need regular file, not a symlink)"
    fi
    if ! ngx_validate_request_json "${_snap}" "${NGX_PARSE_DOMAIN}" "${NGX_PARSE_USER}"; then
        _msg="${NGX_FENCE_MSG:-Request JSON invalid. Dest inbound is JSON.}"
        rm -f "${_snap}"
        out_die "${_msg}"
    fi
    _arch=$(ngx_queue_dir approved)
    if [ ! -d "${_arch}" ]; then
        rm -f "${_snap}"
        out_die "Archive missing (${_arch}). Run: sudo ${APP_NAME} setup"
    fi
    _act=$(ngx_json_get_str "$(cat "${_snap}")" "action")
    if [ "${_act}" = "remove" ]; then
        ngx_unpublish_conf "${NGX_PARSE_DOMAIN}"
    else
        _rend=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-rend.XXXXXX")
        _saved_out="${CONVERT_OUT-}"
        _saved_file="${CONVERT_FILE-}"
        _saved_quiet="${QUIET:-0}"
        _saved_json="${JSON:-0}"
        CONVERT_FILE="${_snap}"
        CONVERT_OUT="${_rend}"
        export CONVERT_FILE CONVERT_OUT
        QUIET=1
        JSON=0
        if ! ngx_json_to_conf; then
            CONVERT_OUT="${_saved_out}"
            CONVERT_FILE="${_saved_file}"
            QUIET="${_saved_quiet}"
            JSON="${_saved_json}"
            rm -f "${_snap}" "${_rend}"
            out_die "Cannot render text dual for ${_base}"
        fi
        CONVERT_OUT="${_saved_out}"
        CONVERT_FILE="${_saved_file}"
        QUIET="${_saved_quiet}"
        JSON="${_saved_json}"
        ngx_publish_conf "${_rend}" "${NGX_PARSE_DOMAIN}"
        rm -f "${_rend}"
    fi
    ngx_archive_snapshot_unlink "${_snap}" "${_inbound}" "${_arch}" "${_base}"
    rm -f "${_snap}"
    out_success "Approved ${_base} → sites-available/${NGX_PARSE_DOMAIN}.conf"
    if [ "${JSON}" -eq 1 ]; then
        out_json "approve" "approved" "basename" "${_base}" "domain" "${NGX_PARSE_DOMAIN}"
    fi
}

ngx_reject_one() {
    ngx_defaults
    ngx_require_approve
    ngx_require_fixture_queue_safe
    _base="${1:-}"
    if [ -z "${_base}" ]; then
        out_die "Usage: ${APP_NAME} reject <basename>"
    fi
    _inbound=$(ngx_find_pending "${_base}")
    if [ -z "${_inbound}" ]; then
        out_die "Pending request not found: ${_base}"
    fi
    _base=$(basename -- "${_inbound}")
    _snap=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-snap.XXXXXX")
    if ! ngx_snapshot_inbound "${_inbound}" "${_snap}"; then
        rm -f "${_snap}"
        out_die "Cannot snapshot inbound ${_base} (need regular file, not a symlink)"
    fi
    ngx_archive_snapshot_unlink "${_snap}" "${_inbound}" "$(ngx_queue_dir rejected)" "${_base}"
    rm -f "${_snap}"
    out_success "Rejected ${_base}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "reject" "rejected" "basename" "${_base}"
    fi
}

prompt_approve_choice() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        printf '%s' "quit"
        return 1
    fi
    if [ "${TTY}" -ne 1 ]; then
        printf '%s' "quit"
        return 1
    fi
    out_msg_n "Approve / reject / skip / quit [a/r/s/q]? "
    _ans=""
    read -r _ans || true
    case "${_ans}" in
        [Aa]|[Yy]|[Aa][Pp][Pp][Rr][Oo][Vv][Ee])
            printf '%s' "approve"
            ;;
        [Rr]|[Nn]|[Rr][Ee][Jj][Ee][Cc][Tt])
            printf '%s' "reject"
            ;;
        [Ss]|[Ss][Kk][Ii][Pp])
            printf '%s' "skip"
            ;;
        *)
            printf '%s' "quit"
            ;;
    esac
}

ngx_approve_interactive() {
    ngx_defaults
    ngx_require_approve
    _target="${1:-}"
    if [ -n "${_target}" ]; then
        ngx_approve_one "${_target}"
        return 0
    fi
    : "${TTY:=0}"
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "Interactive approve needs a TTY. Pass a basename or run without --json/--quiet."
    fi
    _inbox=$(ngx_queue_dir pending)
    if [ ! -d "${_inbox}" ]; then
        out_info "No pending queue (run setup)"
        return 0
    fi
    _any=0
    for _f in "${_inbox}"/*; do
        [ -f "${_f}" ] || continue
        _any=1
        _base=$(basename -- "${_f}")
        out_empty_line
        out_info "Pending: ${_base}"
        _skip=""
        case "${_base}" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.json) ;;
            *) _skip="skip-basename" ;;
        esac
        if ! ngx_dest_json_fence "${_f}" "" "" "${_skip}"; then
            out_info "${NGX_FENCE_MSG}"
            ngx_reject_one "${_base}"
            continue
        fi
        ngx_show_request_header "${_f}"
        _choice=$(prompt_approve_choice)
        case "${_choice}" in
            approve)
                ngx_approve_one "${_base}"
                ;;
            reject)
                ngx_reject_one "${_base}"
                ;;
            skip)
                out_info "Skipped ${_base}"
                ;;
            *)
                out_info "Stopped"
                return 0
                ;;
        esac
    done
    if [ "${_any}" -eq 0 ]; then
        out_info "No pending requests"
    fi
}

ngx_enable_login_approval() {
    ngx_defaults
    ngx_require_approve
    _home=$(ngx_resolve_adm_home)
    _rc="${_home}/.bashrc"
    _begin="# >>> ${APP_NAME} interactive approval (managed) >>>"
    _end="# <<< ${APP_NAME} interactive approval (managed) <<<"
    if [ ! -d "${_home}" ]; then
        out_die "LPU home missing: ${_home} (run setup)"
    fi
    if [ ! -f "${_rc}" ]; then
        : > "${_rc}"
        ngx_chown_adm "${_rc}"
    fi
    if grep -qF "${_begin}" "${_rc}" 2>/dev/null; then
        out_success "Login approval hook already present in ${_rc}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "enable-login-approval" "already present" "path" "${_rc}"
        fi
        return 0
    fi
    {
        printf '\n%s\n' "${_begin}"
        printf 'if [ -n "${PS1-}" ]; then\n'
        printf '    sudo %s/%s approve\n' "${GLOBAL_BIN:-/usr/local/bin}" "${APP_NAME}"
        printf 'fi\n'
        printf '%s\n' "${_end}"
    } >> "${_rc}"
    ngx_chown_adm "${_rc}"
    out_success "Added login approval hook to ${_rc}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "enable-login-approval" "added" "path" "${_rc}"
    fi
}

ngx_write_adm_sudoers() {
    ngx_defaults
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _cli="${GLOBAL_BIN}/${APP_NAME}"
    _dest="${NGINX_ADM_SUDOERS}"
    _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-sudoers.XXXXXX")
    {
        printf '%s\n' "# ${NGINX_ADM_USER} restricted sudoers — password sudo of ${APP_NAME} + NOPASSWD nginx unit tools"
        printf '%s\n' "# Generated by ${APP_NAME} setup"
        printf '%s\n' "# There is no nginx-ctl command. NOPASSWD only on nginx / systemctl / journalctl."
        printf '%s ALL=(root) %s approve\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s approve *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s reject *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s request\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s request *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s list-requests\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s list-approved\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s list-rejected\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s map-set *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s map-unset *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s map-list\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s map-list *\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(root) %s enable-login-approval\n' "${NGINX_ADM_USER}" "${_cli}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl start %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl stop %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl reload %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/systemctl restart %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /bin/journalctl -u %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl start %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u %s\n' "${NGINX_ADM_USER}" "${NGINX_WEB_UNIT}"
        printf '%s ALL=(ALL) NOPASSWD: %s\n' "${NGINX_ADM_USER}" "${NGINX_BIN}"
        printf '\n'
    } > "${_tmp}"
    if command -v visudo >/dev/null 2>&1; then
        if ! visudo -c -f "${_tmp}" >/dev/null 2>&1; then
            rm -f "${_tmp}"
            out_die "visudo rejected generated ${_dest}"
        fi
    fi
    if [ -f "${_dest}" ]; then
        util_backup "${_dest}" "pre-setup-sudoers"
    fi
    if ! cp "${_tmp}" "${_dest}"; then
        rm -f "${_tmp}"
        out_die "Cannot install ${_dest}"
    fi
    rm -f "${_tmp}"
    chmod 0440 "${_dest}"
    chown root:root "${_dest}" 2>/dev/null || true
}

ngx_write_submit_sudoers_template() {
    ngx_defaults
    _dest="${NGINX_CLI_SUBMIT_SUDOERS}"
    if [ -f "${_dest}" ]; then
        out_info "Submit sudoers already present: ${_dest}"
        return 0
    fi
    _gbin="${GLOBAL_BIN:-/usr/local/bin}"
    {
        printf '%s\n' "# ${APP_NAME} submitter software allowlist — NOT nginx / systemctl elev"
        printf '%s\n' "# Uncomment and list logins who may submit config requests."
        printf '%s\n' "# Those logins must also be in group ${NGINX_CLI_SUBMIT_GROUP} to write inbound."
        printf '%s\n' "# Type 0 request runs as the invoker (no sudo -u ${NGINX_ADM_USER} deposit)."
        printf '%s\n' "# User_Alias NGINX_CLI_SUBMITTERS = alice, bob"
        printf '%s\n' "# NGINX_CLI_SUBMITTERS ALL=(${NGINX_ADM_USER}) NOPASSWD: ${_gbin}/${APP_NAME} request"
        printf '\n'
    } > "${_dest}"
    chmod 0440 "${_dest}"
    chown root:root "${_dest}" 2>/dev/null || true
}

ngx_create_adm_user() {
    ngx_defaults
    if command -v getent >/dev/null 2>&1 && getent passwd "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_info "Account ${NGINX_ADM_USER} already exists"
        return 0
    fi
    if id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_info "Account ${NGINX_ADM_USER} already exists"
        return 0
    fi
    _etc_home="/etc/${NGINX_ADM_USER}"
    _home_sel="preferred-/etc"
    if [ -n "${NGINX_ADM_HOME:-}" ]; then
        _home="${NGINX_ADM_HOME}"
        _home_sel="override"
    elif [ -e "${_etc_home}" ]; then
        _owner=$(stat -c '%U' "${_etc_home}" 2>/dev/null || echo "")
        if [ "${_owner}" != "" ] && [ "${_owner}" != "${NGINX_ADM_USER}" ] && [ "${_owner}" != "root" ]; then
            _home="/home/${NGINX_ADM_USER}"
            _home_sel="fallback-/home"
        else
            _home="${_etc_home}"
        fi
    else
        _home="${_etc_home}"
    fi
    if command -v getent >/dev/null 2>&1 && getent passwd "${NGINX_ADM_UID}" >/dev/null 2>&1; then
        _exist=$(getent passwd "${NGINX_ADM_UID}" | cut -d: -f1)
        if [ "${_exist}" != "${NGINX_ADM_USER}" ]; then
            out_die "UID ${NGINX_ADM_UID} already used by ${_exist}"
        fi
    fi
    if ! getent group "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        if command -v groupadd >/dev/null 2>&1; then
            if ! groupadd -g "${NGINX_ADM_GID}" "${NGINX_ADM_USER}"; then
                out_die "groupadd failed for ${NGINX_ADM_USER}"
            fi
        fi
    fi
    if ! command -v useradd >/dev/null 2>&1; then
        out_die "useradd not found"
    fi
    if ! useradd -u "${NGINX_ADM_UID}" -g "${NGINX_ADM_GID}" -d "${_home}" -s "${NGINX_ADM_SHELL}" -c "${NGINX_ADM_GECOS}" -m "${NGINX_ADM_USER}"; then
        out_die "useradd failed for ${NGINX_ADM_USER}"
    fi
    out_success "Created ${NGINX_ADM_USER} uid=${NGINX_ADM_UID} home=${_home} (${_home_sel})"
}

# ngx_adm_passwd_status() - usable | locked | none | fixture | unknown (never the hash)
ngx_adm_passwd_status() {
    ngx_defaults
    if ngx_fixture_mode; then
        printf '%s' "fixture"
        return 0
    fi
    if ! command -v passwd >/dev/null 2>&1; then
        printf '%s' "unknown"
        return 0
    fi
    _st=$(passwd -S "${NGINX_ADM_USER}" 2>/dev/null) || {
        printf '%s' "unknown"
        return 0
    }
    _f2=$(printf '%s\n' "${_st}" | awk '{print $2}')
    case "${_f2}" in
        P|PS)
            printf '%s' "usable"
            ;;
        L|LK)
            printf '%s' "locked"
            ;;
        NP)
            printf '%s' "none"
            ;;
        *)
            printf '%s' "unknown"
            ;;
    esac
}

# ngx_print_adm_sudo_next_step() - Family 1 needs the LPU password; no sudo also works as that login
ngx_print_adm_sudo_next_step() {
    ngx_defaults
    out_info "sudo ${APP_NAME} as ${NGINX_ADM_USER} uses that account's password (Family 1 is not NOPASSWD)."
    out_info "Set or reset: passwd ${NGINX_ADM_USER}"
    out_info "Already logged in as ${NGINX_ADM_USER}: day-to-day verbs also work without sudo (${APP_NAME} approve)."
}

# ngx_ensure_adm_password() - OPEN-PASSWD-CLI: TTY passwd(1) or warn; never record the secret
ngx_ensure_adm_password() {
    ngx_defaults
    : "${TTY:=0}"
    : "${JSON:=0}"
    if ngx_fixture_mode; then
        return 0
    fi
    if ! id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        out_warn "Account ${NGINX_ADM_USER} missing; cannot set a password"
        return 0
    fi
    _st=$(ngx_adm_passwd_status)
    if [ "${_st}" = "usable" ]; then
        out_info "${NGINX_ADM_USER} already has a password; sudo ${APP_NAME} can authenticate"
        ngx_print_adm_sudo_next_step
        return 0
    fi
    out_info "Family 1 sudo ${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME} needs a ${NGINX_ADM_USER} password (not NOPASSWD)."
    if [ "${JSON}" -eq 0 ] && [ "${TTY}" = "1" ] && [ -t 0 ] && [ -t 1 ] && command -v passwd >/dev/null 2>&1; then
        out_info "Set a password for ${NGINX_ADM_USER} now (typed into passwd; this CLI does not record it)."
        if passwd "${NGINX_ADM_USER}"; then
            out_success "Password set for ${NGINX_ADM_USER}"
            ngx_print_adm_sudo_next_step
            return 0
        fi
        out_warn "passwd ${NGINX_ADM_USER} did not complete. sudo ${APP_NAME} will fail until: passwd ${NGINX_ADM_USER}"
        ngx_print_adm_sudo_next_step
        return 0
    fi
    out_warn "Set a password before sudo ${APP_NAME} as ${NGINX_ADM_USER}: passwd ${NGINX_ADM_USER}"
    ngx_print_adm_sudo_next_step
}

ngx_setup_ownership() {
    ngx_defaults
    if [ ! -d "${NGINX_CONF_ROOT}" ]; then
        if ! mkdir -p "${NGINX_CONF_ROOT}/sites-available" "${NGINX_CONF_ROOT}/sites-enabled"; then
            out_die "Cannot create ${NGINX_CONF_ROOT}"
        fi
    fi
    mkdir -p "${NGINX_CONF_ROOT}/sites-available" "${NGINX_CONF_ROOT}/sites-enabled"
    chown -R "${NGINX_ADM_USER}:root" "${NGINX_CONF_ROOT}"
    chmod 0775 "${NGINX_CONF_ROOT}"
}

ngx_setup_symlinks() {
    ngx_defaults
    _home=$(ngx_resolve_adm_home)
    ln -sfn "${NGINX_CONF_ROOT}/sites-available" "${_home}/sites-available"
    ln -sfn "${NGINX_CONF_ROOT}/sites-enabled" "${_home}/sites-enabled"
}

ngx_backup_remove_sudoers() {
    _f="${1:-}"
    [ -n "${_f}" ] || return 0
    if [ ! -f "${_f}" ]; then
        return 0
    fi
    _bakdir="/etc/sudoers.bak"
    mkdir -p "${_bakdir}"
    _ts=$(date +%Y%m%d)
    _n=1
    _base=$(basename -- "${_f}")
    _dest="${_bakdir}/${_base}.${_ts}-${_n}.bak"
    while [ -e "${_dest}" ]; do
        _n=$((_n + 1))
        _dest="${_bakdir}/${_base}.${_ts}-${_n}.bak"
    done
    cp "${_f}" "${_dest}"
    rm -f "${_f}"
    out_info "Backed up ${_f} → ${_dest}"
}

ngx_setup() {
    ngx_defaults
    ngx_require_root "$@"
    ngx_create_adm_user
    ngx_ensure_home_layout
    ngx_setup_public_queues
    ngx_setup_ownership
    ngx_setup_symlinks
    ngx_write_adm_sudoers
    ngx_write_submit_sudoers_template
    ngx_enable_login_approval
    ngx_ensure_adm_password
    out_success "nginx-adm least-privilege setup complete"
    if [ "${JSON}" -eq 1 ]; then
        out_json "setup" "complete" \
            "user" "${NGINX_ADM_USER}" \
            "uid" "${NGINX_ADM_UID}" \
            "home" "$(ngx_resolve_adm_home)" \
            "queue_root" "$(ngx_resolve_queue_root)" \
            "submit_group" "${NGINX_CLI_SUBMIT_GROUP}" \
            "conf_root" "${NGINX_CONF_ROOT}" \
            "passwd_status" "$(ngx_adm_passwd_status)"
    fi
}

ngx_remove_lpu() {
    ngx_defaults
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    ngx_require_root "$@"
    if [ "${FORCE}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            out_die "remove-lpu requires confirmation. Re-run with --force in non-interactive mode."
        fi
        if ! prompt_yes_no "Remove least-privilege account ${NGINX_ADM_USER} (sudoers + account; site files kept)?"; then
            out_info "remove-lpu cancelled"
            return 0
        fi
    fi
    ngx_backup_remove_sudoers "${NGINX_ADM_SUDOERS}"
    ngx_backup_remove_sudoers "${NGINX_CLI_SUBMIT_SUDOERS}"
    ngx_backup_remove_queue_root
    if [ -d "${NGINX_CONF_ROOT}" ]; then
        _own=$(stat -c '%U' "${NGINX_CONF_ROOT}" 2>/dev/null || echo "")
        if [ "${_own}" = "${NGINX_ADM_USER}" ]; then
            chown -R root:root "${NGINX_CONF_ROOT}"
            out_info "Restored ${NGINX_CONF_ROOT} owner to root:root (content kept)"
        fi
    fi
    if id "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        if ! userdel -r "${NGINX_ADM_USER}"; then
            out_die "userdel -r ${NGINX_ADM_USER} failed"
        fi
        out_success "Removed account ${NGINX_ADM_USER} (home via userdel -r)"
    else
        out_info "Account ${NGINX_ADM_USER} already absent"
    fi
    if getent group "${NGINX_ADM_USER}" >/dev/null 2>&1; then
        groupdel "${NGINX_ADM_USER}" 2>/dev/null || true
    fi
    if getent group "${NGINX_CLI_SUBMIT_GROUP}" >/dev/null 2>&1; then
        groupdel "${NGINX_CLI_SUBMIT_GROUP}" 2>/dev/null || true
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "remove-lpu" "removed" "user" "${NGINX_ADM_USER}"
    fi
}

# =============================================================================
# ngx_sudoers_trust_tier() - Classify managed-install trust for compose emit
# =============================================================================
#
# GENERAL PURPOSE:
# Prints one of: production | test_local | unmanaged
# production = readable+executable global managed binary
# test_local = only local user-bin managed binary
# unmanaged  = neither path usable
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.5.3
# =============================================================================
ngx_sudoers_trust_tier() {
    : "${APP_NAME:=nginx-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -r "${USER_BIN}/${APP_NAME}" ] && [ -x "${USER_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
    return 0
}

# =============================================================================
# ngx_detect_sudoer_cli() - Path of sibling sudoer-cli, or fail
# =============================================================================
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md
# - requirement-domain-nginx-cli.md
# =============================================================================
ngx_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"

    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_detect_sudoer_adm() - sudoer-adm login if present
# =============================================================================
ngx_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_detect_sudoer_inbound() - sibling public inbound if present
# =============================================================================
#
# GENERAL PURPOSE:
# Find the sibling public inbound (preferred /var/sudoer-cli/sudoer-request).
# Type 0 MUST NOT mkdir. Order: env override → public → F4 view → legacy.
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.5.3
# =============================================================================
ngx_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"

    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi

    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi

    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"} \
        "/etc/${SUDOER_ADM_USER}/sudoer-approving" \
        "/home/${SUDOER_ADM_USER}/sudoer-approving"
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# ngx_sudoer_queue_root_from_inbound() - parent of real public inbound
# =============================================================================
# MUST NOT treat a legacy …/sudoer-approving parent as the public queue root.
# =============================================================================
ngx_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND-}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

# =============================================================================
# ngx_sudoers_json_text() - dest-honest JSON sudoer file to stdout
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md
# =============================================================================
ngx_sudoers_json_text() {
    : "${APP_NAME:=nginx-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"
    : "${NGINX_ADM_USER:=nginx-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${VERSION:=1.0.0}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    case "${_user}" in
        *\"*|*'\\'*) out_die "refusing username with JSON-unsafe characters" ;;
    esac
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to submit ${APP_NAME} config requests as ${NGINX_ADM_USER}."
    fi
    case "${_purpose}" in
        *\"*|*'\\'*) out_die "refusing purpose with JSON-unsafe characters" ;;
    esac

    cat <<EOF
{
  "schema_version": 1,
  "purpose": "${_purpose}",
  "username": "${_user}",
  "service": "${APP_NAME}",
  "action": "${_action}",
  "commands": [
    {
      "runas": "${NGINX_ADM_USER}",
      "tags": ["NOPASSWD"],
      "path": "${_global_path}",
      "args": ["request"]
    }
  ],
  "submit_app": "${APP_NAME}",
  "submit_version": "${VERSION}"
}
EOF
}

# =============================================================================
# ngx_sudoers_refuse_forbidden_grant() - Fail closed on OS-tool / F6 grants
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.7
# =============================================================================
ngx_sudoers_refuse_forbidden_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=nginx-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer grant file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    _need="${GLOBAL_BIN}/${APP_NAME}"
    _path=$(printf '%s' "${_gb}" | tr '\n' ' ' | sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    if [ "${_path}" != "${_need}" ]; then
        out_die "refusing sudoer grant: path must be ${_need} request only"
    fi
    _npath=$(printf '%s\n' "${_gb}" | tr '"' '\n' | grep -c '^path$' || true)
    if [ "${_npath}" -ne 1 ]; then
        out_die "refusing sudoer grant: exactly one path (${_need}) allowed"
    fi
    _flat=$(printf '%s' "${_gb}" | tr '\n' ' ')
    case "${_flat}" in
        *"\"args\""*\"request\"*)
            ;;
        *)
            out_die "refusing sudoer grant: args must be [\"request\"]"
            ;;
    esac
    case "${_flat}" in
        *"\"args\""*\"request\""*\",\"*|*"\"args\""*\"request\""*,*)
            out_die "refusing sudoer grant: args must be [\"request\"] only"
            ;;
    esac
    case "${_gb}" in
        *"/usr/bin/mkdir"*|*"/bin/mkdir"*|*"/usr/bin/cp"*|*"/bin/cp"*|*"/usr/bin/tar"*|*"/bin/tar"*|*"/bin/rm "*|*"/usr/bin/rm "*|*"/usr/bin/install"*|*"/usr/bin/chmod"*|*"/bin/chmod"*|*"/usr/sbin/nginx"*|*"/bin/systemctl"*|*"/usr/bin/systemctl"*|*"/bin/journalctl"*|*"/usr/bin/journalctl"*|*"/bin/sh"*|*"/bin/bash"*)
            out_die "refusing sudoer grant with OS-tool commands (need ${GLOBAL_BIN}/${APP_NAME} request only)"
            ;;
    esac
    case "${_gb}" in
        *'"approve"'*|*'"reject"'*|*'"setup"'*|*'"remove-lpu"'*|*'"install"'*|*'"uninstall"'*|*'"map-set"'*|*'"map-unset"'*|*'"enable-login-approval"'*)
            out_die "refusing sudoer grant with dest-forbidden verbs (need ${GLOBAL_BIN}/${APP_NAME} request only)"
            ;;
    esac
    return 0
}

# =============================================================================
# ngx_sudoers_require_emit_trust() - Fail-closed unless production or test-allow
# =============================================================================
ngx_sudoers_require_emit_trust() {
    : "${APP_NAME:=nginx-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    _tier=$(ngx_sudoers_trust_tier)
    if [ "${_tier}" != "production" ]; then
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "submit-sudoer-request trust tier is ${_tier} (not production). Prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN}/${APP_NAME}). To submit a test fragment: ${APP_NAME} submit-sudoer-request --allow-test-local  or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
    fi
}

# =============================================================================
# ngx_submit_sudoer_request() - Type 0: queue this product's sudoers for approval
# =============================================================================
#
# GENERAL PURPOSE:
# Detect sudoer-cli and sudoer-adm, emit (or accept) a self-scoped JSON
# sudoer grant, and submit it via sudoer-cli so a JSON request lands in
# the public inbound (/var/sudoer-cli/sudoer-request). Does not write /etc
# and does not mkdir inbound. Approver (sudoer-adm) still must approve.
#
# ALIGNMENT:
# - requirement-domain-nginx-cli.md
# - requirement-three-layer-privilege-model.md
# - requirement-sudoer-json-file.md
# - requirement-shell-cli-interface.md
#
# Last reviewed: 2026-08-15
# =============================================================================
ngx_submit_sudoer_request() {
    : "${APP_NAME:=nginx-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${EFFECTIVE_STORAGE_DIR:=}"
    : "${NGINX_ADM_USER:=nginx-adm}"

    _src_file="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to submit ${APP_NAME} config requests as ${NGINX_ADM_USER}."
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "submit-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        ngx_sudoers_refuse_forbidden_grant "${_src_file}"
    fi

    _cli=""
    if _cli=$(ngx_detect_sudoer_cli); then
        :
    else
        out_die "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli to ${GLOBAL_BIN:-/usr/local/bin}/sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc."
    fi

    _adm=""
    if _adm=$(ngx_detect_sudoer_adm); then
        :
    else
        out_die "sudoer-adm not found (id ${SUDOER_ADM_USER} failed). Ask an admin to run: sudo sudoer-cli setup"
    fi

    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP:-sudoer-cli}}"
    _inbound=""
    if _inbound=$(ngx_detect_sudoer_inbound); then
        :
    else
        out_die "sudoer inbound queue not found (preferred ${SUDOER_PUBLIC_ROOT}/sudoer-request). Ask an admin to run: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die "sudoer inbound not writable: ${_inbound}. Sibling inbound must be writable (owner ${_adm})."
    fi

    _tmp=""
    if [ -n "${_src_file}" ]; then
        _tmp="${_src_file}"
        _cleanup_tmp=0
    else
        ngx_sudoers_require_emit_trust
        if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        _tmp=$(mktemp "${EFFECTIVE_STORAGE_DIR}/ngx-sudoer.XXXXXX" 2>/dev/null || mktemp)
        ngx_sudoers_json_text >"${_tmp}" || out_die "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    ngx_sudoers_refuse_forbidden_grant "${_tmp}"

    if _qr=$(ngx_sudoer_queue_root_from_inbound "${_inbound}"); then
        SUDOER_CLI_QUEUE_ROOT="${_qr}"
        export SUDOER_CLI_QUEUE_ROOT
        if [ -n "${SUDOER_QUEUE_INBOUND-}" ] && [ "${_inbound}" = "${SUDOER_QUEUE_INBOUND}" ]; then
            LPU_HOME="${_qr}"
            export LPU_HOME
        fi
    fi

    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi

    _errf=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-sudoer-err.XXXXXX" 2>/dev/null || mktemp)
    _out=""
    _rc=0
    if [ "${JSON}" -eq 1 ]; then
        _out=$("${_cli}" --json "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        _out=$("${_cli}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    rm -f "${_errf}"
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi

    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi

    _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
    if [ -z "${_rid}" ]; then
        _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*request_id=\([^[:space:]]*\).*/\1/p')
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "submit-sudoer-request" "submitted" \
            "request_id" "${_rid}" \
            "action" "${SUBMIT_ACTION}" \
            "service" "${APP_NAME}" \
            "user" "${_user}" \
            "sudoer_cli" "${_cli}" \
            "sudoer_adm" "${_adm}" \
            "inbound" "${_inbound}"
        return 0
    fi

    out_success "Submitted ${SUBMIT_ACTION} request via ${_cli}"
    if [ -n "${_rid}" ]; then
        out_info "request_id=${_rid}"
    fi
    out_info "inbound=${_inbound}  (approver: ${_adm})"
    out_info "This CLI did not write /etc. Approver must approve the request."
    return 0
}

# =============================================================================
# ngx_convert_read_input() - stdin xor --file / operand (Type 0 convert)
# =============================================================================
#
# ALIGNMENT: requirement-domain-nginx-cli.md §2.2.9
# =============================================================================
ngx_convert_read_input() {
    : "${CONVERT_FILE:=}"
    _cf="${CONVERT_FILE}"
    if [ -z "${_cf}" ] && [ -n "${1:-}" ]; then
        _cf="$1"
    fi
    if [ -n "${_cf}" ]; then
        if [ ! -f "${_cf}" ] || [ -L "${_cf}" ]; then
            out_die "convert input must be a regular file (not a symlink): ${_cf}"
        fi
        cat "${_cf}"
        return 0
    fi
    if [ -t 0 ]; then
        out_die "provide --file PATH or stdin (xor). See '${APP_NAME} help'."
    fi
    cat
}

# =============================================================================
# ngx_convert_refuse_dest_path() - Convert must not write /etc or sites trees
# =============================================================================
ngx_convert_refuse_dest_path() {
    _p="${1:-}"
    [ -n "${_p}" ] || return 0
    ngx_defaults
    case "${_p}" in
        /etc|/etc/*|/var/nginx-cli|/var/nginx-cli/*|/var/sudoer-cli|/var/sudoer-cli/*)
            out_die "convert --out refuses dest/host path: ${_p}"
            ;;
    esac
    case "${_p}" in
        "${NGINX_CONF_ROOT}"|"${NGINX_CONF_ROOT}"/*)
            out_die "convert --out refuses ${NGINX_CONF_ROOT}: ${_p}"
            ;;
    esac
    _q=$(ngx_resolve_queue_root)
    if [ -n "${_q}" ]; then
        case "${_p}" in
            "${_q}"|"${_q}"/*)
                out_die "convert --out refuses queue path: ${_p}"
                ;;
        esac
    fi
}

ngx_nginx_field_ok() {
    _label="${1:-}"
    _val="${2:-}"
    [ -n "${_val}" ] || return 0
    _flat=$(printf '%s' "${_val}" | tr '\n\r' '  ')
    if [ "${_flat}" != "${_val}" ]; then
        return 1
    fi
    case "${_val}" in
        *';'*|*'{'*|*"\`"*|*'$('*)
            return 1
            ;;
    esac
    case "${_val}" in
        *include*|*lua_*|*load_module*)
            return 1
            ;;
    esac
    if [ "${_label}" = "proxy_pass" ]; then
        case "${_val}" in
            http://*|https://*|unix:*)
                ;;
            *)
                return 1
                ;;
        esac
    fi
    return 0
}

# =============================================================================
# ngx_convert_write() - stdout or --out (never queue)
# =============================================================================
ngx_convert_write() {
    _payload="$1"
    : "${CONVERT_OUT:=}"
    : "${JSON:=0}"
    : "${COMMAND:=}"
    if [ -n "${CONVERT_OUT}" ]; then
        ngx_convert_refuse_dest_path "${CONVERT_OUT}"
        case "${CONVERT_OUT}" in
            /*) ;;
            *) out_die "convert --out path must be absolute: ${CONVERT_OUT}" ;;
        esac
        if [ -L "${CONVERT_OUT}" ]; then
            out_die "refusing symlink --out: ${CONVERT_OUT}"
        fi
        printf '%s\n' "${_payload}" >"${CONVERT_OUT}" || out_die "cannot write ${CONVERT_OUT}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "${COMMAND}" "wrote" "out" "${CONVERT_OUT}"
        else
            out_success "Wrote ${CONVERT_OUT}"
        fi
        return 0
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "${COMMAND}" "converted" "@body" "${_payload}"
        return 0
    fi
    out_plain "${_payload}"
}

ngx_json_get_str() {
    _jg_json=$(printf '%s' "$1" | tr '\n' ' ')
    _jg_key="$2"
    printf '%s' "${_jg_json}" | sed -n "s/.*\"${_jg_key}\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n1
}

# =============================================================================
# ngx_conf_to_json() - Type 0: nginx-conf text → dest request JSON
# =============================================================================
#
# GENERAL PURPOSE:
# Convert a dest nginx-conf text dual (# header + server block) into the
# closed dest request JSON. Never queues. Never writes /etc or sites trees.
#
# ALIGNMENT: requirement-domain-nginx-cli.md §2.2.9
# =============================================================================
ngx_conf_to_json() {
    : "${APP_NAME:=nginx-cli}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_PURPOSE:=}"
    ngx_defaults

    _raw=$(ngx_convert_read_input "${1:-}")
    case "${_raw}" in
        *"include "*|*"lua_"*|*"load_module"*)
            out_die "refusing nginx-conf with include/lua/load_module (closed dual only)"
            ;;
    esac

    _act="${SUBMIT_ACTION}"
    case "${_act}" in
        add|update) ;;
        *) out_die "conf-to-json --action must be add or update" ;;
    esac

    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose=$(printf '%s\n' "${_raw}" | sed -n 's/^# Purpose:[[:space:]]*//p; s/^# Intention:[[:space:]]*//p' | head -n1)
    fi
    [ -n "${_purpose}" ] || out_die "purpose required (--purpose or # Intention: / # Purpose:)"
    case "${_purpose}" in
        *\"*|*'\\'*) out_die "refusing purpose with JSON-unsafe characters" ;;
    esac

    _user=$(id -un 2>/dev/null || echo "unknown")
    case "${_user}" in
        *\"*|*'\\'*) out_die "refusing username with JSON-unsafe characters" ;;
    esac

    _flat=$(printf '%s\n' "${_raw}" | tr '{};' '\n')
    _sname=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*server_name[[:space:]]*//p' | head -n1 | awk '{print $1}')
    [ -n "${_sname}" ] || out_die "server_name required"
    _listen=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*listen[[:space:]]*//p' | head -n1 | sed 's/[[:space:]]*$//')
    [ -n "${_listen}" ] || out_die "listen required"

    _kind=""
    case "${_listen}" in
        *443*) _kind="per-domain-https" ;;
        *) _kind="redirect" ;;
    esac
    if printf '%s\n' "${_raw}" | grep -q 'ssl_certificate'; then
        _kind="per-domain-https"
    fi

    _ssl_cert=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*ssl_certificate[[:space:]]*//p' | head -n1)
    _ssl_key=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*ssl_certificate_key[[:space:]]*//p' | head -n1)
    _ret=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*return[[:space:]]*//p' | head -n1)
    _ret_code=$(printf '%s\n' "${_ret}" | awk '{print $1}')
    _ret_url=$(printf '%s\n' "${_ret}" | awk '{ $1=""; sub(/^ /,""); print }')
    _loc_match=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*location[[:space:]]*//p' | head -n1 | awk '{print $1}' | tr -d '{')
    _proxy=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*proxy_pass[[:space:]]*//p' | head -n1)
    _root=$(printf '%s\n' "${_flat}" | sed -n 's/^[[:space:]]*root[[:space:]]*//p' | head -n1)

    _listen_esc=$(util_json_escape "${_listen}")
    _sname_esc=$(util_json_escape "${_sname}")
    _purpose_esc=$(util_json_escape "${_purpose}")
    _user_esc=$(util_json_escape "${_user}")
    _kind_esc=$(util_json_escape "${_kind}")

    _site="\"listen\": [\"${_listen_esc}\"], \"server_name\": [\"${_sname_esc}\"]"
    if [ -n "${_ssl_cert}" ]; then
        _site="${_site}, \"ssl_certificate\": \"$(util_json_escape "${_ssl_cert}")\""
    fi
    if [ -n "${_ssl_key}" ]; then
        _site="${_site}, \"ssl_certificate_key\": \"$(util_json_escape "${_ssl_key}")\""
    fi
    if [ -n "${_root}" ]; then
        _site="${_site}, \"root\": \"$(util_json_escape "${_root}")\""
    fi
    if [ -n "${_ret_code}" ]; then
        _site="${_site}, \"return\": { \"code\": ${_ret_code}, \"url\": \"$(util_json_escape "${_ret_url}")\" }"
    fi
    if [ -n "${_proxy}" ]; then
        _mm="${_loc_match:-/}"
        _site="${_site}, \"locations\": [ { \"role\": \"proxy\", \"match\": \"$(util_json_escape "${_mm}")\", \"proxy_pass\": \"$(util_json_escape "${_proxy}")\" } ]"
    fi

    : "${VERSION:=1.0.0}"
    _ver_esc=$(util_json_escape "${VERSION}")
    _app_esc=$(util_json_escape "${APP_NAME}")
    _payload=$(printf '%s\n' "{
  \"schema_version\": 1,
  \"purpose\": \"${_purpose_esc}\",
  \"username\": \"${_user_esc}\",
  \"service\": \"${APP_NAME}\",
  \"action\": \"${_act}\",
  \"kind\": \"${_kind_esc}\",
  \"domain\": \"${_sname_esc}\",
  \"submit_app\": \"${_app_esc}\",
  \"submit_version\": \"${_ver_esc}\",
  \"site\": { ${_site} }
}")
    ngx_convert_write "${_payload}"
}

# =============================================================================
# ngx_json_to_conf() - Type 0: dest request JSON → nginx-conf text
# =============================================================================
#
# ALIGNMENT: requirement-domain-nginx-cli.md §2.2.9
# =============================================================================
ngx_json_to_conf() {
    : "${APP_NAME:=nginx-cli}"
    ngx_defaults

    _raw=$(ngx_convert_read_input "${1:-}")
    _trim=$(printf '%s' "${_raw}" | sed 's/^[[:space:]]*//')
    case "${_trim}" in
        "{"*) ;;
        *) out_die "expected JSON object" ;;
    esac

    _purpose=$(ngx_json_get_str "${_raw}" "purpose")
    [ -n "${_purpose}" ] || out_die "purpose required"
    _act=$(ngx_json_get_str "${_raw}" "action")
    _has_site=0
    case "${_raw}" in
        *"\"site\""*) _has_site=1 ;;
    esac
    if [ "${_act}" = "remove" ] || { [ -z "${_act}" ] && [ "${_has_site}" -eq 0 ]; }; then
        if [ "${_has_site}" -eq 1 ]; then
            out_die "remove JSON must not include site"
        fi
        ngx_convert_write "$(printf '# Purpose: %s\n' "${_purpose}")"
        return 0
    fi

    _ver=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"schema_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)
    [ "${_ver}" = "1" ] || out_die "schema_version must be 1"
    _sapp=$(ngx_json_get_str "${_raw}" "submit_app")
    _sver=$(ngx_json_get_str "${_raw}" "submit_version")
    [ -n "${_sapp}" ] || out_die "submit_app required"
    [ -n "${_sver}" ] || out_die "submit_version required"
    _kind=$(ngx_json_get_str "${_raw}" "kind")
    _domain=$(ngx_json_get_str "${_raw}" "domain")
    [ -n "${_kind}" ] || out_die "kind required"
    [ -n "${_domain}" ] || out_die "domain required"
    case "${_kind}" in
        per-domain-https|redirect|shared-cloudflare) ;;
        *) out_die "unknown kind: ${_kind}" ;;
    esac

    _listen=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"listen"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    if [ -z "${_listen}" ]; then
        if [ "${_kind}" = "per-domain-https" ]; then
            _listen="443 ssl"
        else
            _listen="80"
        fi
    fi
    _sname=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"server_name"[[:space:]]*:[[:space:]]*\[[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    [ -n "${_sname}" ] || _sname="${_domain}"
    _ssl_cert=$(ngx_json_get_str "${_raw}" "ssl_certificate")
    _ssl_key=$(ngx_json_get_str "${_raw}" "ssl_certificate_key")
    _root=$(ngx_json_get_str "${_raw}" "root")
    _ret_url=$(ngx_json_get_str "${_raw}" "url")
    _ret_code=$(printf '%s' "${_raw}" | tr '\n' ' ' | sed -n 's/.*"code"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)
    _proxy=$(ngx_json_get_str "${_raw}" "proxy_pass")
    _match=$(ngx_json_get_str "${_raw}" "match")
    ngx_nginx_field_ok "listen" "${_listen}" || out_die "refusing unsafe listen"
    ngx_nginx_field_ok "server_name" "${_sname}" || out_die "refusing unsafe server_name"
    ngx_nginx_field_ok "ssl_certificate" "${_ssl_cert}" || out_die "refusing unsafe ssl_certificate"
    ngx_nginx_field_ok "ssl_certificate_key" "${_ssl_key}" || out_die "refusing unsafe ssl_certificate_key"
    ngx_nginx_field_ok "root" "${_root}" || out_die "refusing unsafe root"
    ngx_nginx_field_ok "url" "${_ret_url}" || out_die "refusing unsafe return url"
    ngx_nginx_field_ok "match" "${_match}" || out_die "refusing unsafe location match"
    ngx_nginx_field_ok "proxy_pass" "${_proxy}" || out_die "refusing unsafe proxy_pass"

    _txt=$(printf '%s\n' "# Purpose: ${_purpose}" "" "server {")
    _txt=$(printf '%s\n    listen %s;' "${_txt}" "${_listen}")
    _txt=$(printf '%s\n    server_name %s;' "${_txt}" "${_sname}")
    if [ -n "${_ssl_cert}" ]; then
        _txt=$(printf '%s\n    ssl_certificate     %s;' "${_txt}" "${_ssl_cert}")
    fi
    if [ -n "${_ssl_key}" ]; then
        _txt=$(printf '%s\n    ssl_certificate_key %s;' "${_txt}" "${_ssl_key}")
    fi
    if [ -n "${_root}" ]; then
        _txt=$(printf '%s\n    root %s;' "${_txt}" "${_root}")
    fi
    if [ -n "${_ret_code}" ]; then
        if [ -n "${_ret_url}" ]; then
            _txt=$(printf '%s\n    return %s %s;' "${_txt}" "${_ret_code}" "${_ret_url}")
        else
            _txt=$(printf '%s\n    return %s;' "${_txt}" "${_ret_code}")
        fi
    fi
    if [ -n "${_proxy}" ]; then
        _txt=$(printf '%s\n    location %s {' "${_txt}" "${_match:-/}")
        _txt=$(printf '%s\n        proxy_pass %s;' "${_txt}" "${_proxy}")
        _txt=$(printf '%s\n    }' "${_txt}")
    fi
    _txt=$(printf '%s\n}' "${_txt}")

    if command -v nginx >/dev/null 2>&1; then
        _tf=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/ngx-dual.XXXXXX")
        printf '%s\n' "${_txt}" >"${_tf}"
        if ! nginx -t -c "${_tf}" >/dev/null 2>&1; then
            out_debug "nginx -t on isolated dual skipped/failed (not a full nginx.conf)"
        fi
        rm -f "${_tf}"
    fi
    ngx_convert_write "${_txt}"
}


