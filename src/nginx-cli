app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=nginx-cli}"
    : "${VERSION:=1.0.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=nginx-cli}"
    : "${SCRIPT_URL:=}"
